{
  "platform": "mac/cmux",
  "harness": "scripts/mac_harness.py",
  "bridge": "scripts/cmux_bridge.py",
  "require_acceptance_trio": true,
  "require_identity_gate": true,
  "forbid_fallback_supervisor_identity": true,
  "require_surface_inventory": true,
  "require_same_cmux_workspace": true,
  "forbid_cross_workspace_executor": true,
  "require_side_split_panel": true,
  "require_existing_executor_reuse": true,
  "forbid_direct_agent_cli_launch_outside_harness": true,
  "forbid_replacement_session_as_recovery": true,
  "lost_surface_recovery_action": "resume_exact_persisted_session_only",
  "lost_surface_recovery_requires_history_sha256_and_bytes": true,
  "lost_surface_recovery_requires_exact_side_split_surface": true,
  "lost_surface_recovery_authorization_is_one_time_by_history_pin": true,
  "forbid_spawn_without_explicit_user_authorization": true,
  "spawn_requires_flags": [
    "--spawn",
    "--spawn-authorized"
  ],
  "claude_default_model": null,
  "claude_model_command": null,
  "forbid_model_switch_as_error_recovery": true,
  "executor_api_error_retry_seconds": 60,
  "executor_api_error_max_rounds": 3,
  "executor_api_error_terminal_action": "stop_and_notify_administrator",
  "executor_context_full_action": "compact_same_session_or_stop_and_notify_administrator",
  "executor_other_blocker_action": "stop_and_notify_administrator",
  "executor_billing_unavailable_action": "stop_sentinel_and_freeze_executor_dispatch",
  "executor_billing_unavailable_retry_allowed": false,
  "solo_takeover_requires_explicit_user_direction": true,
  "solo_takeover_state_machine": "scripts/executor_availability.py",
  "restore_collaboration_requires_phase_boundary_handoff": true,
  "restore_collaboration_requires_existing_executor_surface": true,
  "default_panel_direction": "right",
  "allowed_panel_directions": [
    "right",
    "left",
    "up",
    "down"
  ],
  "forbid_new_surface_executor": true,
  "require_visible_surface_names": true,
  "require_naming_proof": true,
  "require_authoritative_supervisor_identity": true,
  "require_bridge_test": true,
  "submission_protocol": "paste_then_lowercase_enter_then_read_screen",
  "submission_confirmed_helper": "cmux-agent ask|cmux_bridge.submit_text",
  "submission_delivery_marker_required": true,
  "submission_confirmation_requires_pre_post_snapshot": true,
  "submission_confirmation_allows_new_activity_after_marker_scroll": true,
  "submission_marker_absence_alone_is_not_proof": true,
  "submission_max_recovery_enters": 1,
  "submission_unconfirmed_action": "classify_then_stop_never_blind_resend",
  "submission_states": {
    "SUPERVISOR_DID_NOT_SUBMIT": "dispatch_submitted_at is null; nothing was pasted. Correct action: fix the supervisor-side abort, then reissue with a FRESH nonce.",
    "SUBMISSION_ABORTED_BUSY": "compose buffer held queued/active input at submit time. Correct action: wait for a safe boundary, then reissue with a FRESH nonce.",
    "COMPOSE_OCCUPIED": "alias of SUBMISSION_ABORTED_BUSY retained for readability in logs.",
    "DELIVERY_UNVERIFIED_BY_DETECTOR": "marker left compose and post-submit activity exists but its line shape is unrecognized. Delivered. Correct action: widen the activity recognizer; NEVER resend.",
    "DELIVERY_QUEUED_AT_RECEIVER": "marker is visible inside the receiver's pending-message region. Delivered, awaiting the receiver's next tool-call boundary. Correct action: WAIT; NEVER resend."
  },
  "submission_state_requires_submitted_at_field": true,
  "compose_detector_must_know_both_receiver_glyphs": true,
  "compose_prompt_glyphs": {
    "claude": "❯",
    "codex": "›"
  },
  "compose_detector_reads_current_block_only": true,
  "earlier_prompt_glyph_block_is_transcript_not_compose": true,
  "external_helper_path": "~/.local/bin/cmux-agent",
  "external_helper_is_outside_skill_scope": true,
  "external_helper_must_match_shipped_detector_contract": true,
  "external_helper_parity_gate": "mac_harness.py helper-parity",
  "external_helper_parity_runs_in_preflight_and_fails_closed": true,
  "external_helper_divergence_forbids_trusting_its_dispatch_verdict": true,
  "forbid_editing_external_helper_without_explicit_scope_expansion": true,
  "fixing_a_library_does_not_fix_the_tool_the_protocol_runs_on": true,
  "submission_state_requires_detector_side": true,
  "forbid_blind_resend_without_state_classification": true,
  "ack_states": {
    "HANDSHAKE_TIMEOUT": "effective budget met or exceeded the phase minimum and the executor still did not ACK. This may legitimately be attributed to executor silence.",
    "SUPERVISOR_BUDGET_TOO_SHORT": "effective budget was BELOW the phase minimum. Must NOT be attributed to executor silence."
  },
  "phase_minimum_budget_seconds": {
    "handshake": 600,
    "round": 180
  },
  "receipt_requires_budget_source": true,
  "receipt_requires_budget_seconds": true,
  "forbid_executor_silence_attribution_below_phase_minimum": true,
  "forbid_uppercase_enter_key": true,
  "raw_send_has_consumption_proof": false,
  "require_executor_ack": true,
  "require_executor_generated_ack_nonce": true,
  "forbid_prompt_echo_ack": true,
  "require_claude_response_block_ack": true,
  "require_handshake_strict_validation": true,
  "require_artifact_for_consensus": true,
  "receipt_lifecycle": [
    "PENDING",
    "ACKED",
    "EXPIRED",
    "REJECTED"
  ],
  "receipt_requires_task_surface_workspace_nonce_binding": true,
  "receipt_requires_task_pack_sha256": true,
  "receipt_requires_source_revision": true,
  "derived_evidence_must_not_predate_its_inputs": true,
  "stale_derived_evidence_action": "refuse_as_current_evidence_and_recompute",
  "require_bridge_test_clear_confirmed": true,
  "bridge_test_clear_bounded_retries": 1,
  "bridge_test_unconfirmed_reason": "BRIDGE_TEST_UNCONFIRMED",
  "handshake_requires_fresh_clear_confirmed_bridge_evidence": true,
  "forbid_handshake_bypass_of_bridge_clear_precondition": true,
  "forbid_whitelisting_own_bridge_token_in_busy_detector": true,
  "consensus_floor_is_external_not_read_from_audited_file": true,
  "consensus_minimum_rounds": 3,
  "record_round_requires_artifact_exists": true,
  "record_round_requires_artifact_sha256": true,
  "record_round_rejects_stale_or_duplicate_nonce": true,
  "require_symmetric_hook_wiring_both_roles": true,
  "reverify_hook_wiring_at_task_end_not_only_once": true,
  "hook_config_is_shared_mutable_state_not_owned_by_one_writer": true,
  "forbid_wholesale_rewrite_of_peer_hook_config": true,
  "guard_requires_wired_entry_point_proof": true,
  "guard_requires_semantics_preserving_mutation_that_does_not_flip": true,
  "guard_requires_semantics_changing_excision_that_flips": true,
  "forbid_helper_unit_test_as_sole_guard_proof": true,
  "terminal_state_requires_safe_boundary": true,
  "terminal_state_pending_boundary_marker": "DONE_PENDING_BOUNDARY",
  "forbid_closing_task_on_done_pending_boundary": true,
  "authorization_source_allowed_values": [
    "user_message"
  ],
  "forbid_peer_agent_assertion_as_authorization": true,
  "production_gate": "explicit_user_approval_required",
  "executor_model": "terminal_surface+cli (cmux send/read-screen require terminal; not agent-session)",
  "sentinel_default_interval_seconds": 7200,
  "sentinel_medium_risk_interval_seconds": 1800,
  "sentinel_cutover_interval_seconds": 300,
  "sentinel_cutover_interval_seconds_min": 300,
  "sentinel_cutover_interval_seconds_max": 600,
  "sentinel_single_instance_per_task": true,
  "sentinel_single_instance_mechanism": "fcntl.flock(LOCK_EX|LOCK_NB)",
  "sentinel_callback_first": true,
  "sentinel_supervisor_target_source": "role-map",
  "sentinel_rejects_supervisor_target_mismatching_role_map": true,
  "sentinel_ordinary_no_progress_writes_state_without_ask": true,
  "sentinel_duplicate_alert_suppression": true,
  "artifact_root": "handoff/multi-agent-artifacts/<TASK_ID> when available; registered at /tmp/multi-agent-collaboration/_registry/<TASK_ID>.json",
  "ack_format": "PREFLIGHT_ACK|<task-id>|<provider:identity>|READY|INLINE|<nonce>",
  "agent_specific_binding": {
    "claude": {
      "require_provider": "claude",
      "forbid_path_only_binding": true,
      "forbid_title_only_binding": true
    },
    "codex": {
      "require_provider": "codex",
      "forbid_path_only_binding": true,
      "forbid_title_only_binding": true
    }
  },
  "_archived": {
    "note": "tmux/PowerShell keys moved here for reference",
    "require_same_tmux_session": true,
    "forbid_cross_session_executor": true,
    "require_visible_pane_names": true,
    "require_pane_inventory": true
  },
  "turn_end_gate_is_evidence_backed_not_lexical": true,
  "turn_end_gate_must_not_block_denials_retractions_or_bug_reports": true,
  "turn_end_gate_reads_rounds_json_before_blocking": true,
  "artifact_root_never_composed_from_caller_cwd": true,
  "artifact_root_resolution_order": "explicit_flag_then_registry_then_ROOT_NOT_FOUND",
  "artifact_registry_key_is_task_id": true,
  "artifact_root_rebinding_refuses_live_conflict": true,
  "bridge_test_requires_compose_ownership_pre_read": true,
  "bridge_test_refuses_when_compose_occupied": true,
  "compose_emptiness_counts_known_placeholders_as_empty": true,
  "no_visible_compose_block_is_unsafe_not_safe": true,
  "receipts_record_budget_provenance_on_every_phase": true,
  "delivery_state_and_budget_attribution_are_orthogonal_fields": true,
  "delivery_state_count": 5,
  "only_queued_at_receiver_means_wait": true,
  "artifact_writes_are_atomic_excl_fsync_rename": true,
  "active_task_marker_writes_are_atomic": true,
  "unparseable_artifact_is_unverifiable_never_pass": true,
  "executor_verdict_is_separate_from_requested_review": true,
  "supervisor_preselected_verdict_voids_the_round": true,
  "nonapproving_verdict_must_block_or_be_explicitly_resolved": true,
  "final_verdict_position_does_not_supersede_earlier_verdicts": true,
  "leases_cover_only_finalized_pack_enumerated_absolute_paths": true,
  "lease_expiry_reports_stale_and_is_never_silently_reclaimed": true,
  "lease_enforcement_requires_both_hook_sides": true,
  "acp_is_measured_capability_data_only_no_adapter": true,
  "acp_revisit_requires_second_measured_endpoint": true,
  "same_workspace_only_is_a_blast_radius_policy_not_a_runtime_limit": true,
  "upstream_filing_requires_first_hand_user_authorization": true,
  "unmeasured_capability_records_null_never_false": true,
  "model_default_behavior": "preserve-current-model",
  "force_compose_default": false,
  "force_compose_requires_operator_authorization": true
}
