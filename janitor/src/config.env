# cmux-janitor 配置
# 改完立即生效（脚本每次运行都重读），不需要重载 launchd。
#
# 本文件里声明的每一个键，cmux-janitor.sh 都真的读取并使用。
# 若你新增一个脚本不认识的键，脚本会 fail closed 并在 janitor.log 写明原因，
# 而不是静默忽略 —— 2026-08-28 之前 QUARANTINE_KEEP_HOURS 就是被静默忽略的，
# 配置写 48 小时而脚本按 24 小时删除，承诺与实现不符。

# ---- 总开关 ----
# MODE=dry    只记日志，不动 ~/.cmuxterm，也不删隔离区任何东西
# MODE=apply  真正把孤儿移入隔离区
#
# 2026-08-27 17:15 切 apply。依据：P2 观察期 56.8 小时 / janitor 97 次运行
# 全部 exit=0 / guard 2049 次从未跳闸 / 异常标记全 0 / 抽样 5 个候选全为真孤儿。
#
# 改 MODE 不能只改这一行：guard 的 R6 会把它当成未经授权的漂移并跳闸。
# 正确流程（终端里人工执行，TUI 不提供这个能力）：
#   1. touch ~/.config/cmux-janitor/DISABLED
#   2. 改这一行
#   3. ~/.config/cmux-janitor/guard.sh --rearm --accept-mode dry|apply
#   4. 核对 guard.sh --status，确认 baseline 已更新
#   5. cmux-janitorctl resume
MODE=apply

# ---- 年龄门槛（分钟）----
# .sb-* 原子写孤儿：cmux 的原子写是「建临时文件→rename」，
# 正常窗口是毫秒级，10 分钟已是极宽松的余量。
SB_MIN_AGE_MIN=10

# staging 快照孤儿：正常捕获秒级完成（最多 64 文件 / 4MB），
# 60 分钟静止基本可判定为进程中断残骸。
STAGING_MIN_AGE_MIN=60

# ---- 隔离区保留期（小时）----
# 移入隔离区后满这个时长才真删，期间可用 uninstall.sh 原位还回。
# 到期时钟的锚点是批次的 sealed_at（封批时刻），不是批次名也不是 birth：
# 一个 500 项的批次要 6-8 分钟才填满，用 birth 会让最后移入的项少保留那么久。
QUARANTINE_KEEP_HOURS=48

# ---- 单次处理上限 ----
# .sb-* 与 staging 共用这一个全局配额（2026-08-28 之前是各自 500，
# 合计可达 1000，生产日志里出现过 candidates=514）。
# 即使判定逻辑有 bug，一次也跑不飞。
MAX_ITEMS_PER_RUN=500

# ---- 隔离区开关 ----
# 1 = 移入隔离区（可还原）。这是唯一合法值。
# 0（直接删除）已于 2026-09-01 废除：脚本对任何非 1 的值 fail closed（本轮
# 不做任何处置），guard 的 R9 会把该键的漂移视为违规并跳闸。只读检查请用
# cmux-janitorctl status / inspect。
USE_QUARANTINE=1

# ---- 日志上限（字节）----
LOG_MAX_BYTES=1048576

# ---- 指标保留 ----
# metrics.jsonl 每轮追加一行，用于事后评估定时清扫是否有缺口。
# 不记录路径、文件名或任何正文。
#
# 两个上限的生效范围**不同**，这不是笔误：
#   METRICS_KEEP_LINES  定时清扫每轮自动执行（cmux-janitor.sh 追加后立即裁剪）
#   METRICS_KEEP_DAYS   **仅**在人工执行 `cmux-janitorctl compact-metrics` 时生效
#
# 目前没有任何 launchd 作业调用 compact-metrics，所以按天裁剪**不会自动发生**。
# 行数上限已经给出无条件的体积保证（2048 行约 400KB），按天裁剪只影响「保留多久
# 的历史用于回溯」，不影响磁盘安全，故未加自动调用 —— 多一个定时作业就多一个会
# 静默失败的东西。要清理旧记录请手动跑 compact-metrics。
METRICS_KEEP_DAYS=14
METRICS_KEEP_LINES=2048

# ---- 详细日志 ----
VERBOSE=0

# ---- 已废弃的键（写在这里只为说明，不要启用）----
# QUARANTINE_RETAIN_HOURS  旧脚本内部名。现在若出现在本文件里，
#                          脚本会 fail closed，因为两个名字并存必然歧义。
# LSOF_SAMPLE_LIMIT        曾被写在这里但脚本从未引用。实际行为是对每个
#                          候选都做 lsof 检查（无抽检上限），单项约 0.5s。
