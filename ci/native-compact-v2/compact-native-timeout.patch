+#[tokio::test]
+async fn compact_cancel_wait_joins_request_and_mapper_before_retry() {
+    use std::sync::Arc;
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+    struct MarkDropped(Arc<AtomicUsize>);
+    impl Drop for MarkDropped {
+        fn drop(&mut self) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+    let stopped = Arc::new(AtomicUsize::new(0));
+    let mapper_guard = MarkDropped(Arc::clone(&stopped));
+    let request_guard = MarkDropped(Arc::clone(&stopped));
+    let mapper_task = tokio::spawn(async move {
+        let _guard = mapper_guard;
+        std::future::pending::<()>().await;
+    });
+    let request_task = tokio::spawn(async move {
+        let _guard = request_guard;
+        std::future::pending::<()>().await;
+    });
+    let (_tx, rx_event) = tokio::sync::mpsc::channel(1);
+    let stream = super::ResponseStream {
+        rx_event,
+        interrupt: None,
+        consumer_dropped: tokio_util::sync::CancellationToken::new(),
+        mapper_task: Some(mapper_task),
+        request_task: Some(request_task),
+    };
+    stream.cancel_and_wait().await;
+    assert_eq!(stopped.load(Ordering::SeqCst), 2);
+}
