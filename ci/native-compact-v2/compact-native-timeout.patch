@@ -0,0 +1,39 @@
+use super::CompactionDeadline;
+use pretty_assertions::assert_eq;
+use std::time::Duration;
+use tokio::time::Instant;
+
+#[tokio::test(start_paused = true)]
+async fn timeout_budget_is_not_extended_by_observations_and_allows_one_retry() {
+    let mut budget = CompactionDeadline::new();
+    let first = budget.deadline;
+    tokio::time::advance(Duration::from_secs(299)).await;
+    assert_eq!(budget.deadline, first);
+    tokio::time::advance(Duration::from_secs(1)).await;
+    assert_eq!(budget.deadline, Instant::now());
+    assert!(budget.retry_after_timeout());
+    let second = budget.deadline;
+    assert_eq!(second.duration_since(first), Duration::from_secs(300));
+    tokio::time::advance(Duration::from_secs(300)).await;
+    assert!(!budget.retry_after_timeout());
+    assert_eq!(budget.deadline, second);
+}
+
+#[tokio::test(start_paused = true)]
+async fn expired_deadline_does_not_poll_or_submit_a_new_request() {
+    use std::cell::Cell;
+    let budget = CompactionDeadline::new();
+    tokio::time::advance(Duration::from_secs(300)).await;
+    let submitted = Cell::new(false);
+    let result = budget.run(async { submitted.set(true) }).await;
+    assert_eq!(result, Err(()));
+    assert!(!submitted.get());
+}
+
+#[tokio::test(start_paused = true)]
+async fn pending_request_is_dropped_at_the_native_deadline() {
+    let budget = CompactionDeadline::new();
+    let result = budget.run(std::future::pending::<()>()).await;
+    assert_eq!(result, Err(()));
+    assert_eq!(Instant::now(), budget.deadline);
+}
