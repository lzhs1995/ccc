@@ -0,0 +1,45 @@
+use std::future::Future;
+use std::time::Duration;
+use tokio::time::Instant;
+
+pub(crate) const COMPACTION_TIMEOUT_MESSAGE: &str =
+    "Compaction timed out after 300 seconds; the single timeout retry is exhausted";
+
+/// One timeout recovery budget for a native compact lifecycle, shared by all request paths.
+pub(crate) struct CompactionDeadline {
+    deadline: Instant,
+    retry_used: bool,
+}
+
+impl CompactionDeadline {
+    pub(crate) fn new() -> Self {
+        Self {
+            deadline: Instant::now() + Duration::from_secs(300),
+            retry_used: false,
+        }
+    }
+
+    pub(crate) async fn run<T>(&self, request: impl Future<Output = T>) -> Result<T, ()> {
+        // Do not poll a new request when hooks/backoff already consumed its deadline.
+        if self.deadline <= Instant::now() {
+            return Err(());
+        }
+        tokio::time::timeout_at(self.deadline, request)
+            .await
+            .map_err(|_| ())
+    }
+
+    /// Call only after the expired request and its stream tasks have terminated.
+    pub(crate) fn retry_after_timeout(&mut self) -> bool {
+        if self.retry_used {
+            return false;
+        }
+        self.retry_used = true;
+        self.deadline = Instant::now() + Duration::from_secs(300);
+        true
+    }
+}
+
+#[cfg(test)]
+#[path = "compact_deadline_tests.rs"]
+mod tests;
