 pub struct ResponseStream {
+    pub(crate) mapper_task: Option<tokio::task::JoinHandle<()>>,
+    pub(crate) request_task: Option<tokio::task::JoinHandle<()>>,
     pub(crate) rx_event: mpsc::Receiver<Result<ResponseEvent>>,
     pub(crate) interrupt: Option<oneshot::Sender<()>>,
     /// Signals the mapper task that the consumer stopped polling before the
     /// provider stream reached its own terminal event.
     pub(crate) consumer_dropped: CancellationToken,
+}
+
+impl ResponseStream {
+    /// Stop local request producers and wait for their destructors before a compact retry.
+    pub(crate) async fn cancel_and_wait(mut self) {
+        self.consumer_dropped.cancel();
+        self.rx_event.close();
+        let tasks = [self.mapper_task.take(), self.request_task.take()];
+        for task in tasks.iter().flatten() {
+            task.abort();
+        }
+        for task in tasks.into_iter().flatten() {
+            let _ = task.await;
+        }
+    }
 }
 
 impl Stream for ResponseStream {
