+/// Deterministic deadline tests run only on the fixed head. No sleeps or live PTY required.
+@Suite(.serialized)
+@MainActor
+struct HerdrStartupRestoreBoundaryTests {
+    private let fixture = HerdrStartupRestoreRegressionTests()
+
+    @Test func deadlineCancelsBeforeTopologyCommitAndKeepsManualOuter() throws {
+        let (workspace, panelID, panel) = try fixture.restore(fixture.herdrBinding(), includeInnerAgent: true)
+        defer { fixture.close(workspace) }
+        let pending = try #require(workspace.pendingHerdrStartupRestoresByPanelId[panelID])
+        workspace.herdrStartupRestoreUptime = { pending.deadline }
+        workspace.expireHerdrStartupRestores()
+        #expect(workspace.pendingHerdrStartupRestoresByPanelId[panelID] == nil)
+        #expect(panel.surface.isAwaitingStartupRestoreAdmission)
+        #expect(workspace.surfaceResumeBinding(panelId: panelID)?.autoResume == false)
+        for _ in 0..<4 { workspace.reconcileSurfaceResumeBindings(using: .empty) }
+        let manual = try #require(workspace.surfaceResumeBinding(panelId: panelID))
+        #expect(manual.approvalPolicy == .manual)
+        workspace.terminalStartupRestoreCoordinator.commitPendingRestores()
+        #expect(!panel.surface.isAwaitingStartupRestoreAdmission)
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == manual)
+    }
+
+    @Test func readsDoNotExtendFixedDeadline() throws {
+        let (workspace, panelID, _) = try fixture.restore(fixture.herdrBinding())
