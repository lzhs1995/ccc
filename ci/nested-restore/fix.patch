+/// One approved attach, bounded from staging through the first process observation.
+/// Keep the full binding and terminal generation so stale callbacks cannot retire
+/// a replacement attach or suppress another runtime's startup input.
+struct PendingHerdrStartupRestore {
+    let token = UUID()
+    let binding: SurfaceResumeBindingSnapshot
+    let terminalLifecycleID: UUID
+    let deadline: TimeInterval
+}
+
+@MainActor
+extension Workspace {
+    static let herdrStartupRestoreTimeout: TimeInterval = 120
+
+    func beginHerdrStartupRestore(binding: SurfaceResumeBindingSnapshot, panel: TerminalPanel) {
+        let pending = PendingHerdrStartupRestore(
+            binding: binding,
+            terminalLifecycleID: panel.surface.terminalLifecycleId,
+            deadline: herdrStartupRestoreUptime() + Self.herdrStartupRestoreTimeout
+        )
+        pendingHerdrStartupRestoresByPanelId[panel.id] = pending
+        let previousExplicitInput = panel.surface.onExplicitInput
+        panel.surface.onExplicitInput = { [weak self, weak panel] in
+            previousExplicitInput?()
+            guard let self, let panel, panel.workspaceId == self.id else { return }
+            self.retireHerdrStartupRestore(panelId: panel.id, token: pending.token)
+        }
+        let panelID = panel.id
+        Task { @MainActor [weak self] in
+            do {
+                try await Task.sleep(for: .seconds(Self.herdrStartupRestoreTimeout))
+            } catch { return }
+            guard let self,
+                  self.pendingHerdrStartupRestoresByPanelId[panelID]?.token == pending.token else { return }
+            self.expireHerdrStartupRestores()
+        }
+    }
+
+    func preservesHerdrStartupBinding(_ binding: SurfaceResumeBindingSnapshot, panelId: UUID) -> Bool {
+        guard binding.isHerdrProcessDetectedBinding else { return false }
+        // A failed restore keeps its outer owner for explicit retry, including
+        // after another save/relaunch. Never let its inner agent become fallback.
+        if binding.autoResume == false, binding.approvalPolicy == .manual { return true }
+        guard let pending = pendingHerdrStartupRestoresByPanelId[panelId],
+              pending.binding == binding,
+              let panel = terminalPanel(for: panelId), panel.workspaceId == id else { return false }
+        return pending.terminalLifecycleID == panel.surface.terminalLifecycleId
+    }
+
+    func expireHerdrStartupRestores() {
+        let now = herdrStartupRestoreUptime()
+        for (panelId, pending) in pendingHerdrStartupRestoresByPanelId where now >= pending.deadline {
+            retireHerdrStartupRestore(panelId: panelId, token: pending.token)
+        }
+    }
+
+    /// Shared failure transition for expiry, uncertainty, and accepted input.
+    func retireHerdrStartupRestore(panelId: UUID, token: UUID) {
+        guard let pending = pendingHerdrStartupRestoresByPanelId[panelId], pending.token == token else { return }
+        pendingHerdrStartupRestoresByPanelId.removeValue(forKey: panelId)
+        guard surfaceResumeBindingsByPanelId[panelId] == pending.binding,
+              let panel = terminalPanel(for: panelId), panel.workspaceId == id,
+              panel.surface.terminalLifecycleId == pending.terminalLifecycleID else { return }
+        panel.surface.cancelStartupRestoreInput(expectedLifecycleID: pending.terminalLifecycleID)
+        surfaceResumeBindingsByPanelId[panelId] = pending.binding.forcingManualRestore()
+    }
+
+    /// Detection, explicit replacement and clear invalidate the old queued selector.
+    func discardHerdrStartupRestore(panelId: UUID) {
+        guard let pending = pendingHerdrStartupRestoresByPanelId.removeValue(forKey: panelId),
+              surfaceResumeBindingsByPanelId[panelId] == pending.binding,
+              let panel = terminalPanel(for: panelId), panel.workspaceId == id else { return }
+        panel.surface.cancelStartupRestoreInput(expectedLifecycleID: pending.terminalLifecycleID)
+    }
+}
