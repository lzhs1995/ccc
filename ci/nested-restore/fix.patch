+        workspace.herdrStartupRestoreUptime = { pending.deadline - 1 }
+        for _ in 0..<4 {
+            _ = workspace.effectiveSurfaceResumeBinding(panelId: panelID, surfaceResumeBindingIndex: .empty)
+        }
+        #expect(workspace.pendingHerdrStartupRestoresByPanelId[panelID]?.deadline == pending.deadline)
