+/// Exercise the actual workspace restore and snapshot paths. The base loses
+/// Herdr on its first empty scan and leaves its startup outside topology admission.
+@Suite(.serialized)
+@MainActor
+struct HerdrStartupRestoreRegressionTests {
+    fileprivate func herdrBinding(session: String = "outer-session", capturedAt: TimeInterval = 10) throws -> SurfaceResumeBindingSnapshot {
+        try #require(ProcessDetectedTerminalBinding.binding(
+            processName: "herdr",
+            processPath: nil,
+            processArguments: CmuxTopProcessArguments(
+                arguments: ["/cmux-restore-test-missing/herdr", "--session", session],
+                environment: ["PWD": "/tmp"]
+            ),
+            capturedAt: capturedAt
+        ))
+    }
+
+    fileprivate func restore(
+        _ binding: SurfaceResumeBindingSnapshot,
+        includeInnerAgent: Bool = false
+    ) throws -> (Workspace, UUID, TerminalPanel) {
+        let source = Workspace()
+        defer { close(source) }
+        let sourcePanelID = try #require(source.focusedPanelId)
+        #expect(source.setSurfaceResumeBinding(binding, panelId: sourcePanelID))
+        var snapshot = source.sessionSnapshot(includeScrollback: false)
+        if includeInnerAgent {
+            snapshot.panels[0].terminal?.agent = SessionRestorableAgentSnapshot(
+                kind: .codex, sessionId: "inner-must-not-replace-herdr",
+                workingDirectory: "/tmp", launchCommand: nil
+            )
+            snapshot.panels[0].terminal?.wasAgentRunning = true
+        }
+        let workspace = Workspace()
+        workspace.restoreSessionSnapshot(snapshot, startupRestoreCommitOwner: .tabManagerTopology)
+        let panelID = try #require(workspace.focusedPanelId)
+        return (workspace, panelID, try #require(workspace.terminalPanel(for: panelID)))
+    }
+
+    fileprivate func close(_ workspace: Workspace) {
+        for panelID in Array(workspace.panels.keys) {
+            _ = workspace.closePanel(panelID, force: true)
+        }
+    }
+
+    private func detected(_ binding: SurfaceResumeBindingSnapshot, workspace: Workspace, panelID: UUID) -> SurfaceResumeBindingIndex {
+        SurfaceResumeBindingIndex(bindingsByPanel: [
+            .init(workspaceId: workspace.id, panelId: panelID): binding
+        ])
+    }
+
+    @Test func emptyScanBeforeStartupPreservesOuterBindingInBothReadAndSave() throws {
+        let binding = try herdrBinding()
+        let (workspace, panelID, _) = try restore(binding, includeInnerAgent: true)
+        defer { close(workspace) }
+        #expect(workspace.effectiveSurfaceResumeBinding(panelId: panelID, surfaceResumeBindingIndex: .empty)?.kind == "herdr", "HERDR_PENDING_READ_MUST_KEEP_OUTER_BINDING")
+        let saved = workspace.sessionSnapshot(includeScrollback: false, surfaceResumeBindingIndex: .empty)
+        #expect(saved.panels.first?.terminal?.resumeBinding?.checkpointId == "outer-session", "HERDR_PENDING_SAVE_MUST_KEEP_OUTER_BINDING")
+        #expect(workspace.surfaceResumeBinding(panelId: panelID)?.kind == "herdr")
+    }
+
+    @Test func backgroundHerdrWaitsForTopologyCommitWithoutAgentLifecycle() throws {
+        let (workspace, panelID, panel) = try restore(herdrBinding())
+        defer { close(workspace) }
+        #expect(panel.surface.initialInput != nil)
+        #expect(panel.surface.isAwaitingStartupRestoreAdmission, "HERDR_STARTUP_REQUIRES_TOPOLOGY_ADMISSION")
+        #expect(workspace.restoredAgentResumeStatesByPanelId[panelID] == nil)
+        workspace.terminalStartupRestoreCoordinator.commitPendingRestores()
+        #expect(!panel.surface.isAwaitingStartupRestoreAdmission)
+        #expect(workspace.restoredAgentResumeStatesByPanelId[panelID] == nil)
+    }
+
+    @Test func observedHerdrClosesGapAndLaterExitIsNotPreserved() throws {
+        let (workspace, panelID, _) = try restore(herdrBinding())
+        defer { close(workspace) }
+        let live = try herdrBinding(capturedAt: 20)
+        workspace.reconcileSurfaceResumeBindings(using: detected(live, workspace: workspace, panelID: panelID))
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == live)
+        workspace.reconcileSurfaceResumeBindings(using: .empty)
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == nil)
+    }
+
+    @Test func freshProcessReadClosesGapBeforeLaterEmptyScan() throws {
+        let (workspace, panelID, _) = try restore(herdrBinding())
+        defer { close(workspace) }
+        let live = try herdrBinding(capturedAt: 20)
+        #expect(workspace.effectiveSurfaceResumeBinding(
+            panelId: panelID, surfaceResumeBindingIndex: detected(live, workspace: workspace, panelID: panelID)
+        ) == live)
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == live)
+        workspace.reconcileSurfaceResumeBindings(using: .empty)
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == nil)
+    }
+
+    @Test func newDetectedGenerationReplacesPendingOriginal() throws {
+        let (workspace, panelID, _) = try restore(herdrBinding())
+        defer { close(workspace) }
+        let replacement = try herdrBinding(session: "different-session", capturedAt: 30)
+        workspace.reconcileSurfaceResumeBindings(using: detected(replacement, workspace: workspace, panelID: panelID))
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == replacement)
+        workspace.reconcileSurfaceResumeBindings(using: .empty)
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == nil)
+    }
+
+    @Test func explicitClearCannotBeResurrectedByPendingOriginal() throws {
+        let (workspace, panelID, _) = try restore(herdrBinding())
+        defer { close(workspace) }
+        #expect(workspace.clearSurfaceResumeBinding(panelId: panelID))
+        workspace.reconcileSurfaceResumeBindings(using: .empty)
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == nil)
+        #expect(workspace.effectiveSurfaceResumeBinding(panelId: panelID, surfaceResumeBindingIndex: .empty) == nil)
+    }
+
+    @Test func initialShellActivityDoesNotProveHerdrStartupFailed() throws {
+        let (workspace, panelID, _) = try restore(herdrBinding(), includeInnerAgent: true)
+        defer { close(workspace) }
+        workspace.updatePanelShellActivityState(panelId: panelID, state: .commandRunning)
+        workspace.updatePanelShellActivityState(panelId: panelID, state: .promptIdle)
+        for _ in 0..<4 { workspace.reconcileSurfaceResumeBindings(using: .empty) }
+        let binding = try #require(workspace.surfaceResumeBinding(panelId: panelID))
+        #expect(binding.kind == "herdr")
+        #expect(binding.autoResume == true)
+        let saved = workspace.sessionSnapshot(includeScrollback: false, surfaceResumeBindingIndex: .empty)
+        #expect(saved.panels.first?.terminal?.resumeBinding?.kind == "herdr")
+    }
+
+    @Test func acceptedExplicitInputCancelsPendingAutomaticIntent() throws {
+        let (workspace, panelID, panel) = try restore(herdrBinding())
+        defer { close(workspace) }
+        panel.surface.didAcceptExplicitInput()
+        workspace.reconcileSurfaceResumeBindings(using: .empty)
+        let manual = try #require(workspace.surfaceResumeBinding(panelId: panelID))
+        #expect(manual.kind == "herdr")
+        #expect(manual.autoResume == false)
+        #expect(panel.hasReceivedExplicitInput)
+    }
+
+    @Test func manualOuterIntentSurvivesAnotherRestoreWithoutInnerAutoResume() throws {
+        let (workspace, panelID, panel) = try restore(herdrBinding(), includeInnerAgent: true)
+        defer { close(workspace) }
+        panel.surface.didAcceptExplicitInput()
+        let manual = try #require(workspace.surfaceResumeBinding(panelId: panelID))
+        let (next, nextID, nextPanel) = try restore(manual, includeInnerAgent: true)
+        defer { close(next) }
+        let saved = next.sessionSnapshot(includeScrollback: false, surfaceResumeBindingIndex: .empty)
+        #expect(saved.panels.first?.terminal?.resumeBinding?.kind == "herdr")
+        #expect(next.surfaceResumeBinding(panelId: nextID)?.autoResume == false)
+        #expect(nextPanel.surface.initialInput == nil)
+        #expect(!nextPanel.surface.isAwaitingStartupRestoreAdmission)
+    }
+
+    @Test func oldExplicitInputCallbackCannotRetireReplacementBinding() throws {
+        let (workspace, panelID, panel) = try restore(herdrBinding())
+        defer { close(workspace) }
+        let oldCallback = panel.surface.onExplicitInput
+        let replacement = try herdrBinding(session: "replacement", capturedAt: 40)
+        #expect(workspace.setSurfaceResumeBinding(replacement, panelId: panelID))
+        oldCallback?()
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == replacement)
+        workspace.reconcileSurfaceResumeBindings(using: .empty)
+        #expect(workspace.surfaceResumeBinding(panelId: panelID) == nil)
+    }
+
+    @Test func manualAndUntrustedImportsNeverAcquireAutomaticStartupAdmission() throws {
+        for binding in [try herdrBinding().forcingManualRestore(), try herdrBinding().markingUntrustedSessionImport()] {
+            let (workspace, _, panel) = try restore(binding)
+            defer { close(workspace) }
+            #expect(panel.surface.initialInput == nil)
+            #expect(!panel.surface.isAwaitingStartupRestoreAdmission)
+        }
+    }
+}
