+func TestLocalCompactHeartbeatMarkerIsolation(t *testing.T) {
+	localCompactClock(t)
+	rec := &recorder{header: http.Header{}}
+	ctx := context.WithValue(context.Background(), localCompactRecorderKey{}, rec)
+	if !localCompactRecorderIn(ctx, rec) || localCompactRecorderIn(ctx, httptest.NewRecorder()) || localCompactRecorderIn(context.Background(), rec) {
+		t.Fatal("private recorder identity not isolated")
+	}
+	for _, private := range []bool{true, false} {
+		out := httptest.NewRecorder()
+		a := &keptAlive{proto: provider.Responses, streams: true, codexPing: true, localCompactBuffered: private, told: time.Now().Add(-agentQuietMost)}
+		h := newHoldWriter(out, true)
+		h.alive, h.streams, h.ctx = a, true, context.Background()
+		stop := h.keepQueued()
+		time.Sleep(3 * keepaliveEvery)
+		stop()
+		h.mu.Lock()
+		h.keepAlive()
+		h.passing = true
+		h.w.Header().Set("Content-Type", "text/event-stream")
+		h.keepQuiet()
+		h.mu.Unlock()
+		pauseAlive(context.Background(), out, a, true, time.Now().Add(-keepHeldAfter), keepaliveEvery)
+		if private && (a.sent || out.Body.Len() != 0 || a.tooQuiet(0)) {
+			t.Fatal("private recorder committed by queue/keepAlive/tooQuiet")
+		}
+		if !private && (!a.sent || out.Body.Len() == 0) {
+			t.Fatal("ordinary recorder behavior changed")
+		}
+	}
+	for _, tc := range []struct{ ua, body string }{{"ordinary-client", `{"stream":true}`}, {"codex_cli_rs/0.164.0", `{"stream":false}`}} {
+		r := httptest.NewRequest("POST", "/v1/responses", nil)
+		r.Header.Set("User-Agent", tc.ua)
+		returned, wait := startLocalCompactHeartbeat(httptest.NewRecorder(), r, []byte(tc.body))
+		if wait != nil || returned != r {
+			t.Fatal("non-Codex/non-stream caller changed")
+		}
+	}
+	// The actual downstream wrapper cancels derived work on either kind
+	// of invalid write result; no real response budget is fabricated.
+	for _, mode := range []string{"short", "error"} {
+		ctx, cancel := context.WithCancel(context.Background())
+		out := localCompactOutput()
+		out.mode = mode
+		w := &compactHeartbeatWriter{ResponseWriter: out, cancel: cancel}
+		_, err := w.Write([]byte("event: ping\n\n"))
+		if ctx.Err() == nil || err == nil || mode == "short" && !errors.Is(err, io.ErrShortWrite) {
+			t.Fatalf("write failure not canceled: %s %v", mode, err)
+		}
+	}
+}
