+func TestLocalCompactHeartbeatCancelBeforeSupplier(t *testing.T) {
+	fresh(t)
+	localCompactClock(t)
+	f := responseVendor(t, "wait", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
