+// deadKeySaid is what the agent is told when every remaining relay key is
+// gone. Claude Code pauses on the two upstream sentences themselves
+// ("Please run /login"), even after the status has been rewritten to 503,
+// so this text repeats neither of them and names no 401 or 403.
+const deadKeySaid = "relay key unavailable, no backup left"
+
+// upstreamKeyGone is a relay key that can no longer answer: its group was
+// deleted, or the key itself is disabled. Claude Code treats every 401 and
+// 403 as "Please run /login" and pauses the turn, so these two — and only
+// these two — are a dead key, not a request the vendor refused. A plain
+// 403 that says anything else stays a plain 403 (plugins#243).
+func upstreamKeyGone(status int, body []byte) bool {
+	if status != http.StatusUnauthorized && status != http.StatusForbidden {
+		return false
+	}
+	if bytes.Contains(body, []byte("分组已删除")) {
+		return true
+	}
+	return bytes.Contains(bytes.ToLower(body), []byte("api key is disabled"))
+}
+
+// withheld is the candidates probeOne held back: in all, in that order,
+// whose rest key is not already in asked. A candidate is one rest key.
+func withheld(all, asked []candidate) []candidate {
+	seen := make(map[string]bool, len(asked))
+	for _, c := range asked {
+		seen[c.restKey()] = true
+	}
+	var out []candidate
+	for _, c := range all {
+		k := c.restKey()
+		if k == "" || seen[k] {
+			continue
+		}
+		seen[k] = true
+		out = append(out, c)
+	}
+	return out
