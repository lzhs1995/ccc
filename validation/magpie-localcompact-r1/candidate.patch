+package gateway
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+func TestCCCStreamAuthClassification(t *testing.T) {
+	for _, c := range []struct {
+		name, data string
+		status int
+	}{
+		{"nested401", `{"type":"error","error":{"type":"authentication_error","message":"account unavailable"}}`, 401},
+		{"nested403", `{"type":"error","error":{"type":"permission_error","message":"account unavailable"}}`, 403},
+		{"failed401", `{"type":"response.failed","response":{"status":"failed","error":{"type":"authentication_error","message":"account unavailable"}}}`, 401},
+		{"failed403", `{"type":"response.failed","response":{"status":"failed","error":{"type":"permission_error","message":"account unavailable"}}}`, 403},
+		{"type_beats_words", `{"type":"error","error":{"type":"permission_error","message":"rate_limit context_length_exceeded"}}`, 403},
+		{"message_not_type", `{"type":"error","error":{"type":"server_error","message":"authentication_error permission_error 401 403"}}`, 502},
+		{"string_not_object", `{"type":"error","error":"permission_error"}`, 502},
+		{"object_not_type", `{"type":"error","error":{"type":{"name":"permission_error"}}}`, 502},
+		{"rate_unchanged", `{"type":"error","error":{"type":"rate_limit_error","message":"rate limit"}}`, 429},
+		{"busy_unchanged", `{"type":"error","error":{"type":"server_error","message":"unavailable"}}`, 502},
+		{"invalid_unchanged", `{"type":"error","error":{"type":"invalid_request_error","message":"invalid field"}}`, 400},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			kind, status, _ := streamEvent([]byte("data: "+c.data+"\n\n"))
+			if kind != eventError || status != c.status {
+				t.Fatalf("kind/status = %d/%d, want error/%d", kind, status, c.status)
+			}
+		})
+	}
+	// A model may discuss authorization errors in ordinary content.
+	if kind, _, _ := streamEvent([]byte("data: {\"type\":\"response.output_text.delta\",\"delta\":\"permission_error\"}\n\n")); kind != eventContent {
+		t.Fatalf("ordinary content was classified as error: %d", kind)
+	}
+}
+
+func TestCCCStreamAuthNoSameAccountRetry(t *testing.T) {
+	for _, typ := range []string{"authentication_error", "permission_error"} {
+		for _, shape := range []string{"error", "response.failed"} {
+			for _, route := range []struct { name, path, body string; whole bool }{
+				{"responses_stream", "/v1/responses", `{"model":"fake/m1","stream":true,"input":"synthetic"}`, false},
+				{"responses_whole", "/v1/responses", `{"model":"fake/m1","stream":false,"input":"synthetic"}`, true},
+				{"chat_stream", "/v1/chat/completions", `{"model":"fake/m1","stream":true,"messages":[{"role":"user","content":"synthetic"}]}`, false},
+				{"chat_whole", "/v1/chat/completions", `{"model":"fake/m1","stream":false,"messages":[{"role":"user","content":"synthetic"}]}`, true},
+			} {
+				t.Run(typ+"/"+shape+"/"+route.name, func(t *testing.T) {
+					fresh(t)
+					e := fmt.Sprintf(`{"type":%q,"code":"fixture_auth_refused","message":"ACCOUNT_REFUSED","param":"key"}`, typ)
+					data := `{"type":"error","error":`+e+`}`
+					if shape == "response.failed" {
+						data = `{"type":"response.failed","response":{"id":"fixture","status":"failed","error":`+e+`}}`
+					}
+					f := &fake{reply: ": keepalive\n\ndata: "+data+"\n\n"}
+					setup(t, provider.Responses, f)
+					status, body := post(t, route.path, route.body)
+					if f.calls != 1 {
+						t.Errorf("same refused account asked %d times, want once", f.calls)
+					}
+					// A native Responses fixture deliberately ignores stream:false and
+					// sends SSE. Passthrough preserves that wire protocol; only Chat
+					// whole invokes translation into a JSON error. All paths must still
+					// preserve the refusal and ask this account exactly once.
+					if route.whole && route.name == "chat_whole" {
+						want := http.StatusUnauthorized
+						if typ == "permission_error" { want = http.StatusForbidden }
+						if status != want { t.Errorf("status=%d want=%d; %s", status, want, body) }
+					}
+					if !strings.Contains(body, "ACCOUNT_REFUSED") || !strings.Contains(body, typ) {
+						t.Errorf("typed refusal was lost: %d %s", status, body)
+					}
+					if strings.Contains(body, "response.completed") {
+						t.Errorf("refusal presented as completion: %s", body)
+					}
+				})
+			}
+		}
+	}
+}
diff --git a/internal/gateway/ccc_terminal_output_test.go b/internal/gateway/ccc_terminal_output_test.go
new file mode 100644
--- /dev/null
+++ b/internal/gateway/ccc_terminal_output_test.go
@@ -0,0 +1,59 @@
+package gateway
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func cccExtractionframe(v any) string {
+	b, _ := json.Marshal(v)
+	return "data: " + string(b) + "\n\n"
+}
+
+func cccExtractionmessage(text string) any {
+	return map[string]any{"type": "message", "content": []any{map[string]any{"type": "output_text", "text": text}}}
+}
+
+func cccExtractiondone(item any) string {
+	return cccExtractionframe(map[string]any{"type": "response.output_item.done", "item": item})
+}
+
+func cccExtractionterminal(status string, items ...any) string {
+	return cccExtractionframe(map[string]any{"type": "response." + status, "response": map[string]any{
+		"id": "response-test", "status": status, "output": items, "usage": map[string]any{"output_tokens": 7},
+	}})
+}
+
+func cccExtractiontextOf(r compactResult) string {
+	var out strings.Builder
+	for _, item := range r.Output {
+		if item.Type == "message" {
+			for _, part := range item.Content { out.WriteString(part.Text) }
+		}
+	}
+	return out.String()
+}
+
+func TestCCCTerminalOutputPreserved(t *testing.T) {
+	reasoning := map[string]any{"type": "reasoning"}
+	cases := []struct{name, body, want, status string; error bool}{
+		{"reasoning_done_does_not_discard_final_summary", cccExtractiondone(reasoning) + cccExtractionterminal("completed", reasoning, cccExtractionmessage("最终摘要")), "最终摘要", "completed", false},
+		{"partial_message_done_does_not_replace_final_output", cccExtractiondone(cccExtractionmessage("old")) + cccExtractionterminal("completed", cccExtractionmessage("final complete")), "final complete", "completed", false},
+		{"terminal_output_is_not_duplicated", cccExtractiondone(cccExtractionmessage("same")) + cccExtractionterminal("completed", cccExtractionmessage("same")), "same", "completed", false},
+		{"backend_empty_terminal_uses_done", cccExtractiondone(cccExtractionmessage("legacy")) + cccExtractionterminal("completed"), "legacy", "completed", false},
+		{"reasoning_only_stays_empty", cccExtractiondone(reasoning) + cccExtractionterminal("completed", reasoning), "", "completed", false},
+		{"delta_only_does_not_invent_final_summary", cccExtractionframe(map[string]any{"type":"response.output_text.delta", "delta":"unfinished"}) + cccExtractionterminal("completed"), "", "completed", false},
+		{"missing_terminal_stays_unfinished", cccExtractiondone(cccExtractionmessage("unfinished")), "unfinished", "", false},
+		{"incomplete_status_is_not_promoted", cccExtractionterminal("incomplete", cccExtractionmessage("partial")), "partial", "incomplete", false},
+		{"error_event_is_not_swallowed", cccExtractiondone(cccExtractionmessage("earlier")) + cccExtractionframe(map[string]any{"type":"error", "message":"upstream failed"}), "", "", true},
+		{"whole_json_unchanged", `{"id":"r","status":"completed","output":[{"type":"message","content":[{"text":"json"}]}]}`, "json", "completed", false},
+	}
+	for _, c := range cases { t.Run(c.name, func(t *testing.T) {
+		r, err := compactReply([]byte(c.body))
+		if (err != nil) != c.error { t.Fatalf("error=%v", err) }
+		if c.error { return }
+		if got := cccExtractiontextOf(r); got != c.want { t.Errorf("summary=%q want=%q", got, c.want) }
+		if r.Status != c.status { t.Errorf("status=%q want=%q",r.Status,c.status) }
+	}) }
+}
