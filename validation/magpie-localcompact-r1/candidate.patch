+func TestLocalCompactHeartbeatHandedOnSentinel(t *testing.T) {
+	fresh(t)
+	localCompactClock(t)
+	release := make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	f := responseVendor(t, "wait", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
+		select {
+		case <-release:
+		case <-r.Context().Done():
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, wholeSummary(provider.Responses))
+	})
+	t.Cleanup(unblock)
+	if err := provider.SaveGroup(provider.Group{ID: "waitgroup", Name: "waitgroup", Members: []string{"wait/m"}}); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := &keptAlive{proto: provider.Responses, sent: true, streams: true,
+		at: time.Unix(12, 0), told: time.Unix(13, 0), codexPingAt: time.Unix(14, 0)}
+	want := *sentinel
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
