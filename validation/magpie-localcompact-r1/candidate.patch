+// These subprocesses are temporary test fixtures, never a model/client session.
+func TestPortableProcessFixture(t *testing.T) {
+	mode := os.Getenv("PORTABLE_FIXTURE_MODE")
+	if mode == "" {
+		return
+	}
+	t.Setenv("XDG_CONFIG_HOME", os.Getenv("PORTABLE_FIXTURE_CONFIG"))
+	c := codexPortableGate()
+	if mode == "try" {
+		res, err := PortCodexRollouts(context.Background(), os.Getenv("PORTABLE_FIXTURE_HOME"))
+		fmt.Printf("ADMITTED=%v ERROR=%v\n", res.Done, err)
+		if !errors.Is(err, errPortablePaused) {
+			os.Exit(41)
+		}
+		return
+	}
+	p, err := c.begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	finish, err := p.beginFile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := p.createTemp(os.Getenv("PORTABLE_FIXTURE_HOME"), ".portable-fixture-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Println("READY")
+	if mode == "abandon" {
+		os.Exit(23)
+	} // persisted outstanding work must survive a process exit
+	io.Copy(io.Discard, os.Stdin)
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(f.Name()); err != nil {
+		t.Fatal(err)
+	}
+	finish()
+	p.close()
+}
