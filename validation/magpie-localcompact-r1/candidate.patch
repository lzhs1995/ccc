+		t.Fatalf("%+v", got)
+	}
+	if withheld(all, all) != nil {
+		t.Fatal("nothing held back")
+	}
+}
+
+// keyGone is one upstream that answers per bearer key.
+type keyGone struct {
+	sync.Mutex
+	n      map[string]int
+	status map[string]int
+	body   map[string]string
+}
+
+func (h *keyGone) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	key := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+	h.Lock()
+	h.n[key]++
+	code := h.status[key]
+	body := h.body[key]
+	h.Unlock()
+	w.Header().Set("Content-Type", "application/json")
+	if code == 0 {
+		code = 200
+	}
+	if body == "" && code == 200 {
+		body = `{"id":"ok-` + key + `","choices":[]}`
+	}
+	w.WriteHeader(code)
+	io.WriteString(w, body)
+}
+
+func (h *keyGone) got(key string) int {
+	h.Lock()
+	defer h.Unlock()
+	return h.n[key]
+}
