+func TestLocalCompactHeartbeatFlushFailure(t *testing.T) {
+	fresh(t)
+	localCompactClock(t)
+	gone := make(chan struct{}, 4)
+	f := responseVendor(t, "wait", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
