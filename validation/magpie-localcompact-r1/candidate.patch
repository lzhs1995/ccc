+	fresh(t)
+	h := &keyGone{
+		n:      map[string]int{},
+		status: map[string]int{"k-a": 403},
+		body:   map[string]string{"k-a": `{"error":{"message":"API Key 所属分组已删除"}}`},
+	}
+	saveKeyGone(t, h)
+	restThree(t)
+	s := New()
+	code, body := postAs(t, s, "", keyGoneReq)
+	if code != 200 || !strings.Contains(body, "ok-k-b") {
+		t.Fatalf("%d %s", code, body)
+	}
+	if h.got("k-a") != 1 || h.got("k-b") != 1 || h.got("k-s") != 0 {
+		t.Fatalf("asked a=%d b=%d s=%d", h.got("k-a"), h.got("k-b"), h.got("k-s"))
+	}
+	if _, ok := restOf("plan#" + provider.KeyID("k-a")); !ok {
+		t.Fatal("the dead key did not rest")
+	}
+}
+
+// Every key is dead the same way. The agent is told 503, and the body no
+// longer repeats the two sentences Claude Code pauses on. Each key was
+// asked once. The tries keep the upstream sentences.
+func TestDeadRelayKeyEndsAs503(t *testing.T) {
+	fresh(t)
+	h := &keyGone{
+		n:      map[string]int{},
+		status: map[string]int{"k-a": 403, "k-b": 403, "k-s": 401},
+		body: map[string]string{
+			"k-a": `{"error":{"message":"API Key 所属分组已删除"}}`,
+			"k-b": `{"error":{"message":"API Key 所属分组已删除"}}`,
+			"k-s": `{"error":{"message":"API key is disabled"}}`,
+		},
+	}
+	saveKeyGone(t, h)
+	restThree(t)
+	s := New()
+	code, body := postAs(t, s, "", keyGoneReq)
+	if code != http.StatusServiceUnavailable || !strings.Contains(body, deadKeySaid) {
+		t.Fatalf("%d %s", code, body)
+	}
+	lower := strings.ToLower(body)
+	if strings.Contains(body, "分组已删除") || strings.Contains(lower, "api key is disabled") ||
+		strings.Contains(body, `"type":"authentication_error"`) || strings.Contains(body, `"type":"permission_error"`) {
+		t.Fatalf("client still sees the pause sentence: %s", body)
+	}
+	if h.got("k-a") != 1 || h.got("k-b") != 1 || h.got("k-s") != 1 {
+		t.Fatalf("asked a=%d b=%d s=%d", h.got("k-a"), h.got("k-b"), h.got("k-s"))
+	}
+	for _, id := range []string{"plan#" + provider.KeyID("k-a"), "plan#" + provider.KeyID("k-b"), "spare"} {
+		if _, ok := restOf(id); !ok {
+			t.Fatalf("%s did not rest", id)
+		}
+	}
+	r := s.trace.routes[len(s.trace.routes)-1]
+	if r.Status != http.StatusServiceUnavailable || r.Error != deadKeySaid || len(r.Tries) != 3 {
+		t.Fatalf("route status %d error %q tries %d", r.Status, r.Error, len(r.Tries))
+	}
+	sawGone, sawDisabled := false, false
+	for _, try := range r.Tries {
+		if strings.Contains(try.Error, "分组已删除") {
+			sawGone = true
+		}
+		if strings.Contains(strings.ToLower(try.Error), "api key is disabled") {
+			sawDisabled = true
+		}
+	}
+	if !sawGone || !sawDisabled {
+		t.Fatal("tries lost the upstream sentence")
+	}
+}
+
+// A plain 403, and a 502, still leave the other resting members unasked.
+// A 502 is passing(), so the soonest key is tried again on its own
+// (lastRetries) before the status is released. That is not a wake.
+func TestOtherFailuresDoNotWakeRestingMates(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		body   string
+	}{
+		{"plain 403", 403, `{"error":{"message":"Forbidden"}}`},
+		{"502", 502, `{"error":{"message":"bad gateway"}}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fresh(t)
+			h := &keyGone{
+				n:      map[string]int{},
+				status: map[string]int{"k-a": tc.status},
+				body:   map[string]string{"k-a": tc.body},
+			}
+			saveKeyGone(t, h)
+			restThree(t)
+			code, body := postAs(t, New(), "", keyGoneReq)
+			if code != tc.status {
+				t.Fatalf("%d %s", code, body)
+			}
+			wantA := 1
+			if tc.status == http.StatusBadGateway {
+				wantA = 1 + lastRetries
+			}
+			if h.got("k-a") != wantA || h.got("k-b") != 0 || h.got("k-s") != 0 {
+				t.Fatalf("asked a=%d b=%d s=%d, want a=%d", h.got("k-a"), h.got("k-b"), h.got("k-s"), wantA)
+			}
+		})
+	}
+}
diff --git a/internal/gateway/local_compact_heartbeat.go b/internal/gateway/local_compact_heartbeat.go
new file mode 100644
--- /dev/null
+++ b/internal/gateway/local_compact_heartbeat.go
@@ -0,0 +1,130 @@
+package gateway
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// The marker binds only the private recorder created by codexCompact. It
+// survives capture/masking writers without relying on their Unwrap methods.
+// Other recorders and real agent responses keep their existing behavior.
+type localCompactRecorderKey struct{}
+
+func localCompactRecorderIn(ctx context.Context, w http.ResponseWriter) bool {
+	if ctx == nil {
+		return false
+	}
+	rec, ok := ctx.Value(localCompactRecorderKey{}).(*recorder)
+	return ok && rec != nil && w == rec
+}
+
+type localCompactHeartbeat struct {
+	w      http.ResponseWriter
+	ctx    context.Context
+	cancel context.CancelFunc
+	kept   *keptAlive
+	stop   func()
+	once   sync.Once
+}
+
+func startLocalCompactHeartbeat(w http.ResponseWriter, r *http.Request, body []byte) (*http.Request, *localCompactHeartbeat) {
+	if !streamOf(body) || !(fromCodex(r.Header) || agentOf(r) == "codex") {
+		return r, nil
+	}
+	ctx, cancel := context.WithCancel(r.Context())
+	now := time.Now()
+	c := &localCompactHeartbeat{w: w, ctx: ctx, cancel: cancel,
+		kept: &keptAlive{proto: provider.Responses, streams: true, codexPing: true, told: now, at: now}}
+	h := newHoldWriter(&compactHeartbeatWriter{ResponseWriter: w, cancel: cancel}, true)
+	h.ctx, h.alive, h.streams = ctx, c.kept, true
+	h.note("Cache-Control", "no-cache")
+	h.note("X-Accel-Buffering", "no")
+	// This waits for the summary as a whole. The inner response observer
+	// owns supplier idle/total budgets; no fake heard or first token here.
+	c.stop = h.keepQueued()
+	return r.WithContext(ctx), c
+}
+
+// finish serializes every final response with the last possible ping.
+// Cancellation suppresses output, while an actual response-budget timeout
+// can still be reported as the existing typed failure.
+func (c *localCompactHeartbeat) finish() bool {
+	if c == nil {
+		return true
+	}
+	c.once.Do(c.stop)
+	return c.ctx.Err() == nil || responseWaitExpired(c.ctx) != nil && !responseCallerCanceled(c.ctx)
+}
+
+func (c *localCompactHeartbeat) close() {
+	if c != nil {
+		c.finish()
+		c.cancel()
+	}
+}
+
+// failure returns true when the old JSON output must not be written:
+// either the caller went away, or its already-open stream got one complete
+// response.failed. A fast failure keeps its original HTTP status and body.
+func (c *localCompactHeartbeat) failure(status int, message string, said []byte) bool {
+	if c == nil {
+		return false
+	}
+	if !c.finish() {
+		return true
+	}
+	if !c.kept.sent {
+		return false
+	}
+	if len(said) == 0 {
+		rec := &recorder{header: http.Header{}, status: status}
+		writeError(rec, provider.Responses, status, message)
+		said = rec.body.Bytes()
+	}
+	sw := newSSEWriter(c.w)
+	sw.begun = true
+	failed := map[string]any{"code": "server_error", "message": saysPassing(status, message)}
+	var original struct {
+		Error map[string]json.RawMessage `json:"error"`
+	}
+	if json.Unmarshal(said, &original) == nil {
+		// Preserve explicit nulls, numeric codes and empty strings too;
+		// saidError intentionally keeps only nonempty string metadata.
+		for _, key := range []string{"code", "type", "param"} {
+			if value, exists := original.Error[key]; exists {
+				failed[key] = value
+			}
+		}
+	}
+	enc := &responsesEncoder{w: sw}
+	enc.write("response.failed", map[string]any{"response": enc.response("failed", map[string]any{"error": failed})})
+	return true
+}
+
+type compactHeartbeatWriter struct {
+	http.ResponseWriter
+	cancel context.CancelFunc
+}
+
+func (w *compactHeartbeatWriter) Write(b []byte) (int, error) {
+	n, err := w.ResponseWriter.Write(b)
+	if err != nil || n != len(b) {
+		w.cancel()
+		if err == nil {
+			err = io.ErrShortWrite
+		}
+	}
+	return n, err
+}
+
+func (w *compactHeartbeatWriter) Flush() {
+	if err := http.NewResponseController(w.ResponseWriter).Flush(); err != nil {
+		w.cancel()
+	}
+}
diff --git a/internal/gateway/local_compact_heartbeat_test.go b/internal/gateway/local_compact_heartbeat_test.go
new file mode 100644
--- /dev/null
+++ b/internal/gateway/local_compact_heartbeat_test.go
@@ -0,0 +1,704 @@
+package gateway
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// These tests run the real Handler and a loopback supplier. Only timing
+// constants are scaled; neither the response observer nor routing is mocked.
+func localCompactClock(t *testing.T) {
+	t.Helper()
+	oldHeld, oldEvery, oldWatch := keepHeldAfter, keepaliveEvery, watchEvery
+	keepHeldAfter, keepaliveEvery, watchEvery = 30*time.Millisecond, 30*time.Millisecond, 5*time.Millisecond
+	t.Cleanup(func() { keepHeldAfter, keepaliveEvery, watchEvery = oldHeld, oldEvery, oldWatch })
+}
+
+type localCompactProbe struct {
+	*httptest.ResponseRecorder
+	ping  chan struct{}
+	mode  string
+	count atomic.Int32
+	// A fault can be armed by the actual fake supplier accepting the
+	// request. Before that, keep sending valid pings without blocking.
+	faultReady <-chan struct{}
+	faulted    chan struct{}
+}
+
+func localCompactOutput() *localCompactProbe {
+	return &localCompactProbe{ResponseRecorder: httptest.NewRecorder(), ping: make(chan struct{}, 64)}
+}
+
+func (w *localCompactProbe) Write(b []byte) (int, error) {
+	w.count.Add(1)
+	if bytes.Contains(b, []byte("event: ping\n")) {
+		select {
+		case w.ping <- struct{}{}:
+		default:
+		}
+		armed := true
+		if w.faultReady != nil {
+			select {
+			case <-w.faultReady:
+			default:
+				armed = false
+			}
+		}
+		if armed && (w.mode == "short" || w.mode == "error") && w.faulted != nil {
+			select {
+			case w.faulted <- struct{}{}:
+			default:
+			}
+		}
+		if armed && w.mode == "short" {
+			return 0, nil
+		}
+		if armed && w.mode == "error" {
+			return 0, io.ErrClosedPipe
+		}
+	}
+	return w.ResponseRecorder.Write(b)
+}
+
+func localCompactPing(t *testing.T, p *localCompactProbe) {
+	t.Helper()
+	select {
+	case <-p.ping:
+	case <-time.After(2 * time.Second):
+		t.Fatal("real client received no complete ping")
+	}
+}
+
+func localCompactRequest(ctx context.Context, compact bool) *http.Request {
+	r := httptest.NewRequest("POST", "/v1/responses", strings.NewReader(responseRequest("wait/m", true, compact))).WithContext(ctx)
+	r.Header.Set("Content-Type", "application/json")
+	r.Header.Set("User-Agent", "codex_cli_rs/0.164.0")
+	return r
+}
+
+func localCompactRun(s *Server, w http.ResponseWriter, r *http.Request) <-chan struct{} {
+	done := make(chan struct{})
+	go func() { defer close(done); s.Handler().ServeHTTP(w, r) }()
+	return done
+}
+
+func localCompactDone(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("handler failed to return")
+	}
+}
+
+func localCompactEvents(t *testing.T, wire string) []map[string]json.RawMessage {
+	t.Helper()
+	if !strings.HasSuffix(wire, "\n\n") {
+		t.Fatalf("incomplete SSE frame: %q", wire)
+	}
+	var result []map[string]json.RawMessage
+	for _, block := range strings.Split(strings.TrimSuffix(wire, "\n\n"), "\n\n") {
+		var name, data string
+		for _, line := range strings.Split(block, "\n") {
+			if strings.HasPrefix(line, "event: ") {
+				name = strings.TrimPrefix(line, "event: ")
+			}
+			if strings.HasPrefix(line, "data: ") {
+				data = strings.TrimPrefix(line, "data: ")
+			}
+		}
+		var e map[string]json.RawMessage
+		if err := json.Unmarshal([]byte(data), &e); err != nil {
+			t.Fatalf("invalid event %q: %v", block, err)
+		}
+		var kind string
+		if err := json.Unmarshal(e["type"], &kind); err != nil || kind != name {
+			t.Fatalf("SSE name/type mismatch: %q", block)
+		}
+		result = append(result, e)
+	}
+	return result
+}
+
+func localCompactTerminal(t *testing.T, wire, want string) map[string]json.RawMessage {
+	t.Helper()
+	var terminal map[string]json.RawMessage
+	count := 0
+	for _, e := range localCompactEvents(t, wire) {
+		var kind string
+		json.Unmarshal(e["type"], &kind)
+		if kind == "response.failed" || kind == "response.completed" || kind == "response.incomplete" {
+			count++
+			if kind != want {
+				t.Errorf("terminal %s, want %s", kind, want)
+			}
+			terminal = e
+		}
+	}
+	if count != 1 {
+		t.Fatalf("terminal count %d: %s", count, wire)
+	}
+	if strings.Contains(wire, "PARTIAL_SUMMARY") {
+		t.Fatal("partial summary leaked")
+	}
+	return terminal
+}
+
+func TestLocalCompactHeartbeatFast(t *testing.T) {
+	for _, status := range []int{200, 401, 403} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			fresh(t)
+			// A completed request before the normal 15s cadence must retain
+			// the original HTTP status and JSON, with no synthetic SSE.
+			errorBody := `{"error":{"message":"fixture denied","type":"permission_error","code":"NO_BALANCE","param":"model"}}`
+			f := responseVendor(t, "wait", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
+				if status == 200 {
+					w.Header().Set("Content-Type", "text/event-stream")
+					io.WriteString(w, wholeSummary(provider.Responses))
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(status)
+				io.WriteString(w, errorBody)
+			})
+			baseline := localCompactOutput()
+			baselineRequest := localCompactRequest(context.Background(), true)
+			baselineRequest.Header.Set("User-Agent", "ordinary-client")
+			New().Handler().ServeHTTP(baseline, baselineRequest)
+			noRests() // the auth response may have rested this synthetic key
+			out := localCompactOutput()
+			New().Handler().ServeHTTP(out, localCompactRequest(context.Background(), true))
+			if out.Code != status || baseline.Code != status || len(out.ping) != 0 || len(baseline.ping) != 0 || f.calls.Load() != 2 {
+				t.Fatalf("code=%d pings=%d calls=%d", out.Code, len(out.ping), f.calls.Load())
+			}
+			if status == 200 {
+				localCompactTerminal(t, out.Body.String(), "response.completed")
+				if compactedText(t, out.Body.String()) != "SUMMARY" {
+					t.Fatal("summary changed")
+				}
+			} else if out.Body.String() != baseline.Body.String() {
+				t.Fatalf("fast JSON changed vs no outer baseline: got=%s baseline=%s", out.Body, baseline.Body)
+			}
+		})
+	}
+}
+
+func TestLocalCompactHeartbeatSlow(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		meta   string
+	}{
+		{"success", 200, ""},
+		{"late403", 403, `"type":"permission_error","code":"INSUFFICIENT_BALANCE","param":"model"`},
+		{"late403-null", 403, `"type":"permission_error","code":"INSUFFICIENT_BALANCE","param":null`},
+		{"late403-numeric", 403, `"type":"","code":403,"param":""`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fresh(t)
+			localCompactClock(t)
+			release := make(chan struct{})
+			baselinePhase := atomic.Bool{}
+			baselinePhase.Store(true)
+			var once sync.Once
+			unblock := func() { once.Do(func() { close(release) }) }
+			f := responseVendor(t, "wait", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
+				if !baselinePhase.Load() {
+					select {
+					case <-release:
+					case <-r.Context().Done():
+						return
+					}
+				}
+				if tc.status == 200 {
+					w.Header().Set("Content-Type", "text/event-stream")
+					io.WriteString(w, wholeSummary(provider.Responses))
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(tc.status)
+				io.WriteString(w, `{"error":{"message":"fixture denied",`+tc.meta+`}}`)
+			})
+			t.Cleanup(unblock)
+			baseline := localCompactOutput()
+			baselineRequest := localCompactRequest(context.Background(), true)
+			baselineRequest.Header.Set("User-Agent", "ordinary-client")
+			New().Handler().ServeHTTP(baseline, baselineRequest)
+			if baseline.Code != tc.status || len(baseline.ping) != 0 {
+				t.Fatalf("no outer baseline status=%d pings=%d", baseline.Code, len(baseline.ping))
+			}
+			baselinePhase.Store(false)
+			noRests()
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			out := localCompactOutput()
+			done := localCompactRun(New(), out, localCompactRequest(ctx, true))
+			localCompactPing(t, out)
+			localCompactPing(t, out)
+			unblock()
+			localCompactDone(t, done)
+			if out.Code != 200 || f.calls.Load() != 2 {
+				t.Fatalf("code=%d calls=%d", out.Code, f.calls.Load())
+			}
+			if tc.status == 200 {
+				localCompactTerminal(t, out.Body.String(), "response.completed")
+				if compactedText(t, out.Body.String()) != "SUMMARY" {
+					t.Fatal("summary changed")
+				}
+				return
+			}
+			e := localCompactTerminal(t, out.Body.String(), "response.failed")
+			var response struct {
+				Error map[string]json.RawMessage `json:"error"`
+			}
+			json.Unmarshal(e["response"], &response)
+			var normalized struct {
+				Error map[string]json.RawMessage `json:"error"`
+			}
+			if err := json.Unmarshal(baseline.Body.Bytes(), &normalized); err != nil {
+				t.Fatal(err)
+			}
+			for _, k := range []string{"code", "type", "param"} {
+				v := normalized.Error[k]
+				if !bytes.Equal(response.Error[k], v) {
+					t.Errorf("%s lost: got %s want %s", k, response.Error[k], v)
+				}
+			}
+			before := out.count.Load()
+			time.Sleep(2 * keepaliveEvery)
+			if out.count.Load() != before {
+				t.Fatal("ping after terminal")
+			}
+		})
+	}
+}
+
+func TestLocalCompactHeartbeatBudget(t *testing.T) {
+	for _, semantic := range []bool{false, true} {
+		name := "response_idle"
+		if semantic {
+			name = "response_total"
+		}
+		t.Run(name, func(t *testing.T) {
+			fresh(t)
+			localCompactClock(t)
+			gone := make(chan struct{}, 4)
+			f := responseVendor(t, "wait", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
+				defer func() { gone <- struct{}{} }()
+				w.Header().Set("Content-Type", "text/event-stream")
+				w.WriteHeader(200)
+				w.(http.Flusher).Flush()
+				ticker := time.NewTicker(20 * time.Millisecond)
+				defer ticker.Stop()
+				for {
+					select {
+					case <-r.Context().Done():
+						return
+					case <-ticker.C:
+						if semantic {
+							io.WriteString(w, "data: {\"type\":\"response.output_text.delta\",\"delta\":\"PARTIAL_SUMMARY\"}\n\n")
+						} else {
+							io.WriteString(w, ": still waiting\n\n")
+						}
+						w.(http.Flusher).Flush()
+					}
+				}
+			})
+			parent, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			b := &responseBudget{parent: parent, idle: 150 * time.Millisecond, total: 300 * time.Millisecond, until: time.Now().Add(300 * time.Millisecond)}
+			ctx, stop := context.WithDeadlineCause(parent, b.until, &responseTimeout{"response_total", b.total})
+			defer stop()
+			ctx = context.WithValue(ctx, responseBudgetKey{}, b)
+			out := localCompactOutput()
+			localCompactDone(t, localCompactRun(New(), out, localCompactRequest(ctx, true)))
+			if len(out.ping) == 0 || f.calls.Load() != 1 {
+				t.Fatalf("pings=%d calls=%d", len(out.ping), f.calls.Load())
+			}
+			localCompactTerminal(t, out.Body.String(), "response.failed")
+			if !strings.Contains(out.Body.String(), name) {
+				t.Fatalf("budget lost: %s", out.Body)
+			}
+			select {
+			case <-gone:
+			case <-time.After(time.Second):
+				t.Fatal("upstream budget failed to cancel")
+			}
+			if parent.Err() != nil {
+				t.Fatal("ended by caller safety timeout instead of original budget")
+			}
+		})
+	}
+}
+
+func TestLocalCompactHeartbeatCancelAndWriteFailure(t *testing.T) {
+	for _, mode := range []string{"caller", "short", "error"} {
+		t.Run(mode, func(t *testing.T) {
+			fresh(t)
+			localCompactClock(t)
+			gone := make(chan struct{}, 4)
+			ready := make(chan struct{}, 4)
+			armed := make(chan struct{})
+			var armOnce sync.Once
+			f := responseVendor(t, "wait", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
+				w.Header().Set("Content-Type", "text/event-stream")
+				w.WriteHeader(200)
+				w.(http.Flusher).Flush()
+				ready <- struct{}{}
+				armOnce.Do(func() { close(armed) })
+				<-r.Context().Done()
+				gone <- struct{}{}
+			})
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			out := localCompactOutput()
+			out.mode = mode
+			out.faultReady, out.faulted = armed, make(chan struct{}, 1)
+			done := localCompactRun(New(), out, localCompactRequest(ctx, true))
+			select {
+			case <-ready:
+			case <-time.After(time.Second):
+				t.Fatalf("supplier never accepted request: calls=%d", f.calls.Load())
+			}
+			localCompactPing(t, out)
+			if mode == "caller" {
+				cancel()
+			} else {
+				select {
+				case <-out.faulted:
+				case <-time.After(time.Second):
+					t.Fatal("armed write fault never occurred")
+				}
+			}
+			localCompactDone(t, done)
+			select {
+			case <-gone:
+			case <-time.After(time.Second):
+				t.Fatalf("accepted upstream still alive after cancellation: calls=%d", f.calls.Load())
+			}
+			if f.calls.Load() != 1 {
+				t.Fatalf("expected exactly one accepted supplier call, got %d", f.calls.Load())
+			}
+			if strings.Contains(out.Body.String(), "response.") {
+				t.Fatalf("final output after cancellation: %s", out.Body)
+			}
+			count := out.count.Load()
+			time.Sleep(2 * keepaliveEvery)
+			if out.count.Load() != count {
+				t.Fatal("writer active after stop/join")
+			}
+		})
+	}
+}
