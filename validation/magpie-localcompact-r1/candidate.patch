new file mode 100644
--- /dev/null
+++ b/internal/agent/portable_entries_test.go
@@ -0,0 +1,73 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/sessions"
+)
+
+func TestPeriodicQuitAndDisconnectEntrySharePause(t *testing.T) {
+	home := t.TempDir()
+	config := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("XDG_CONFIG_HOME", config)
+	if err := os.MkdirAll(filepath.Join(home, ".codex", "thread-writer-locks"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	handler := sessions.CodexPortableHandler()
+	read := func() sessions.CodexPortableStatus {
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, httptest.NewRequest("GET", "/api/codex-portable", nil))
+		var s sessions.CodexPortableStatus
+		if err := json.Unmarshal(w.Body.Bytes(), &s); err != nil {
+			t.Fatal(err)
+		}
+		return s
+	}
+	s := read()
+	b, _ := json.Marshal(map[string]any{"action": "pause", "instance": s.Instance, "generation": s.Generation})
+	w := httptest.NewRecorder()
+	handler.ServeHTTP(w, httptest.NewRequest("POST", "/api/codex-portable", strings.NewReader(string(b))))
+	if w.Code != 200 {
+		t.Fatal(w.Code, w.Body.String())
+	}
+	every, after := codexPortEvery, codexPortAfter
+	codexPortEvery = time.Millisecond
+	codexPortAfter = time.Millisecond
+	defer func() { codexPortEvery = every; codexPortAfter = after }()
+	ctx, cancel := context.WithCancel(context.Background())
+	stopped := make(chan struct{})
+	go func() { defer close(stopped); KeepCodexRolloutsPortable(ctx) }()
+	deadline := time.NewTimer(5 * time.Second)
+	defer deadline.Stop()
+	tick := time.NewTicker(time.Millisecond)
+	defer tick.Stop()
+	for read().PausedPasses < 2 {
+		select {
+		case <-deadline.C:
+			cancel()
+			<-stopped
+			t.Fatal("periodic entry bypassed pause")
+		case <-tick.C:
+		}
+	}
+	cancel()
+	<-stopped
+	before := read().PausedPasses
+	PortCodexRollouts(time.Second)                            // exact shutdown entry
+	portCodexHome(filepath.Join(home, ".codex"), time.Second) // exact function called by Disconnect
+	s = read()
+	if s.PausedPasses != before+2 || s.ActivePass != 0 || s.ActiveFile != 0 || !s.Drained {
+		t.Fatalf("entry bypass %+v", s)
+	}
+	if _, err := os.Stat(filepath.Join(config, "magpie", "codex-portable.json")); !os.IsNotExist(err) {
+		t.Fatalf("paused state mutated: %v", err)
+	}
+}
