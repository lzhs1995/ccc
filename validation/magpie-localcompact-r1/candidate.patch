+// This body will not return EOF until its owner closes it. The observer
+// must finish on the protocol terminator and release the actual reader.
+type responseOpenBody struct {
+	r      *strings.Reader
+	closed chan struct{}
+	once   sync.Once
+	chunk  int
+}
+
+func (b *responseOpenBody) Read(p []byte) (int, error) {
+	if b.r.Len() > 0 {
+		if b.chunk > 0 && len(p) > b.chunk {
+			p = p[:b.chunk]
+		}
+		return b.r.Read(p)
+	}
+	<-b.closed
+	return 0, io.ErrClosedPipe
+}
+func (b *responseOpenBody) Close() error { b.once.Do(func() { close(b.closed) }); return nil }
+func responseUnit(t *testing.T, proto provider.Protocol, body io.ReadCloser, ct string, idle, total time.Duration) (*responseReader, *responseAttempt, context.Context) {
+	t.Helper()
+	parent := context.Background()
+	b := &responseBudget{parent: parent, idle: idle, total: total, until: time.Now().Add(total)}
+	ctx, stop := context.WithDeadlineCause(parent, b.until, &responseTimeout{"response_total", total})
+	t.Cleanup(stop)
+	ctx = context.WithValue(ctx, responseBudgetKey{}, b)
+	ctx, a, done := responseAttempting(ctx)
+	t.Cleanup(done)
+	res := &http.Response{Header: http.Header{"Content-Type": []string{ct}}, Body: body}
+	responseObserved(ctx, res, proto)
+	t.Cleanup(func() { res.Body.Close() })
+	return res.Body.(*responseReader), a, ctx
+}
