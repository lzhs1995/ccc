new file mode 100644
--- /dev/null
+++ b/internal/gateway/quietcut_test.go
@@ -0,0 +1,111 @@
+package gateway
+
+import (
+	"bufio"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// silentThen is a vendor that says nothing at all — no status, no
+// headers — for wait, then answers (a relay whose 429 takes 60–120s).
+type silentThen struct {
+	wait   time.Duration
+	answer func(w http.ResponseWriter)
+	gone   atomic.Int32 // requests whose caller hung up before wait
+}
+
+func (s *silentThen) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	io.ReadAll(r.Body)
+	if !strings.HasSuffix(r.URL.Path, "/responses") {
+		http.NotFound(w, r)
+		return
+	}
+	select {
+	case <-time.After(s.wait):
+	case <-r.Context().Done():
+		s.gone.Add(1)
+		return
+	}
+	s.answer(w)
+}
+
+const quietCutAsk = `{"model":"q/m","stream":true,"input":[{"role":"user","content":[{"type":"input_text","text":"hi"}]}]}`
+
+func readStream(t *testing.T, url string) (string, time.Duration, int) {
+	t.Helper()
+	start := time.Now()
+	res, err := http.Post(url+"/v1/responses", "application/json", strings.NewReader(quietCutAsk))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	b, _ := io.ReadAll(bufio.NewReader(res.Body))
+	return string(b), time.Since(start), res.StatusCode
+}
+
+// A vendor silent past Codex's idle timeout: Codex hears a failure by
+// agentQuietMost, and the vendor's request is ended, rather than Codex
+// waiting with no event until it reconnects on "idle timeout waiting for
+// SSE". Without hw.quietCut the reply comes only once the vendor answers.
+func TestCodexToldBeforeItsIdleTimeoutWhenVendorIsSilent(t *testing.T) {
+	k, w, q := keepHeldAfter, watchEvery, agentQuietMost
+	keepHeldAfter, watchEvery, agentQuietMost = 50*time.Millisecond, 10*time.Millisecond, 1500*time.Millisecond
+	t.Cleanup(func() { keepHeldAfter, watchEvery, agentQuietMost = k, w, q })
+	fresh(t)
+	up := &silentThen{wait: 5 * time.Second, answer: func(w http.ResponseWriter) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, sse(`event: response.completed`+"\n"+`data: {"type":"response.completed","response":{"id":"r1","status":"completed","output":[]}}`))
+	}}
+	srv := httptest.NewServer(up)
+	t.Cleanup(srv.Close)
+	if err := provider.Save(provider.Provider{ID: "q", Name: "Q", Key: "k", Models: []string{"m"}, Responses: srv.URL + "/v1"}); err != nil {
+		t.Fatal(err)
+	}
+	gw := httptest.NewServer(New().Handler())
+	t.Cleanup(gw.Close)
+	got, took, status := readStream(t, gw.URL)
+	if took > 3500*time.Millisecond {
+		t.Fatalf("Codex heard its answer after %s, past its idle timeout (%s): %d %s", took, agentQuietMost, status, got)
+	}
+	if status < 400 && !strings.Contains(got, "response.failed") && !strings.Contains(got, `"type":"error"`) {
+		t.Fatalf("Codex was not told a failure: %d %s", status, got)
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for up.gone.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(20 * time.Millisecond)
+	}
+	if up.gone.Load() == 0 {
+		t.Fatal("the vendor's request was left open")
+	}
+}
+
+// A vendor that answers within the idle timeout is let through as before.
+func TestCodexQuietCutLeavesATimelyReplyAlone(t *testing.T) {
+	k, w, q := keepHeldAfter, watchEvery, agentQuietMost
+	keepHeldAfter, watchEvery, agentQuietMost = 50*time.Millisecond, 10*time.Millisecond, 1500*time.Millisecond
+	t.Cleanup(func() { keepHeldAfter, watchEvery, agentQuietMost = k, w, q })
+	fresh(t)
+	up := &silentThen{wait: 700 * time.Millisecond, answer: func(w http.ResponseWriter) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, sse(`event: response.output_text.delta`+"\n"+`data: {"type":"response.output_text.delta","delta":"hello"}`,
+			`event: response.completed`+"\n"+`data: {"type":"response.completed","response":{"id":"r1","status":"completed","output":[]}}`))
+	}}
+	srv := httptest.NewServer(up)
+	t.Cleanup(srv.Close)
+	if err := provider.Save(provider.Provider{ID: "q", Name: "Q", Key: "k", Models: []string{"m"}, Responses: srv.URL + "/v1"}); err != nil {
+		t.Fatal(err)
+	}
+	gw := httptest.NewServer(New().Handler())
+	t.Cleanup(gw.Close)
+	got, _, status := readStream(t, gw.URL)
+	if status != 200 || !strings.Contains(got, "hello") || strings.Contains(got, "response.failed") {
+		t.Fatalf("a timely reply was changed: %d %s", status, got)
+	}
+}
diff --git a/internal/gateway/response_wait.go b/internal/gateway/response_wait.go
new file mode 100644
--- /dev/null
+++ b/internal/gateway/response_wait.go
@@ -0,0 +1,404 @@
+package gateway
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// A responseTimeout is magpie's own limit, never the vendor's HTTP 504
+// or the caller leaving. It is carried as a context cause, not inferred
+// from the vendor's words.
+type responseTimeout struct {
+	kind  string
+	after time.Duration
+}
+
+func (e *responseTimeout) Error() string {
+	return fmt.Sprintf("%s: response did not finish within %s", e.kind, e.after)
+}
+
+type responseBudgetKey struct{}
+type responseAttemptKey struct{}
+
+type responseBudget struct {
+	parent      context.Context
+	idle        time.Duration
+	total       time.Duration
+	until       time.Time
+	mu          sync.Mutex
+	lastFailure *responseTimeout
+}
+
+// responseWaiting is established before queues and candidates. A local
+// compaction establishes it around both asks, which serve then inherits.
+func responseWaiting(r *http.Request) (*http.Request, *responseBudget, context.CancelFunc, error) {
+	if b, ok := r.Context().Value(responseBudgetKey{}).(*responseBudget); ok {
+		return r, b, func() {}, nil
+	}
+	s, err := settings.LoadChecked()
+	if err != nil {
+		return r, nil, nil, err
+	}
+	idle, total, err := s.ResponseWait()
+	if err != nil {
+		return r, nil, nil, err
+	}
+	b := &responseBudget{parent: r.Context(), idle: idle, total: total, until: time.Now().Add(total)}
+	ctx, stop := context.WithDeadlineCause(r.Context(), b.until, &responseTimeout{"response_total", total})
+	ctx = context.WithValue(ctx, responseBudgetKey{}, b)
+	return r.WithContext(ctx), b, stop, nil
+}
+
+func (b *responseBudget) failed(e *responseTimeout) {
+	b.mu.Lock()
+	b.lastFailure = e
+	b.mu.Unlock()
+}
+
+func (b *responseBudget) failure() *responseTimeout {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.lastFailure
+}
+
+func responseWaitExpired(ctx context.Context) *responseTimeout {
+	var e *responseTimeout
+	if errors.As(context.Cause(ctx), &e) {
+		return e
+	}
+	return nil
+}
+
+func responseCallerCanceled(ctx context.Context) bool {
+	if b, ok := ctx.Value(responseBudgetKey{}).(*responseBudget); ok {
+		return b.parent.Err() != nil
+	}
+	return ctx.Err() != nil
+}
+
+type responseAttempt struct {
+	ctx       context.Context
+	cancel    context.CancelCauseFunc
+	budget    *responseBudget
+	mu        sync.Mutex
+	timer     *time.Timer
+	due       time.Time
+	completed time.Time
+	reader    *responseReader
+	fault     *responseTimeout
+}
+
+func responseAttempting(ctx context.Context) (context.Context, *responseAttempt, context.CancelFunc) {
+	ctx, cancel := context.WithCancelCause(ctx)
+	b, _ := ctx.Value(responseBudgetKey{}).(*responseBudget)
+	a := &responseAttempt{cancel: cancel, budget: b}
+	ctx = context.WithValue(ctx, responseAttemptKey{}, a)
+	a.ctx = ctx
+	return ctx, a, func() {
+		a.mu.Lock()
+		if a.timer != nil {
+			a.timer.Stop()
+		}
+		a.mu.Unlock()
+		cancel(context.Canceled)
+	}
+}
+
+// failure is read before cancellation used for cleanup. A complete wire
+// reply observed before the total deadline remains complete if that
+// deadline fires while its already-read bytes are processed.
+func (a *responseAttempt) failure() *responseTimeout {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.fault != nil {
+		return a.fault
+	}
+	if a.budget != nil && !a.completed.IsZero() && a.completed.Before(a.budget.until) {
+		return nil
+	}
+	return responseWaitExpired(a.ctx)
+}
+
+func responseAttemptFailure(ctx context.Context) *responseTimeout {
+	if a, ok := ctx.Value(responseAttemptKey{}).(*responseAttempt); ok {
+		return a.failure()
+	}
+	return responseWaitExpired(ctx)
+}
+
+func (a *responseAttempt) expire() {
+	a.mu.Lock()
+	if a.reader == nil || a.fault != nil || !a.completed.IsZero() || a.ctx.Err() != nil {
+		a.mu.Unlock()
+		return
+	}
+	now := time.Now()
+	e := &responseTimeout{"response_idle", a.budget.idle}
+	if !now.Before(a.budget.until) {
+		e = &responseTimeout{"response_total", a.budget.total}
+	} else if left := a.due.Sub(now); left > 0 {
+		a.timer.Reset(left)
+		a.mu.Unlock()
+		return
+	}
+	a.fault = e
+	a.mu.Unlock()
+	a.cancel(e)
+}
+
+// progress uses the actual observation time, not the timer goroutine's
+// scheduling. Bytes delivered after a deadline cannot revive the attempt.
+func (a *responseAttempt) progress(r *responseReader, complete bool) {
+	a.mu.Lock()
+	if a.reader != r || a.fault != nil || !a.completed.IsZero() {
+		a.mu.Unlock()
+		return
+	}
+	now := time.Now()
+	var expired *responseTimeout
+	switch {
+	case a.budget.parent.Err() != nil:
+	case !now.Before(a.budget.until):
+		expired = &responseTimeout{"response_total", a.budget.total}
+	case !now.Before(a.due):
+		expired = &responseTimeout{"response_idle", a.budget.idle}
+	case a.ctx.Err() == nil:
+		if complete {
+			a.completed = now
+			if a.timer != nil {
+				a.timer.Stop()
+			}
+		} else {
+			a.due = now.Add(a.budget.idle)
+			if a.timer != nil {
+				a.timer.Reset(a.budget.idle)
+			}
+		}
+	}
+	if expired != nil {
+		a.fault = expired
+	}
+	a.mu.Unlock()
+	if expired != nil {
+		a.cancel(expired)
+	}
+}
+
+// A protocol/auth retry can complete one error body and start another
+// request on the same attempt. Its header wait has no completed reply yet.
+func responseStarting(ctx context.Context) {
+	if a, ok := ctx.Value(responseAttemptKey{}).(*responseAttempt); ok {
+		a.mu.Lock()
+		a.completed = time.Time{}
+		if a.timer != nil {
+			a.timer.Stop()
+		}
+		a.mu.Unlock()
+	}
+}
+
+// responseObserved wraps the body before a caller sniffs, translates or
+// buffers it. The observer neither consumes extra bytes nor rewrites SSE.
+func responseObserved(ctx context.Context, res *http.Response, proto provider.Protocol) {
+	a, ok := ctx.Value(responseAttemptKey{}).(*responseAttempt)
+	if !ok || a.budget == nil || res == nil || res.Body == nil {
+		return
+	}
+	ct := res.Header.Get("Content-Type")
+	r := &responseReader{body: res.Body, attempt: a, proto: proto}
+	switch {
+	case strings.HasPrefix(ct, "text/event-stream"):
+		r.mode = "sse"
+	case ct != "" && !strings.HasPrefix(ct, "text/plain"):
+		r.mode = "json"
+	}
+	a.mu.Lock()
+	a.reader, a.completed = r, time.Time{}
+	a.due = time.Now().Add(a.budget.idle)
+	if a.timer != nil {
+		a.timer.Stop()
+	}
+	a.timer = time.AfterFunc(a.budget.idle, a.expire)
+	a.mu.Unlock()
+	r.stopClose = context.AfterFunc(ctx, r.closeBody)
+	res.Body = r
+}
+
+type responseReader struct {
+	body       io.ReadCloser
+	attempt    *responseAttempt
+	proto      provider.Protocol
+	mode       string
+	pending    []byte
+	scanned    int
+	discarding bool
+	done       bool
+	closeOnce  sync.Once
+	stopClose  func() bool
+}
+
+func (r *responseReader) closeBody() {
+	r.closeOnce.Do(func() { _ = r.body.Close() })
+}
+
+func (r *responseReader) Close() error {
+	if r.stopClose != nil {
+		r.stopClose()
+	}
+	r.attempt.mu.Lock()
+	if r.attempt.reader == r {
+		r.attempt.reader = nil
+		if r.attempt.timer != nil {
+			r.attempt.timer.Stop()
+		}
+	}
+	r.attempt.mu.Unlock()
+	r.closeBody()
+	return nil
+}
+
+func (r *responseReader) Read(p []byte) (int, error) {
+	if r.done {
+		return 0, io.EOF
+	}
+	n, err := r.body.Read(p)
+	if n > 0 {
+		r.observe(p[:n])
+	}
+	if err == io.EOF {
+		r.attempt.progress(r, true)
+		r.done = true
+	}
+	if r.done {
+		r.closeBody()
+	}
+	if failure := r.attempt.failure(); failure != nil {
+		return 0, failure
+	}
+	return n, err
+}
+
+func (r *responseReader) observe(b []byte) {
+	if r.mode == "json" {
+		if len(bytes.TrimSpace(b)) > 0 {
+			r.attempt.progress(r, false)
+		}
+		return
+	}
+	// Sniff only a bounded prefix. Whitespace has no semantic progress.
+	if r.mode == "" {
+		b = bytes.TrimLeft(b, " \t\r\n")
+		if len(b) == 0 {
+			return
+		}
+		r.pending = append(r.pending, b...)
+		head := r.pending
+		if bytes.HasPrefix(head, []byte("event:")) || bytes.HasPrefix(head, []byte("data:")) || head[0] == ':' {
+			r.mode = "sse"
+		} else if len(head) < 6 && (bytes.HasPrefix([]byte("event:"), head) || bytes.HasPrefix([]byte("data:"), head)) {
+			return
+		} else {
+			r.mode, r.pending = "json", nil
+			r.attempt.progress(r, false)
+			return
+		}
+		b, r.pending = r.pending, nil
+	}
+	// Split by reads at the existing parser's size limit. A larger frame
+	// still passes byte-for-byte to its consumer, but is unknown to this
+	// observer: discard only its observation until the next boundary.
+	for len(b) > 0 {
+		take := min(len(b), sseFrameLimit-len(r.pending))
+		r.pending = append(r.pending, b[:take]...)
+		b = b[take:]
+		for {
+			n := eventEnd(r.pending[r.scanned:])
+			if n < 0 {
+				r.scanned = max(len(r.pending)-2, 0)
+				break
+			}
+			end := r.scanned + n
+			ev := r.pending[:end]
+			if !r.discarding {
+				data := eventData(ev)
+				complete := r.proto == provider.Chat && string(bytes.TrimSpace(data)) == "[DONE]"
+				content := false
+				if json.Valid(data) {
+					content, _ = firstKind(ev)
+					complete = responseWireEnded(r.proto, string(data))
+				}
+				if content || complete {
+					r.attempt.progress(r, complete)
+				}
+				if complete {
+					r.done, r.pending = true, nil
+					return
+				}
+			}
+			r.pending, r.scanned, r.discarding = r.pending[end:], 0, false
+		}
+		if len(r.pending) == sseFrameLimit {
+			r.pending = append([]byte(nil), r.pending[len(r.pending)-2:]...)
+			r.scanned, r.discarding = 0, true
+		}
+		if len(r.pending) == 0 {
+			r.pending = nil
+		}
+	}
+}
+
+// Chat's finish_reason and Anthropic's message_delta can be followed by
+// usage and a terminator. Keep those bytes; their actual terminator ends
+// the body even if the peer leaves the connection open afterwards.
+func responseWireEnded(proto provider.Protocol, data string) bool {
+	switch proto {
+	case provider.Chat:
+		return false
+	case provider.Anthropic:
+		t := eventType(data)
+		return t == "message_stop" || t == "error"
+	default:
+		return replyEnds(proto, data, upstreamStop([]byte(data)))
+	}
+}
+
+// reportResponseTimeout preserves the already-sent HTTP status when a
+// stream began. Its protocol's error is appended on an event boundary.
+func reportResponseTimeout(w http.ResponseWriter, h *holdWriter, kept *keptAlive, from provider.Protocol, e *responseTimeout) {
+	if h != nil && h.passing {
+		// A committed non-stream response cannot acquire an SSE envelope.
+		if !h.stream {
+			return
+		}
+		if !h.atLine {
+			_, _ = io.WriteString(w, "\n\n")
+		} else {
+			_, _ = io.WriteString(w, "\n")
+		}
+		streamError(w, from, http.StatusGatewayTimeout, e.Error())
+		return
+	}
+	failTo(w, kept, from, http.StatusGatewayTimeout, e.Error())
+}
+
+// A route can expire while sleeping between attempts too. Those stops
+// have the same local attribution and envelope as a body deadline.
+func responseStopped(ctx context.Context, w http.ResponseWriter, kept *keptAlive, from provider.Protocol, b *responseBudget) (int, string) {
+	if e := responseWaitExpired(ctx); e != nil {
+		b.failed(e)
+		failTo(w, kept, from, http.StatusGatewayTimeout, e.Error())
+		return http.StatusGatewayTimeout, e.Error()
+	}
+	return canceled(ctx)
+}
