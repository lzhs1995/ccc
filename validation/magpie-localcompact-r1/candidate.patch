+func passingPingWriter() (*holdWriter, *httptest.ResponseRecorder) {
+	r := httptest.NewRecorder()
+	h := newHoldWriter(r, false)
+	h.header.Set("Content-Type", "text/event-stream")
+	h.alive = &keptAlive{proto: provider.Responses, codexPing: true, streams: true}
+	h.streams = true
+	return h, r
+}
+
+func TestCodexPassingPingBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		name, wire string
+		safe       bool
+	}{
+		{"initial", "", true},
+		{"lf event", "event: x\ndata: {}\n\n", true},
+		{"crlf event", "event: x\r\ndata: {}\r\n\r\n", true},
+		{"mixed blank", "data: {}\n\r\n", true},
+		{"event without data", "event: x\n", false},
+		{"data without blank", "data: {}\n", false},
+		{"multiline data without blank", "data: one\ndata: two\n", false},
+		{"multiline data", "data: one\ndata: two\n\n", true},
+		{"comment only", ": alive\n: still alive\n", true},
+		{"comment crlf", ": alive\r\n", true},
+		{"comment does not clear field", "event: x\n: alive\n", false},
+		{"id field", "id: next\n", false},
+		{"retry field", "retry: 5\n", false},
+		{"unknown field", "unknown\n", false},
+		{"unknown then blank", "unknown\n\n", true},
+		{"partial comment", ": keep", false},
+		{"partial json", "data: {\"arg\":", false},
+		{"complete plus partial tail", "data: {}\n\ndata:", false},
+		{"pending cr", "data: {}\r\n\r", false},
+		{"bare cr conservative", "data: {}\r\r\n\n", false},
+		{"bom unknown prefix", "\xef\xbb\xbf", false},
+		{"blank lines", "\n\r\n\n", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// Every two-way split and an all-byte split must agree with a
+			// single write, including splits inside CRLF and UTF-8.
+			for split := 0; split <= len(tc.wire); split++ {
+				var s downstreamSSE
+				s.feed([]byte(tc.wire[:split]))
+				s.feed([]byte(tc.wire[split:]))
+				if s.safe() != tc.safe {
+					t.Fatalf("split %d safe=%v want %v: %+v", split, s.safe(), tc.safe, s)
+				}
+			}
+			var bytes downstreamSSE
+			for i := range len(tc.wire) {
+				bytes.feed([]byte(tc.wire[i : i+1]))
+			}
+			if bytes.safe() != tc.safe {
+				t.Fatalf("one-byte safe=%v want %v", bytes.safe(), tc.safe)
+			}
+			h, r := passingPingWriter()
+			h.WriteHeader(200)
+			if _, err := h.Write([]byte(tc.wire)); err != nil {
+				t.Fatal(err)
+			}
+			h.keepQuiet()
+			want := tc.wire
+			if tc.safe {
+				want += codexHeldPing
+			}
+			if r.Body.String() != want {
+				t.Fatalf("wire %q, want %q", r.Body.String(), want)
+			}
+		})
+	}
+}
+
+// A separate frame reader compares protocol fields rather than deleting a
+// ping-looking substring from arbitrary user text or tool arguments.
+func passingEvents(wire string) []string {
+	var events []string
+	var lines []string
+	for _, line := range strings.Split(strings.ReplaceAll(wire, "\r\n", "\n"), "\n") {
+		if line == "" {
+			if len(lines) > 0 {
+				frame := strings.Join(lines, "\n")
+				if frame != "event: ping\ndata: {\"type\":\"ping\"}" {
+					events = append(events, frame)
+				}
+				lines = nil
+			}
+		} else if !strings.HasPrefix(line, ":") {
+			lines = append(lines, line)
+		}
+	}
+	return events
+}
+
+func TestCodexPassingPingPreservesSplitToolAndTextEvents(t *testing.T) {
+	wire := "id: 7\r\nevent: response.output_text.delta\r\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"event: ping\\ndata: user text\"}\r\n\r\n" +
+		"event: response.function_call_arguments.delta\ndata: {\"type\":\"response.function_call_arguments.delta\",\ndata: \"delta\":\"{\\\"path\\\":\\\"unchanged\\\"}\"}\n\n" +
+		"event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"tail\"}\n\n"
+	for split := 0; split <= len(wire); split++ {
+		h, r := passingPingWriter()
+		h.Write([]byte(wire[:split]))
+		h.keepQuiet()
+		h.Write([]byte(wire[split:]))
+		h.alive.codexPingAt = time.Time{}
+		h.keepQuiet()
+		if !reflect.DeepEqual(passingEvents(r.Body.String()), passingEvents(wire)) {
+			t.Fatalf("protocol fields changed at split %d: %q", split, r.Body.String())
+		}
+	}
+	h, r := passingPingWriter()
+	for i := range len(wire) {
+		h.Write([]byte(wire[i : i+1]))
+		h.alive.codexPingAt = time.Time{}
+		h.keepQuiet()
+	}
+	if !reflect.DeepEqual(passingEvents(r.Body.String()), passingEvents(wire)) {
+		t.Fatalf("one-byte protocol fields changed: %q", r.Body.String())
+	}
+}
+
+func TestCodexPassingPingCommentCadenceAndBudget(t *testing.T) {
+	h, r := passingPingWriter()
+	h.Write([]byte(quietDelta("already started")))
+	old := time.Now().Add(-time.Minute)
+	h.alive.codexPingAt = old
+	h.Write([]byte(": upstream just wrote\n"))
+	heard, first, passing := h.heard, h.first, h.passing
+	until, due := time.Now().Add(time.Minute), time.Now().Add(30*time.Second)
+	h.responseAttempt = &responseAttempt{ctx: context.Background(), budget: &responseBudget{parent: context.Background(), until: until}, due: due}
+	before := r.Body.Len()
+	h.keepQuiet()
+	if got := r.Body.String()[before:]; got != codexHeldPing {
+		t.Fatalf("fresh comment suppressed event heartbeat: %q", got)
+	}
+	if h.heard != heard || !reflect.DeepEqual(h.first, first) || h.passing != passing || h.ended || h.responseAttempt.due != due || h.responseAttempt.budget.until != until {
+		t.Fatal("downstream event changed upstream progress, first token, budget or terminal state")
+	}
+	h.keepQuiet()
+	if strings.Count(r.Body.String()[before:], codexHeldPing) != 1 {
+		t.Fatal("heartbeat cadence was not enforced")
+	}
+	// A stream of comments continues to update wrote but cannot postpone
+	// the next due event. No test sleeps or global timer changes are needed.
+	h.Write([]byte(": another fresh comment\n"))
+	h.alive.codexPingAt = old
+	h.keepQuiet()
+	if strings.Count(r.Body.String()[before:], codexHeldPing) != 2 {
+		t.Fatal("continuous comments starved the next event heartbeat")
+	}
+}
+
+type passingShortWriter struct {
+	*httptest.ResponseRecorder
+	n   int
+	err error
+}
+
+func (w *passingShortWriter) Write(b []byte) (int, error) {
+	n := min(w.n, len(b))
+	w.ResponseRecorder.Write(b[:n])
+	return n, w.err
+}
+
+func TestCodexPassingPingWriteFailureClosed(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		n    int
+		err  error
+	}{
+		{"short without error", 1, nil},
+		{"short with error", 1, errors.New("closed")},
+		{"full with error", 1000, errors.New("closed")},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := httptest.NewRecorder()
+			w := &passingShortWriter{r, tc.n, tc.err}
+			h := newHoldWriter(w, false)
+			h.header.Set("Content-Type", "text/event-stream")
+			h.alive = &keptAlive{proto: provider.Responses, codexPing: true}
+			h.Write([]byte("data: {}\n\n"))
+			if !h.downstream.broken || h.downstream.safe() {
+				t.Fatal("failed write appeared safe")
+			}
+			w.n, w.err = 1000, nil
+			h.Write([]byte("\n\n"))
+			before := r.Body.String()
+			h.keepQuiet()
+			if r.Body.String() != before || h.downstream.safe() {
+				t.Fatal("later write re-enabled a heartbeat after failed output")
+			}
+		})
+	}
+}
+
+func TestCodexPassingPingStopsAndOtherAgentsUnchanged(t *testing.T) {
+	for _, kind := range []string{"cancel", "ended", "quiet bound", "non codex", "chat", "non stream"} {
+		t.Run(kind, func(t *testing.T) {
+			h, r := passingPingWriter()
+			h.Write([]byte(quietDelta("started")))
+			before := r.Body.String()
+			switch kind {
+			case "cancel":
+				ctx, cancel := context.WithCancel(context.Background())
+				cancel()
+				h.ctx = ctx
+			case "ended":
+				h.ended = true
+			case "quiet bound":
+				h.heard = time.Now().Add(-keepaliveLongest)
+			case "non codex":
+				h.alive.codexPing = false
+				h.wrote = time.Now().Add(-keepaliveEvery)
+			case "chat":
+				h.alive.proto = provider.Chat
+				h.wrote = time.Now().Add(-keepaliveEvery)
+			case "non stream":
+				r.Header().Set("Content-Type", "application/json")
+			}
+			h.keepQuiet()
+			want := before
+			if kind == "non codex" || kind == "chat" {
+				want += ": keepalive\n"
+			}
+			if r.Body.String() != want {
+				t.Fatalf("unexpected heartbeat %q, want %q", r.Body.String(), want)
+			}
+		})
+	}
+}
+
+func TestCodexPassingPingHeldFlowTracksPartialTail(t *testing.T) {
+	r := httptest.NewRecorder()
+	h := newHoldWriter(r, true)
+	h.header.Set("Content-Type", "text/event-stream")
+	h.alive = &keptAlive{proto: provider.Responses, codexPing: true}
+	wire := quietDelta("flow now") + "event: response.function_call_arguments.delta\n"
+	h.Write([]byte(wire))
+	if !h.passing || h.downstream.safe() {
+		t.Fatal("flow failed to track a partial tail after real content")
+	}
+	h.keepQuiet()
+	if r.Body.String() != wire {
+		t.Fatalf("heartbeat interrupted a held-to-passing partial event: %q", r.Body.String())
+	}
+	h.Write([]byte("data: {}\n\n"))
+	h.keepQuiet()
+	if r.Body.String() != wire+"data: {}\n\n"+codexHeldPing {
+		t.Fatal("complete event did not permit the next heartbeat")
+	}
+}
+
+func TestCodexPassingPingNeverFollowsTerminal(t *testing.T) {
+	for _, typ := range []string{"response.completed", "response.incomplete", "response.failed", "error"} {
+		t.Run(typ, func(t *testing.T) {
+			h, r := passingPingWriter()
+			h.Write([]byte(quietDelta("started")))
+			wire := "event: " + typ + "\ndata: {\"type\":\"" + typ + "\",\"error\":{\"message\":\"unavailable\"}}\n\n"
+			for i := range len(wire) {
+				h.Write([]byte(wire[i : i+1]))
+			}
+			before := r.Body.String()
+			h.keepQuiet()
+			if r.Body.String() != before {
+				t.Fatalf("heartbeat followed terminal %s", typ)
+			}
+			if (typ == "error" || typ == "response.failed") && h.ended {
+				t.Fatal("terminal error was incorrectly marked successful")
+			}
+		})
+	}
+}
+
+func TestCodexPassingPingOtherClientsKeepOriginalCommentRules(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		wire string
+	}{
+		{"ordinary CRLF", "data: {}\r\n\r\n"},
+		{"bare CR conservative for Codex only", "data: {}\rnext\n"},
+		{"plain text", "a non-Codex SSE text line\n"},
