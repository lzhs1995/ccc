--- /dev/null
+++ b/internal/gateway/heartbeat_budget_non_author_test.go
@@ -0,0 +1,89 @@
+package gateway
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+// This file is integrated only with the accepted reader/deadline source.
+// A downstream ping cannot count as supplier progress or restart the
+// total budget shared with a local compaction's summary request.
+func TestIndependentHeartbeatResponseBudgets(t *testing.T) {
+	for _, tc := range []struct {
+		name                      string
+		compact, native, semantic bool
+		want                      string
+	}{
+		{"ordinary-idle", false, false, false, "response_idle"},
+		{"local-compaction-idle", true, false, false, "response_idle"},
+		{"native-compaction-idle", true, true, false, "response_idle"},
+		{"local-compaction-total", true, false, true, "response_total"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fresh(t)
+			quietFast(t)
+			responseWaitSettings(t, 1, 2)
+			var f *responseFixture
+			f = responseVendor(t, "budget", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
+				responseHeaders(w, "text/event-stream", f)
+				io.WriteString(w, quietCreated)
+				w.(http.Flusher).Flush()
+				ticker := time.NewTicker(100 * time.Millisecond)
+				defer ticker.Stop()
+				for {
+					select {
+					case <-r.Context().Done():
+						f.gone <- struct{}{}
+						return
+					case <-ticker.C:
+						if tc.semantic {
+							io.WriteString(w, quietDelta("PARTIAL_SUMMARY"))
+						} else {
+							io.WriteString(w, ": upstream transport heartbeat\n\n")
+						}
+						w.(http.Flusher).Flush()
+					}
+				}
+			})
+			if tc.native {
+				nativeOn(t, "budget")
+			}
+			s := New()
+			gw := httptest.NewServer(lanGuard(s.Handler()))
+			t.Cleanup(gw.Close)
+			ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+			defer cancel()
+			req, _ := http.NewRequestWithContext(ctx, "POST", gw.URL+"/v1/responses", strings.NewReader(responseRequest("budget/m", true, tc.compact)))
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("User-Agent", "codex_cli_rs/0.164.0")
+			began := time.Now()
+			resp, err := http.DefaultClient.Do(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			b, err := io.ReadAll(resp.Body)
+			elapsed := time.Since(began)
+			if err != nil {
+				t.Fatalf("caller safety timer reached or broken body: %v", err)
+			}
+			body := string(b)
+			responseEnded(t, f)
+			if !strings.Contains(body, tc.want) || elapsed > 2800*time.Millisecond || f.calls.Load() != 1 {
+				t.Fatalf("budget failure: elapsed=%v calls=%d status=%d body=%q", elapsed, f.calls.Load(), resp.StatusCode, body)
+			}
+			if !tc.compact && !strings.Contains(body, "event: ping") {
+				t.Fatalf("ordinary Codex request never exercised the ping branch: %q", body)
+			}
+			if strings.Contains(body, "PARTIAL_SUMMARY") || strings.Contains(body, "response.completed") {
+				t.Fatalf("partial or synthetic success escaped: %q", body)
+			}
+			t.Logf("status=%d elapsed=%v ping=%v calls=%d terminal=%s", resp.StatusCode, elapsed, strings.Contains(body, "event: ping"), f.calls.Load(), tc.want)
+		})
+	}
+}
