@@ -0,0 +1,160 @@
+package gateway
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// Exercise request classification through the actual HTTP handler, rather
+// than manually constructing the ping flag. All keys here are fake fixtures.
+func TestIndependentHeartbeatCallerIsolation(t *testing.T) {
+	for _, tc := range []struct {
+		name, ua, token, originator string
+		ping                        bool
+	}{
+		{"codex-user-agent", "codex_cli_rs/0.164.0", "", "", true},
+		{"codex-full-user-agent", "codex_cli_rs/0.164.0 (Mac OS 26.6.0; arm64) kitty", "", "", true},
+		{"codex-originator", "AI-SDK/1.0", "", "codex_exec", true},
+		{"other-responses-agent", "AI-SDK/1.0", "", "", false},
+		{"codex-token", "AI-SDK/1.0", "magpie-codex", "", true},
+		{"other-agent-token", "AI-SDK/1.0", "magpie-alma", "", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fresh(t)
+			quietFast(t)
+			answer := quietCreated + quietDelta("real upstream answer") + quietDone
+			up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				io.ReadAll(r.Body)
+				w.Header().Set("Content-Type", "text/event-stream")
+				io.WriteString(w, quietCreated)
+				w.(http.Flusher).Flush()
+				select {
+				case <-time.After(180 * time.Millisecond):
+				case <-r.Context().Done():
+					return
+				}
+				io.WriteString(w, quietDelta("real upstream answer")+quietDone)
+			}))
+			t.Cleanup(up.Close)
+			if err := provider.Save(provider.Provider{ID: "fixture", Name: "Fixture", Key: "fake", Models: []string{"gpt-test"}, Responses: up.URL + "/v1"}); err != nil {
+				t.Fatal(err)
+			}
+			s := New()
+			gw := httptest.NewServer(s.Handler())
+			t.Cleanup(gw.Close)
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			req, _ := http.NewRequestWithContext(ctx, "POST", gw.URL+"/v1/responses", strings.NewReader(`{"model":"fixture/gpt-test","stream":true,"input":"fixture"}`))
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("User-Agent", tc.ua)
+			if tc.originator != "" {
+				req.Header.Set("originator", tc.originator)
+			}
+			if tc.token != "" {
+				req.Header.Set("Authorization", "Bearer "+tc.token)
+			}
+			resp, err := http.DefaultClient.Do(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			b, err := io.ReadAll(resp.Body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			body := string(b)
+			if got := strings.Contains(body, "event: ping\n"); got != tc.ping {
+				t.Fatalf("ping=%v want=%v; body=%q", got, tc.ping, body)
+			}
+			body = strings.ReplaceAll(body, "event: ping\ndata: {\"type\":\"ping\"}\n\n", "")
+			body = strings.ReplaceAll(body, ": keepalive\n", "")
+			if resp.StatusCode != 200 || body != answer {
+				t.Fatalf("upstream bytes changed: code=%d body=%q", resp.StatusCode, body)
+			}
+			route := lastRoute(s)
+			if route.Status != 200 || route.Error != "" || len(route.Tries) != 1 || route.Output != 2 {
+				t.Fatalf("ping polluted completion or usage: %+v", route)
+			}
+		})
+	}
+}
+
+// The line-boundary branch must remain a comment: a complete synthetic
+// event here would prematurely dispatch a partially received vendor event.
+func TestIndependentHeartbeatPassingPartialEvent(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := newHoldWriter(rec, false)
+	h.alive = &keptAlive{proto: provider.Responses, codexPing: true}
+	h.Header().Set("Content-Type", "text/event-stream")
+	h.WriteHeader(200)
+	prefix := "event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"hello\""
+	h.Write([]byte(prefix))
+	h.wrote = time.Now().Add(-time.Hour)
+	h.keepQuiet()
+	if rec.Body.String() != prefix {
+		t.Fatalf("mid-line heartbeat corrupted event: %q", rec.Body.String())
+	}
+	h.Write([]byte("}\n"))
+	h.wrote = time.Now().Add(-time.Hour)
+	h.keepQuiet()
+	if got := rec.Body.String(); got != prefix+"}\n: keepalive\n" {
+		t.Fatalf("line-boundary heartbeat dispatched a partial event: %q", got)
+	}
+	h.Write([]byte("\n"))
+	if strings.Count(rec.Body.String(), "\n\n") != 1 || strings.Contains(rec.Body.String(), "event: ping") {
+		t.Fatalf("extra SSE dispatch: %q", rec.Body.String())
+	}
+}
+
+// Once a ping has sent HTTP 200, a real failure must still be a typed
+// stream error, never a synthetic successful/empty response.
+func TestIndependentHeartbeatFinalFailure(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := newHoldWriter(rec, true)
+	h.alive = &keptAlive{proto: provider.Responses, codexPing: true, streams: true}
+	h.keepAlive()
+	if rec.Body.String() != "event: ping\ndata: {\"type\":\"ping\"}\n\n" {
+		t.Fatalf("heartbeat invented a response: %q", rec.Body.String())
+	}
+	code := failTo(rec, h.alive, provider.Responses, 403, "fixture access denied")
+	body := rec.Body.String()
+	if code != 403 || !strings.Contains(body, "fixture access denied") || !strings.Contains(body, "event: response.failed") {
+		t.Fatalf("failure lost: code=%d body=%q", code, body)
+	}
+	for _, forbidden := range []string{"response.completed", "response.output_text", "response.function_call", "\"usage\""} {
+		if strings.Contains(body, forbidden) {
+			t.Fatalf("synthetic response field %q: %q", forbidden, body)
+		}
+	}
+}
+
+// Healthy pings cannot make a permanently silent supplier live forever:
+// the existing maximum quiet age must still stop them.
+func TestIndependentHeartbeatQuietCeiling(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := newHoldWriter(rec, true)
+	h.streams = true
+	h.alive = &keptAlive{proto: provider.Responses, codexPing: true, streams: true}
+	h.heard = time.Now()
+	h.keepQuiet()
+	before := rec.Body.String()
+	if !strings.Contains(before, "event: ping") {
+		t.Fatalf("missing initial ping: %q", before)
+	}
+	h.alive.at = time.Now().Add(-time.Hour)
+	h.heard = time.Now().Add(-keepaliveLongest - time.Second)
+	h.keepQuiet()
+	if rec.Body.String() != before {
+		t.Fatal("heartbeat outlived maximum upstream quiet age")
+	}
+	if h.started() || h.ended {
+		t.Fatal("quiet ceiling invented response start/completion")
+	}
+}
