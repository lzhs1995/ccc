+func TestPortableDrainWaitsForCleanupAndState(t *testing.T) {
+	home, path := portHome(t, portRolloutLines("AA"), false)
+	seedState(t, home, path)
+	was := readPortState(t).Homes[home]
+	c := codexPortableGate()
+	entered, release := make(chan struct{}), make(chan struct{})
+	old := steady.Sync
+	var once sync.Once
+	steady.Sync = func(f *os.File) error {
+		if strings.HasPrefix(filepath.Base(f.Name()), ".magpie-rollout-") {
+			once.Do(func() { close(entered); <-release })
+		}
+		return old(f)
+	}
+	done := make(chan CodexPort, 1)
+	go func() { res, _ := PortCodexRollouts(context.Background(), home); done <- res }()
+	select {
+	case <-entered:
+	case <-time.After(10 * time.Second):
+		t.Fatal("copy never entered")
+	}
+	s := c.snapshot()
+	s, err := c.pause(s.Instance, s.Generation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, drainErr := c.drain(ctx, s.Instance, s.Generation)
+	if drainErr == nil || s.ActivePass != 1 || s.ActiveFile != 1 {
+		close(release)
+		<-done
+		steady.Sync = old
+		t.Fatalf("false early drain: %+v %v", s, drainErr)
+	}
+	close(release)
+	res := <-done
+	steady.Sync = old
+	s, err = c.drain(context.Background(), s.Instance, s.Generation)
+	if err != nil || !s.Drained || res.Done {
+		t.Fatalf("drain %+v %v pass=%+v", s, err, res)
+	}
+	noTemps(t, path)
+	now := readPortState(t).Homes[home]
+	if !now.Since.Equal(was.Since) || !contains(now.Pending, path) {
+		t.Fatalf("pause state not preserved %+v", now)
+	}
+	if _, err = c.resume(s.Instance, s.Generation); err != nil {
+		t.Fatal(err)
+	}
+	res, err = PortCodexRollouts(context.Background(), home)
+	if err != nil || len(res.Rewritten) != 1 {
+		t.Fatalf("resume did not publish %+v %v", res, err)
+	}
+}
