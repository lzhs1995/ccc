+// portScan uses the existing line conversion and compressed reader. The digest
+// covers input lines, not the transformed output; both passes must see it alike.
+func portScan(ctx context.Context, path string, out io.Writer) (changed bool, digest [32]byte, err error) {
+	in, err := openLines(path)
+	if err != nil {
+		return false, digest, err
+	}
+	defer in.Close()
+	hash := sha256.New()
+	br := bufio.NewReaderSize(in, 64<<10)
+	for {
+		if err := portableCheck(ctx); err != nil {
+			return false, digest, err
+		}
+		line, rerr := br.ReadBytes('\n')
+		if len(line) != 0 {
+			hash.Write(line)
+			converted, ok := portLine(line)
+			changed = changed || ok
+			if out != nil {
+				if _, err := out.Write(converted); err != nil {
+					return false, digest, err
+				}
+			}
+		}
+		if rerr == io.EOF {
+			break
+		}
+		if rerr != nil {
+			return false, digest, rerr
+		}
+	}
+	copy(digest[:], hash.Sum(nil))
+	return changed, digest, nil
+}
