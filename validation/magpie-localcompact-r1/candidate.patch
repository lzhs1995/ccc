+func TestPortableControlDoesNotCancelModelRequest(t *testing.T) {
+	started, release, completed := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(started)
+		select {
+		case <-r.Context().Done():
+			return
+		case <-release:
+			io.WriteString(w, "model completed")
+		}
+	}))
+	defer server.Close()
+	go func() {
+		resp, err := http.Get(server.URL)
+		if err == nil {
+			defer resp.Body.Close()
+			b, e := io.ReadAll(resp.Body)
+			err = e
+			if string(b) != "model completed" {
+				err = errors.New("request interrupted")
+			}
+		}
+		completed <- err
+	}()
+	<-started
+	c := newPortableControl(t.TempDir())
+	s := c.snapshot()
+	s, err := c.pause(s.Instance, s.Generation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.drain(context.Background(), s.Instance, s.Generation); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-completed:
+		close(release)
+		t.Fatalf("model request prematurely ended %v", err)
+	default:
+	}
+	close(release)
+	if err := <-completed; err != nil {
+		t.Fatal(err)
+	}
+}
