+// portWriter follows Codex's coordination-before-thread order, at both the
+// inexpensive admission check and final publication. It never replaces a lock.
+func portWriter(home, thread string, wait time.Duration) (func(), bool) {
+	locks := filepath.Join(home, "thread-writer-locks")
+	if fi, err := os.Stat(locks); err != nil || !fi.IsDir() {
+		return nil, false
+	}
+	unlock, held := filelock.Lock(filepath.Join(locks, ".coordination.lock"), wait)
+	if !held {
+		return nil, false
+	}
+	lf, err := os.OpenFile(filepath.Join(locks, thread+".lock"), os.O_RDWR, 0)
+	if errors.Is(err, fs.ErrNotExist) {
+		return unlock, true
+	}
+	if err != nil {
+		unlock()
+		return nil, false
+	}
+	got, err := filelock.TryLock(lf)
+	if err != nil || !got {
+		lf.Close()
+		unlock()
+		return nil, false
+	}
+	return func() { filelock.Unlock(lf); lf.Close(); unlock() }, true
+}
