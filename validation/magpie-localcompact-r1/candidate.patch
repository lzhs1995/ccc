+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, quietCreated)
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+		canceled.Add(1)
+	}))
+	t.Cleanup(slow.Close)
+	if err := provider.Save(provider.Provider{ID: "slow", Name: "Slow", Key: "one",
+		Keys: []provider.KeyAccount{{Key: "two"}}, Models: []string{"gpt-test"}, Responses: slow.URL + "/v1"}); err != nil {
+		t.Fatal(err)
+	}
+	answer := quietCreated + quietDelta("fallback answer") + quietDone
+	fast := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.ReadAll(r.Body)
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, answer)
+	}))
+	t.Cleanup(fast.Close)
+	if err := provider.Save(provider.Provider{ID: "fallback", Name: "Fallback", Key: "three",
+		Models: []string{"gpt-test"}, Responses: fast.URL + "/v1"}); err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.SaveGroup(provider.Group{Name: "G", Members: []string{"slow/gpt-test", "fallback/gpt-test"}, Routing: provider.Ordered, FirstToken: 1}); err != nil {
+		t.Fatal(err)
+	}
+	s := New()
+	gw := httptest.NewServer(s.Handler())
+	t.Cleanup(gw.Close)
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, gw.URL+"/v1/responses", strings.NewReader(`{"model":"group/g","stream":true,"input":"hi"}`))
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("User-Agent", "codex_cli_rs/0.164.0")
