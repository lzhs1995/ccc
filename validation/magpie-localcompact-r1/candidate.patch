+func TestPortableCrossProcessPauseAndDrain(t *testing.T) {
+	for _, mode := range []string{"hold", "abandon"} {
+		t.Run(mode, func(t *testing.T) {
+			home, path := portHome(t, portRolloutLines("AA"), false)
+			seedState(t, home, path)
+			c := codexPortableGate()
+			before, _ := os.ReadFile(path)
+			exe, err := os.Executable()
+			if err != nil {
+				t.Fatal(err)
+			}
+			command := func(mode string) *exec.Cmd {
+				cmd := exec.Command(exe, "-test.run=^TestPortableProcessFixture$")
+				cmd.Env = append(os.Environ(), "PORTABLE_FIXTURE_MODE="+mode, "PORTABLE_FIXTURE_HOME="+home, "PORTABLE_FIXTURE_CONFIG="+os.Getenv("XDG_CONFIG_HOME"))
+				return cmd
+			}
+			cmd := command(mode)
+			input, err := cmd.StdinPipe()
+			if err != nil {
+				t.Fatal(err)
+			}
+			out, err := cmd.StdoutPipe()
+			if err != nil {
+				t.Fatal(err)
+			}
+			cmd.Stderr = os.Stderr
+			if err := cmd.Start(); err != nil {
+				t.Fatal(err)
+			}
+			reader := bufio.NewReader(out)
+			line, err := reader.ReadString('\n')
+			if err != nil || line != "READY\n" {
+				input.Close()
+				cmd.Wait()
+				t.Fatalf("child not ready: %q %v", line, err)
+			}
+			// Draining stdout before Wait avoids a fixture pipe deadlock on testing output.
+			readDone := make(chan struct{})
+			go func() { io.Copy(io.Discard, reader); close(readDone) }()
+			s := c.snapshot()
+			if s.ActivePass != 1 || s.ActiveFile != 1 {
+				input.Close()
+				<-readDone
+				cmd.Wait()
+				t.Fatalf("cross-process work invisible %+v", s)
+			}
+			s, err = c.pause(s.Instance, s.Generation)
+			if err != nil {
+				t.Fatal(err)
+			}
+			try := command("try")
+			b, err := try.CombinedOutput()
+			if err != nil {
+				input.Close()
+				<-readDone
+				cmd.Wait()
+				t.Fatalf("separate CLI bypassed pause: %v %s", err, b)
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			if proof, err := c.drain(ctx, s.Instance, s.Generation); err == nil || proof.Drained {
+				t.Fatal("live file counted as drained")
+			}
+			input.Close()
+			<-readDone
+			exitErr := cmd.Wait()
+			if mode == "abandon" {
+				if exitErr == nil {
+					t.Fatal("fixture did not exit abruptly")
+				}
+				// A newly constructed controller represents another serving process.
+				other := newPortableControl(c.station)
+				fresh := other.snapshot()
+				proof, err := other.drain(ctx, fresh.Instance, fresh.Generation)
+				if err == nil || proof.Drained || proof.ActivePass != 1 || proof.ActiveFile != 1 {
+					t.Fatalf("abandoned work reaped: %+v %v", proof, err)
+				}
+				if _, err := other.resume(fresh.Instance, fresh.Generation); err == nil {
+					t.Fatal("resumed through unknown cleanup")
+				}
+				tmp, _ := filepath.Glob(filepath.Join(home, ".portable-fixture-*"))
+				if len(tmp) != 1 {
+					t.Fatal("lost retained fixture evidence", tmp)
+				}
+			} else {
+				if exitErr != nil {
+					t.Fatal(exitErr)
+				}
+				proof, err := c.drain(context.Background(), s.Instance, s.Generation)
+				if err != nil || !proof.Drained {
+					t.Fatalf("cleanup not observed %+v %v", proof, err)
+				}
+			}
+			unchanged(t, path, before)
+		})
+	}
+}
