+	if f.calls.Load() != 0 || out.Body.Len() != 0 || out.count.Load() != 0 {
+		t.Fatalf("already-canceled request escaped: calls=%d writes=%d body=%s", f.calls.Load(), out.count.Load(), out.Body)
