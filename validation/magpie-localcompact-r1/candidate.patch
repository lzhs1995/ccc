+
+func TestLocalCompactHeartbeatTwoAsksShareTotal(t *testing.T) {
+	fresh(t)
+	localCompactClock(t)
+	firstRelease := make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(firstRelease) }) }
+	second := make(chan struct{}, 1)
+	gone := make(chan struct{}, 1)
+	f := responseVendor(t, "wait", func(n int, w http.ResponseWriter, r *http.Request, _ string) {
+		if n == 1 {
+			select {
+			case <-firstRelease:
+			case <-r.Context().Done():
+				return
+			}
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusNotFound)
+			io.WriteString(w, `{"error":{"message":"Item with id rs_missing not found","type":"invalid_request_error"}}`)
+			return
+		}
+		second <- struct{}{}
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.WriteHeader(200)
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+		gone <- struct{}{}
+	})
+	t.Cleanup(unblock)
+	parent, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	b := &responseBudget{parent: parent, idle: time.Second, total: 800 * time.Millisecond, until: time.Now().Add(800 * time.Millisecond)}
+	ctx, stop := context.WithDeadlineCause(parent, b.until, &responseTimeout{"response_total", b.total})
+	defer stop()
+	ctx = context.WithValue(ctx, responseBudgetKey{}, b)
+	out := localCompactOutput()
+	done := localCompactRun(New(), out, localCompactRequest(ctx, true))
+	localCompactPing(t, out)
+	localCompactPing(t, out)
+	// Spend most of the original budget on ask one. A reset on ask
+	// two would then exceed the original deadline by more than the
+	// explicit scheduler allowance below.
+	if left := time.Until(b.until.Add(-250 * time.Millisecond)); left > 0 {
+		time.Sleep(left)
+	}
+	unblock()
+	select {
+	case <-second:
+	case <-time.After(time.Second):
+		t.Fatal("plain compact fallback ask never started")
+	}
+	localCompactDone(t, done)
+	if f.calls.Load() != 2 || parent.Err() != nil {
+		t.Fatalf("calls=%d caller-error=%v", f.calls.Load(), parent.Err())
+	}
+	if time.Now().After(b.until.Add(200 * time.Millisecond)) {
+		t.Fatal("second ask received a fresh total budget")
+	}
+	localCompactTerminal(t, out.Body.String(), "response.failed")
+	if !strings.Contains(out.Body.String(), "response_total") || strings.Contains(out.Body.String(), magpieCompaction) {
+		t.Fatalf("total timeout became a summary: %s", out.Body)
+	}
+	select {
+	case <-gone:
+	case <-time.After(time.Second):
+		t.Fatal("second supplier still running past shared deadline")
+	}
+}
+
+func TestLocalCompactHeartbeatFailurePreservesReceivedMetadata(t *testing.T) {
+	for _, meta := range []string{
+		`"type":"permission_error","code":"NO_BALANCE","param":"model"`,
+		`"type":"","code":403,"param":""`,
+		`"type":null,"code":null,"param":null`,
+	} {
+		out := localCompactOutput()
+		ctx, cancel := context.WithCancel(context.Background())
+		c := &localCompactHeartbeat{w: out, ctx: ctx, cancel: cancel, kept: &keptAlive{sent: true}, stop: func() {}}
+		// The inner gateway's normalization is independently covered by
+		// the real Handler baseline. This unit covers the exact metadata
+		// the outer wrapper actually receives, including unusual JSON types.
+		if !c.failure(403, "fixture denied", []byte(`{"error":{"message":"fixture denied",`+meta+`}}`)) {
+			t.Fatal("already-open stream fell back to JSON")
+		}
+		c.close()
+		e := localCompactTerminal(t, out.Body.String(), "response.failed")
+		var got struct {
+			Error map[string]json.RawMessage `json:"error"`
+		}
+		json.Unmarshal(e["response"], &got)
+		var want map[string]json.RawMessage
+		json.Unmarshal([]byte(`{`+meta+`}`), &want)
+		for k, v := range want {
+			if !bytes.Equal(got.Error[k], v) {
+				t.Errorf("received %s lost: got %s want %s", k, got.Error[k], v)
+			}
+		}
+	}
+}
