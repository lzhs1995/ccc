+	releases := make(chan chan struct{}, 2)
+	f := responseVendor(t, "wait", func(_ int, w http.ResponseWriter, r *http.Request, _ string) {
+		release := make(chan struct{})
+		releases <- release
+		select {
+		case <-release:
+		case <-r.Context().Done():
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		io.WriteString(w, wholeSummary(provider.Responses))
+	})
+	s := New()
+	for _, compact := range []bool{true, false} {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		out := localCompactOutput()
+		done := localCompactRun(s, out, localCompactRequest(ctx, compact))
+		var release chan struct{}
+		select {
+		case release = <-releases:
+		case <-ctx.Done():
+			cancel()
+			t.Fatal("supplier never started")
+		}
+		localCompactPing(t, out)
+		close(release)
+		localCompactDone(t, done)
+		cancel()
+		if compact {
+			localCompactTerminal(t, out.Body.String(), "response.completed")
+		} else {
+			// The ordinary provider stream may legally be data-only SSE.
+			// Keep the compact path's stricter generated-frame checks above.
+			completed := 0
+			for _, event := range events(out.Body.String()) {
+				switch event["type"] {
+				case "response.completed":
+					completed++
+				case "response.failed", "response.incomplete":
+					t.Fatalf("ordinary request failed: %s", out.Body)
+				}
+			}
+			if completed != 1 || strings.Contains(out.Body.String(), magpieCompaction) {
+				t.Fatalf("ordinary request inherited local compact: completed=%d body=%s", completed, out.Body)
+			}
+		}
+	}
+	if f.calls.Load() != 2 {
+		t.Fatalf("calls=%d", f.calls.Load())
+	}
+}
