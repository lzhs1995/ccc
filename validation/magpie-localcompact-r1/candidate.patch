+	for _, a := range s.Active {
+		if a.Files < 0 || a.Instance == "" || a.PID <= 0 {
+			return s, errors.New("invalid portable active record")
+		}
+	}
+	c.epochMu.Lock()
+	defer c.epochMu.Unlock()
+	if c.epoch != "" && c.epoch != s.Epoch {
+		return s, errors.New("portable control epoch changed")
+	}
+	c.epoch = s.Epoch
+	return s, nil
+}
+
+// transact serializes admission across processes with a new station-local
+// lock. It neither opens nor replaces the existing shared portable pass lock.
+// A record is durable before work starts and is removed only after cleanup.
+func (c *portableControl) transact(write bool, fn func(*portableControlState) error) error {
+	if !filepath.IsAbs(c.station) {
+		return errors.New("portable station must be absolute")
+	}
+	if err := os.MkdirAll(c.station, 0700); err != nil {
+		return err
+	}
+	path := c.path() + ".lock"
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	fi, err := f.Stat()
+	if err != nil {
+		return err
+	}
+	end := time.Now().Add(time.Second)
+	for {
+		now, err := os.Lstat(path)
+		if err != nil || !now.Mode().IsRegular() || !os.SameFile(fi, now) {
+			return errors.New("portable control lock identity changed")
+		}
+		held, err := filelock.TryLock(f)
+		if err != nil {
+			return err
+		}
+		if held {
+			break
+		}
+		if time.Now().After(end) {
+			return errors.New("portable control lock busy")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	defer filelock.Unlock(f)
+	now, err := os.Lstat(path)
+	if err != nil || !os.SameFile(fi, now) {
+		return errors.New("portable control lock replaced")
+	}
+	s, err := c.read()
+	if err != nil {
+		return err
+	}
+	if err := fn(&s); err != nil {
+		return err
+	}
+	if !write {
+		return nil
+	}
+	b, err := json.Marshal(s)
+	if err != nil {
+		return err
+	}
+	err = steady.WriteFile(c.path(), b, 0600)
+	if err == nil {
+		c.epochMu.Lock()
+		c.epoch = s.Epoch
+		c.epochMu.Unlock()
+	}
+	return err
+}
+func (c *portableControl) status(s portableControlState, err error) CodexPortableStatus {
+	out := CodexPortableStatus{Instance: c.instance, PID: os.Getpid(), Station: c.station, Generation: s.Generation, Paused: s.Paused, PausedPasses: s.PausedPasses}
+	if err != nil {
+		out.ControlError = err.Error()
+		return out
+	}
+	out.ActivePass = len(s.Active)
+	for _, a := range s.Active {
+		out.ActiveFile += a.Files
+		out.CleanupErrors = append(out.CleanupErrors, a.Errors...)
+	}
+	out.Drained = out.Paused && out.ActivePass == 0 && out.ActiveFile == 0 && len(out.CleanupErrors) == 0
+	return out
+}
+func (c *portableControl) snapshot() CodexPortableStatus { s, err := c.read(); return c.status(s, err) }
+func (c *portableControl) pause(instance string, generation uint64) (CodexPortableStatus, error) {
+	err := c.transact(true, func(s *portableControlState) error {
+		if instance != c.instance || generation != s.Generation {
+			return errPortableGeneration
+		}
+		if !s.Paused {
+			s.Paused = true
+			s.Generation++
+		}
+		return nil
+	})
+	return c.snapshot(), err
+}
+func (c *portableControl) resume(instance string, generation uint64) (CodexPortableStatus, error) {
+	err := c.transact(true, func(s *portableControlState) error {
+		if instance != c.instance || generation != s.Generation {
+			return errPortableGeneration
+		}
+		if !s.Paused || len(s.Active) != 0 {
+			return errors.New("portable work not drained")
+		}
+		s.Paused = false
+		s.Generation++
+		return nil
+	})
+	return c.snapshot(), err
+}
+func (c *portableControl) drain(ctx context.Context, instance string, generation uint64) (CodexPortableStatus, error) {
+	tick := time.NewTicker(20 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		var observed portableControlState
+		err := c.transact(false, func(s *portableControlState) error { observed = *s; return nil })
+		s := c.status(observed, err)
+		if err != nil {
+			return s, err
+		}
+		if instance != c.instance || s.Generation != generation || !s.Paused {
+			return s, errPortableGeneration
+		}
+		if len(s.CleanupErrors) > 0 {
+			return s, errPortableCleanup
+		}
+		if s.Drained {
+			return s, nil
+		}
+		select {
+		case <-ctx.Done():
+			return s, ctx.Err()
+		case <-tick.C:
+		}
+	}
+}
+
+type portablePass struct {
+	control    *portableControl
+	generation uint64
+	id         string
+	failed     atomic.Bool
+	checkMu    sync.Mutex
+	checked    time.Time
+	checkErr   error
+}
+
+func (c *portableControl) begin() (*portablePass, error) {
+	p := &portablePass{control: c, id: portableNonce()}
+	refused := false
+	err := c.transact(true, func(s *portableControlState) error {
+		if s.Paused {
+			refused = true
+			s.PausedPasses++
+			return nil
+		}
+		for _, a := range s.Active {
+			if len(a.Errors) > 0 {
+				return errPortableCleanup
+			}
+		}
+		p.generation = s.Generation
+		s.Active[p.id] = portableWork{PID: os.Getpid(), Instance: c.instance}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	if refused {
+		return nil, errPortablePaused
+	}
+	return p, nil
+}
+func (p *portablePass) admitted(s *portableControlState) error {
+	if s.Paused || s.Generation != p.generation {
+		return errPortablePaused
+	}
+	a, ok := s.Active[p.id]
+	if !ok || a.Instance != p.control.instance || p.failed.Load() {
+		return errPortablePaused
+	}
+	return nil
+}
+func (p *portablePass) strictCheck() error {
+	if p == nil {
+		return nil
+	}
+	s, err := p.control.read()
+	if err != nil {
+		return err
+	}
+	return p.admitted(&s)
+}
+
+// Only the streaming read check is amortized. Pass/file admission, temp
+// creation and final publication checks always reread the shared generation.
+func (p *portablePass) check() error {
+	if p == nil {
+		return nil
+	}
+	p.checkMu.Lock()
+	defer p.checkMu.Unlock()
+	if p.checked.IsZero() || time.Since(p.checked) >= 50*time.Millisecond {
+		p.checkErr = p.strictCheck()
+		p.checked = time.Now()
+	}
+	return p.checkErr
+}
+func (p *portablePass) close() {
+	if p.failed.Load() {
+		return
+	}
+	err := p.control.transact(true, func(s *portableControlState) error {
+		a, ok := s.Active[p.id]
+		if !ok {
+			return nil
+		}
+		if a.Files != 0 || len(a.Errors) > 0 {
+			return errPortableCleanup
+		}
+		delete(s.Active, p.id)
+		return nil
+	})
+	if err != nil {
+		p.cleanupError(err)
+	}
+}
+func (p *portablePass) beginFile() (func(), error) {
+	if p == nil {
+		return func() {}, nil
+	}
+	err := p.control.transact(true, func(s *portableControlState) error {
+		if err := p.admitted(s); err != nil {
+			return err
+		}
+		a := s.Active[p.id]
+		a.Files++
+		s.Active[p.id] = a
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			err := p.control.transact(true, func(s *portableControlState) error {
+				a, ok := s.Active[p.id]
+				if !ok || a.Files < 1 {
+					return errPortableCleanup
+				}
+				a.Files--
+				s.Active[p.id] = a
+				return nil
+			})
+			if err != nil {
+				p.cleanupError(err)
+			}
+		})
+	}, nil
+}
+func (p *portablePass) cleanupError(err error) {
+	if p == nil || err == nil {
+		return
+	}
+	p.failed.Store(true)
+	// On persistence failure the pre-existing active record remains, so even
+	// after a crash a different process cannot mistake missing confirmation for
+	// a completed drain. No automatic record reaping or budget reset occurs.
+	_ = p.control.transact(true, func(s *portableControlState) error {
+		a, ok := s.Active[p.id]
+		if !ok {
+			return fmt.Errorf("lost portable active record: %w", err)
+		}
+		a.Errors = append(a.Errors, err.Error())
+		s.Active[p.id] = a
+		return nil
+	})
+}
+func (p *portablePass) createTemp(dir, pattern string) (f *os.File, err error) {
+	if p == nil {
+		return portCreateTemp(dir, pattern)
+	}
+	err = p.control.transact(false, func(s *portableControlState) error {
+		if err := p.admitted(s); err != nil {
+			return err
+		}
+		if s.Active[p.id].Files == 0 {
+			return errPortableCleanup
+		}
+		var e error
+		f, e = portCreateTemp(dir, pattern)
+		return e
+	})
+	return f, err
+}
+
+type portablePassKey struct{}
+
+func passOf(ctx context.Context) *portablePass {
+	p, _ := ctx.Value(portablePassKey{}).(*portablePass)
+	return p
+}
+func portableCheck(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return passOf(ctx).check()
+}
+func portableStrictCheck(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return passOf(ctx).strictCheck()
+}
+
+// CodexPortableHandler is registered on the existing guarded admin mux. It
+// never listens on a new port, edits config, or cancels any model request.
+func CodexPortableHandler() http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c := codexPortableGate()
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Cache-Control", "no-store")
+		if r.Method == http.MethodGet {
+			json.NewEncoder(w).Encode(c.snapshot())
+			return
+		}
+		if r.Method != http.MethodPost {
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return
+		}
+		var req struct {
+			Action     string `json:"action"`
+			Instance   string `json:"instance"`
+			Generation uint64 `json:"generation"`
+		}
+		d := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4096))
+		d.DisallowUnknownFields()
+		if err := d.Decode(&req); err != nil {
+			http.Error(w, "invalid control request", 400)
+			return
+		}
+		if err := d.Decode(new(any)); err != io.EOF {
+			http.Error(w, "trailing control request", 400)
+			return
+		}
+		var s CodexPortableStatus
+		var err error
+		switch req.Action {
+		case "pause":
+			s, err = c.pause(req.Instance, req.Generation)
+		case "resume":
+			s, err = c.resume(req.Instance, req.Generation)
+		case "drain":
+			ctx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+			defer cancel()
+			s, err = c.drain(ctx, req.Instance, req.Generation)
+		default:
+			http.Error(w, "unknown control action", 400)
+			return
+		}
+		if err != nil {
+			code := http.StatusConflict
+			if errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled) {
+				code = http.StatusRequestTimeout
+			}
+			w.WriteHeader(code)
+			json.NewEncoder(w).Encode(struct {
+				Status CodexPortableStatus `json:"status"`
+				Error  string              `json:"error"`
+			}{s, err.Error()})
+			return
+		}
+		json.NewEncoder(w).Encode(s)
+	})
+}
