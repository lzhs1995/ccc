+// portFingerprint catches path replacement and content rewrites even when size
+// and mtime are restored. Final use holds the original publication locks.
+func portFingerprint(ctx context.Context, path string, fi fs.FileInfo) (digest [32]byte, err error) {
+	now, err := os.Lstat(path)
+	if err != nil || !portSameFile(fi, now) {
+		return digest, errRolloutHeld
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return digest, err
+	}
+	defer f.Close()
+	if now, err := f.Stat(); err != nil || !portSameFile(fi, now) {
+		return digest, errRolloutHeld
+	}
+	hash := sha256.New()
+	b := make([]byte, 64<<10)
+	for {
+		if err := portableCheck(ctx); err != nil {
+			return digest, err
+		}
+		n, err := f.Read(b)
+		hash.Write(b[:n])
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return digest, err
+		}
