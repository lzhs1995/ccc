+func TestPortableControlReadFailureAndEpoch(t *testing.T) {
+	for _, mode := range []string{"truncated", "deleted", "replaced-epoch"} {
+		t.Run(mode, func(t *testing.T) {
+			c := newPortableControl(t.TempDir())
+			s := c.snapshot()
+			s, err := c.pause(s.Instance, s.Generation)
+			if err != nil {
+				t.Fatal(err)
+			}
+			switch mode {
+			case "truncated":
+				os.WriteFile(c.path(), []byte("{"), 0600)
+			case "deleted":
+				os.Remove(c.path())
+			case "replaced-epoch":
+				state, err := c.read()
+				if err != nil {
+					t.Fatal(err)
+				}
+				state.Epoch = "another"
+				b, _ := json.Marshal(state)
+				os.WriteFile(c.path(), b, 0600)
+			}
+			if proof := c.snapshot(); proof.Drained || proof.ControlError == "" {
+				t.Fatalf("bad state read as empty %+v", proof)
+			}
+			if _, err := c.drain(context.Background(), s.Instance, s.Generation); err == nil {
+				t.Fatal("bad state drained")
+			}
+			if _, err := c.begin(); err == nil {
+				t.Fatal("bad state admitted")
+			}
+		})
+	}
+}
