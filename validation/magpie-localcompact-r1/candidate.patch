+const codexHeldPing = "event: ping\ndata: {\"type\":\"ping\"}\n\n"
+
+func TestCodexHeldPingDoesNotCommitCandidate(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		proto          provider.Protocol
+		codex, passing bool
+		want           string
+	}{
+		{"codex responses held", provider.Responses, true, false, codexHeldPing},
+		{"other responses held", provider.Responses, false, false, ": keepalive\n"},
+		{"claude held", provider.Anthropic, false, false, ": keepalive\n"},
+		{"gemini", provider.Gemini, true, false, ""},
+		{"codex passing partial frame", provider.Responses, true, true, ": keepalive\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			h := newHoldWriter(rec, true)
+			before := time.Now().Add(-time.Minute)
+			h.alive = &keptAlive{proto: tc.proto, codexPing: tc.codex, told: before}
+			h.passing = tc.passing
+			h.keepAlive()
+			if got := rec.Body.String(); got != tc.want {
+				t.Fatalf("keepalive %q, want %q", got, tc.want)
+			}
+			if h.first.first != 0 || h.ended || h.held.Len() != 0 || h.passing != tc.passing {
+				t.Fatal("keepalive changed content, terminal or candidate commitment")
+			}
+			if tc.want == codexHeldPing {
+				if !h.alive.told.After(before) || h.started() {
+					t.Fatal("ping must count as a downstream event without starting the reply")
+				}
+			} else if !h.alive.told.Equal(before) {
+				t.Fatal("an SSE comment counted as a downstream event")
+			}
+		})
+	}
+}
