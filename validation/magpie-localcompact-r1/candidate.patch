+++ b/internal/settings/response_wait.go
@@ -0,0 +1,26 @@
+package settings
+
+import (
+	"fmt"
+	"math"
+	"time"
+)
+
+// ResponseWait bounds a reply's progress and the complete routed request.
+// Values are seconds; zero uses the default, never an unlimited wait.
+func (s Settings) ResponseWait() (idle, total time.Duration, err error) {
+	read := func(name string, n int, fallback time.Duration) (time.Duration, error) {
+		if n < 0 || int64(n) > math.MaxInt64/int64(time.Second) {
+			return 0, fmt.Errorf("%s must be non-negative seconds within a duration", name)
+		}
+		if n == 0 {
+			return fallback, nil
+		}
+		return time.Duration(n) * time.Second, nil
+	}
+	if idle, err = read("responseIdle", s.ResponseIdle, 5*time.Minute); err != nil {
+		return
+	}
+	total, err = read("responseTotal", s.ResponseTotal, 30*time.Minute)
+	return
+}
