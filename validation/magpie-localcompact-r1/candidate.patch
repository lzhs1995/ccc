+			want := append([]byte(nil), before...)
+			old := steady.Sync
+			var unlock func()
+			steady.Sync = func(f *os.File) error {
+				if strings.HasPrefix(filepath.Base(f.Name()), ".magpie-rollout-") {
+					switch scenario {
+					case "replace-same-size-time":
+						q := path + ".replaced"
+						if err := os.WriteFile(q, want, fi.Mode()); err != nil {
+							return err
+						}
+						if err := os.Chtimes(q, fi.ModTime(), fi.ModTime()); err != nil {
+							return err
+						}
+						if err := os.Rename(q, path); err != nil {
