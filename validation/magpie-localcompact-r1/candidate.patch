+func TestPortableControlHTTP(t *testing.T) {
+	portHome(t, portRolloutLines("AA"), false)
+	h := CodexPortableHandler()
+	request := func(method, body string) (int, []byte) {
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, httptest.NewRequest(method, "/api/codex-portable", strings.NewReader(body)))
+		return w.Code, w.Body.Bytes()
+	}
+	code, b := request("GET", "")
+	var s CodexPortableStatus
+	if code != 200 || json.Unmarshal(b, &s) != nil || s.Instance == "" {
+		t.Fatal("status", code, string(b))
+	}
+	for _, bad := range []string{`{`, `{} {}`, `{"action":"pause","extra":true}`, `{"action":"unknown"}`, strings.Repeat("x", 5000)} {
+		if code, _ := request("POST", bad); code != 400 {
+			t.Fatalf("bad control accepted %d", code)
+		}
+	}
+	if code, _ := request("DELETE", ""); code != 405 {
+		t.Fatal(code)
+	}
+	control := func(action string, gen uint64) (int, []byte) {
+		b, _ := json.Marshal(map[string]any{"action": action, "instance": s.Instance, "generation": gen})
+		return request("POST", string(b))
+	}
+	if code, _ := control("pause", s.Generation+1); code != 409 {
+		t.Fatal("stale pause", code)
+	}
+	code, b = control("pause", s.Generation)
+	if code != 200 {
+		t.Fatal(code, string(b))
+	}
+	json.Unmarshal(b, &s)
+	if code, _ := control("drain", s.Generation); code != 200 {
+		t.Fatal("drain", code)
+	}
+	if code, _ := control("resume", s.Generation); code != 200 {
+		t.Fatal("resume", code)
+	}
+}
