+func TestResponseWaitSettings(t *testing.T) {
+	idle, total, err := (Settings{}).ResponseWait()
+	if err != nil || idle != 5*time.Minute || total != 30*time.Minute {
+		t.Fatalf("defaults %s %s %v", idle, total, err)
+	}
+	idle, total, err = (Settings{ResponseIdle: 7, ResponseTotal: 11}).ResponseWait()
+	if err != nil || idle != 7*time.Second || total != 11*time.Second {
+		t.Fatal("explicit value lost")
+	}
+	for _, s := range []Settings{{ResponseIdle: -1}, {ResponseTotal: -1}, {ResponseIdle: math.MaxInt}, {ResponseTotal: math.MaxInt}} {
+		if _, _, err := s.ResponseWait(); err == nil {
+			t.Fatalf("invalid accepted: %+v", s)
+		}
+	}
+	if err := Save(Settings{ResponseIdle: -1}); err == nil {
+		t.Fatal("negative config saved")
+	}
+}
