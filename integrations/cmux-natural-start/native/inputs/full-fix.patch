+    func testBundleIconPersistenceRequiresBooleanPackageOptIn() throws {
+        XCTAssertFalse(AppBundleIconPersistencePolicy.isDisabledByBundleInfo(nil))
+        XCTAssertFalse(AppBundleIconPersistencePolicy.isDisabledByBundleInfo([:]))
+
+        let cases: [(value: Any, expected: Bool)] = [
+            (true, true),
+            (false, false),
+            (1, false),
+            (0, false),
+            ("true", false),
+            ("1", false),
+        ]
+        let formats: [PropertyListSerialization.PropertyListFormat] = [.xml, .binary]
+        for (value, expected) in cases {
+            for format in formats {
+                let data = try PropertyListSerialization.data(
+                    fromPropertyList: ["CMUXDisableBundleIconPersistence": value],
+                    format: format,
+                    options: 0
+                )
+                let plist = try PropertyListSerialization.propertyList(from: data, options: [], format: nil)
+                let info = try XCTUnwrap(plist as? [String: Any])
+                XCTAssertEqual(AppBundleIconPersistencePolicy.isDisabledByBundleInfo(info), expected)
+            }
+        }
+    }
+
+    func testBundleIconPersistenceSignedOptInAppliesBeforeAppDefaults() {
+        XCTAssertFalse(AppBundleIconPersistencePolicy.shouldPersist(
+            bundleIdentifier: "com.cmuxterm.app",
+            appBundleLastPathComponent: "cmux.app",
+            persistenceDisabled: false,
+            bundleInfoDictionary: [AppBundleIconPersistencePolicy.disablePersistenceInfoKey: true]
+        ))
+    }
+
+    func testBundleIconPersistenceSignedOptInSurvivesArgumentFreeLaunch() throws {
+        let suiteName = "AppearanceSettingsTests.SignedBundleIconPersistence.\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: suiteName))
+        defer { defaults.removePersistentDomain(forName: suiteName) }
+        defaults.set(false, forKey: AppBundleIconPersistencePolicy.disablePersistenceDefaultsKey)
+
+        AppBundleIconPersistencePolicy.updateDisableDefault(
+            defaults: defaults,
+            launchArguments: ["/Applications/cmux.app/Contents/MacOS/cmux"],
+            bundleInfoDictionary: [AppBundleIconPersistencePolicy.disablePersistenceInfoKey: true]
+        )
+
+        XCTAssertTrue(defaults.bool(forKey: AppBundleIconPersistencePolicy.disablePersistenceDefaultsKey))
+    }
+
+    func testBundleIconPersistenceAbsentOrFalseMetadataRestoresOfficialDefault() throws {
+        let suiteName = "AppearanceSettingsTests.DefaultBundleIconPersistence.\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: suiteName))
+        defer { defaults.removePersistentDomain(forName: suiteName) }
+        let metadata: [[String: Any]?] = [
+            nil,
+            [:],
+            [AppBundleIconPersistencePolicy.disablePersistenceInfoKey: false],
+        ]
+
+        for info in metadata {
+            defaults.set(true, forKey: AppBundleIconPersistencePolicy.disablePersistenceDefaultsKey)
+            AppBundleIconPersistencePolicy.updateDisableDefault(
+                defaults: defaults,
+                launchArguments: ["/Applications/cmux.app/Contents/MacOS/cmux"],
+                bundleInfoDictionary: info
+            )
+            XCTAssertFalse(defaults.bool(forKey: AppBundleIconPersistencePolicy.disablePersistenceDefaultsKey))
+            XCTAssertTrue(AppBundleIconPersistencePolicy.shouldPersist(
+                bundleIdentifier: "com.cmuxterm.app",
+                appBundleLastPathComponent: "cmux.app",
+                persistenceDisabled: defaults.bool(forKey: AppBundleIconPersistencePolicy.disablePersistenceDefaultsKey),
+                bundleInfoDictionary: info
+            ))
+        }
+    }
