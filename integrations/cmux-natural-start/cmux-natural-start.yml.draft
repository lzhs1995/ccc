name: cmux natural startup and original session restore
on:
  push:
    branches: [ccc/cmux-natural-start-20261111-r1]
permissions:
  contents: read
  actions: read
concurrency:
  group: cmux-natural-start-${{ github.ref }}
  cancel-in-progress: false
jobs:
  native:
    runs-on: macos-26
    timeout-minutes: 350
    outputs:
      artifact_id: ${{ steps.native_upload.outputs.artifact-id }}
      artifact_digest: ${{ steps.native_upload.outputs.artifact-digest }}
    env:
      CMUX_DEV_BACKEND_MODE: local
      CMUX_SKIP_ZIG_BUILD: "1"
      CMUX_GHOSTTYKIT_PREPROVISIONED: "1"
      CMUX_CI_REQUIRED_MACOS_SDK_MAJOR: "26"
      CMUX_CI_APP_HOST_ISOLATION_REQUIRED: "1"
      CMUX_APP_HOST_SHARD: "1"
      CMUX_APP_HOST_XCODEBUILD_ATTEMPTS: "1"
      CMUX_XCODEBUILD_NONINTERACTIVE_RESTART_BUDGET: "0"
      GHOSTTYKIT_DOWNLOAD_RETRIES: "2"
      GHOSTTYKIT_DOWNLOAD_RETRY_DELAY: "2"
      GHOSTTYKIT_DOWNLOAD_CONNECT_TIMEOUT: "10"
      GHOSTTYKIT_DOWNLOAD_MAX_TIME: "300"
    defaults:
      run:
        shell: bash
        working-directory: cmux-source
    steps:
      - name: Require a disposable GitHub runner
        working-directory: ${{ github.workspace }}
        env:
          NATIVE_RUNNER_KIND: ${{ runner.environment }}
        run: |
          test "$NATIVE_RUNNER_KIND" = github-hosted
          test "$RUNNER_ENVIRONMENT" = github-hosted
      - name: Checkout the exact reviewed preparation
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ github.sha }}
          path: preparation
          persist-credentials: false
      - name: Reject an incomplete source and test contract
        working-directory: ${{ github.workspace }}/preparation/integrations/cmux-natural-start/native
        run: python3 -BE contract.py admit .
      - name: Checkout the fixed source base
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          repository: manaflow-ai/cmux
          ref: 2e109a1739d320fe36220afb3e7775b59c1acd47
          submodules: recursive
          fetch-depth: 1
          path: cmux-source
          persist-credentials: false
      - name: Pin the original source and private evidence paths
        run: |
          test "$(git rev-parse HEAD)" = 2e109a1739d320fe36220afb3e7775b59c1acd47
          test "$(git rev-parse HEAD:ghostty)" = ef4f1570d62117ebc51e3b0f07ad4f34032267b6
          test "$(git -C ghostty rev-parse HEAD)" = ef4f1570d62117ebc51e3b0f07ad4f34032267b6
          echo "NATIVE_PREPARATION=$GITHUB_WORKSPACE/preparation/integrations/cmux-natural-start/native" >> "$GITHUB_ENV"
          echo "NESTED_PREPARATION=$GITHUB_WORKSPACE/preparation/integrations/cmux-natural-start/native" >> "$GITHUB_ENV"
          echo "NESTED_EVIDENCE=$RUNNER_TEMP/cmux-natural-native-evidence" >> "$GITHUB_ENV"
          echo "NESTED_DERIVED=$RUNNER_TEMP/cmux-natural-native-derived" >> "$GITHUB_ENV"
          echo "CMUX_DERIVED_DATA_PATH=$RUNNER_TEMP/cmux-natural-native-derived" >> "$GITHUB_ENV"
          echo "CMUX_CI_RUNTIME_SOURCE_ROOT=$GITHUB_WORKSPACE/cmux-source" >> "$GITHUB_ENV"
      - name: Verify the real console path and original attempt budget
        timeout-minutes: 2
        run: |
          mkdir -p "$NESTED_EVIDENCE" "$NESTED_DERIVED"
          bash "$NATIVE_PREPARATION/console-in-source.sh" \
            /usr/bin/env CMUX_XCODEBUILD_NONINTERACTIVE_RESTART_BUDGET=0 \
            /bin/bash "$NATIVE_PREPARATION/preflight-app-host.sh" "$NESTED_DERIVED" \
            2>&1 | tee "$NESTED_EVIDENCE/console-source-preflight.log"
      - name: Select the official Xcode toolchain
        run: ./scripts/select-ci-xcode.sh
      - name: Check Metal and install official Rust dependencies
        timeout-minutes: 15
        run: |
          ./scripts/ensure-metal-toolchain.sh
          ./scripts/install-rust-ci.sh
      - name: Fetch checksum-pinned GhosttyKit
        timeout-minutes: 17
        run: |
          test "$(awk '$1 == "ef4f1570d62117ebc51e3b0f07ad4f34032267b6" {print $2}' scripts/ghosttykit-checksums.txt)" = ae38ade4e1c7e4d6ce21b8d7c16e9a95c346005848b4e2daa2afb6f56084c024
          ./scripts/download-prebuilt-ghosttykit.sh
          test -d GhosttyKit.xcframework
      - name: Reconstruct the accepted base and add only the new restore tests
        run: |
          python3 -BE "$NATIVE_PREPARATION/source_chain.py" base "$NATIVE_PREPARATION" "$CMUX_CI_RUNTIME_SOURCE_ROOT" "$NESTED_EVIDENCE"
          python3 -BE "$NATIVE_PREPARATION/source_chain.py" red "$NATIVE_PREPARATION" "$CMUX_CI_RUNTIME_SOURCE_ROOT" "$NESTED_EVIDENCE"
          ./scripts/sync-test-wiring --check
          python3 scripts/verify-local.py --only test-wiring --only swift-syntax --swift-changed HEAD~1
      - name: Compile the red app and complete test product
        timeout-minutes: 150
        env:
          NESTED_PHASE: red
        run: bash "$NATIVE_PREPARATION/compile-focused.sh"
      - name: Prepare the isolated native test home
        id: prepare
        run: ./scripts/ci/prepare-app-host-home.sh
      - name: Enable official XCTest automation
        run: ./scripts/ci/enable-xctest-automation-mode.sh
      - name: Require the two real restore assertion failures
        timeout-minutes: 10
        env:
          NESTED_PHASE: red
        run: bash "$NATIVE_PREPARATION/run-focused.sh"
      - name: Apply the complete reviewed startup fix and new feature tests
        run: |
          python3 -BE "$NATIVE_PREPARATION/source_chain.py" green "$NATIVE_PREPARATION" "$CMUX_CI_RUNTIME_SOURCE_ROOT" "$NESTED_EVIDENCE"
          ./scripts/sync-test-wiring --check
          python3 scripts/verify-local.py --only test-wiring --only swift-syntax --swift-changed HEAD~1
      - name: Compile green using the same DerivedData and official wrapper
        timeout-minutes: 60
        env:
          NESTED_PHASE: green
        run: bash "$NATIVE_PREPARATION/compile-focused.sh"
      - name: Require all restore tests to pass with the identical command
        timeout-minutes: 10
        env:
          NESTED_PHASE: green
        run: bash "$NATIVE_PREPARATION/run-focused.sh"
      - name: Exercise signed icon policy and preserved official defaults
        timeout-minutes: 10
        env:
          NESTED_PHASE: icon
        run: bash "$NATIVE_PREPARATION/run-focused.sh"
      - name: Recheck the original Herdr restore regressions on this new tree
        timeout-minutes: 10
        env:
          NESTED_PHASE: regression
        run: bash "$NATIVE_PREPARATION/run-focused.sh"
      - name: Recheck Herdr startup boundaries on this new tree
        timeout-minutes: 10
        env:
          NESTED_PHASE: boundary
        run: bash "$NATIVE_PREPARATION/run-focused.sh"
      - name: Recheck all original Herdr binding cases
        timeout-minutes: 10
        env:
          NESTED_PHASE: existing-binding
        run: bash "$NATIVE_PREPARATION/run-focused.sh"
      - name: Clean up only the prepared app-host state
        if: always() && (steps.prepare.outcome == 'success' || steps.prepare.outcome == 'failure' || steps.prepare.outcome == 'cancelled')
        run: |
          bash "$NATIVE_PREPARATION/console-in-source.sh" "$CMUX_CI_RUNTIME_SOURCE_ROOT/scripts/ci/cleanup-app-host-home.sh" \
            2>&1 | tee "$NESTED_EVIDENCE/app-host-cleanup.log"
      - name: Recheck the six package startup input policy cases
        timeout-minutes: 17
        run: bash "$NATIVE_PREPARATION/run-package.sh"
      - name: Export bounded lossless native evidence
        if: always()
        working-directory: ${{ github.workspace }}
        run: >-
          python3 -BE preparation/integrations/cmux-natural-start/native/evidence_native.py export
          --preparation preparation/integrations/cmux-natural-start/native
          --evidence "$RUNNER_TEMP/cmux-natural-native-evidence"
          --output "$RUNNER_TEMP/cmux-natural-native-small"
      - name: Retain the original native evidence
        id: native_upload
        if: always()
        uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f
        with:
          name: cmux-natural-native-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/cmux-natural-native-small
          if-no-files-found: error
          retention-days: 30

  release:
    needs: native
    runs-on: macos-26
    timeout-minutes: 240
    steps:
      - name: Checkout the same reviewed preparation
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: ${{ github.sha }}
          path: preparation
          persist-credentials: false
      - name: Obtain and authenticate this attempt's native evidence
        id: native_download
        env:
          GH_TOKEN: ${{ github.token }}
          NATIVE_ARTIFACT_ID: ${{ needs.native.outputs.artifact_id }}
          NATIVE_ARTIFACT_DIGEST: ${{ needs.native.outputs.artifact_digest }}
        run: >-
          python3 -BE preparation/integrations/cmux-natural-start/native/download_native.py
          --artifact-id "$NATIVE_ARTIFACT_ID" --artifact-digest "$NATIVE_ARTIFACT_DIGEST"
          --output "$RUNNER_TEMP/cmux-natural-native-admitted"
      - name: Check the exact source prerequisites without app consumption
        run: >-
          python3 -BE preparation/integrations/cmux-natural-start/package/release_build.py
          --source "$GITHUB_WORKSPACE/cmux-source"
          --output "$RUNNER_TEMP/cmux-natural-release/build"
      - name: Checkout the fixed upstream source
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          repository: manaflow-ai/cmux
          ref: 2e109a1739d320fe36220afb3e7775b59c1acd47
          submodules: recursive
          fetch-depth: 1
          path: cmux-source
          persist-credentials: false
      - name: Set up the original Release Bun dependency
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6
        with:
          bun-version: "1.3.14"
      - name: Set up the original Release Go dependency
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e
        with:
          go-version: "1.26.x"
          cache: false
      - name: Build one new Release package and verify two ordinary launches
        id: pipeline
        env:
          GH_TOKEN: ${{ github.token }}
        run: >-
          python3 -BE preparation/integrations/cmux-natural-start/package/ci_release.py
          --source "$GITHUB_WORKSPACE/cmux-source"
          --native-evidence "$RUNNER_TEMP/cmux-natural-native-admitted"
          --output "$RUNNER_TEMP/cmux-natural-release"
      - name: Admit the new immutable App archive for retention
        id: archive
        if: always() && steps.pipeline.outcome != 'skipped'
        run: >-
          python3 -BE preparation/integrations/cmux-natural-start/package/evidence_release.py
          --attempt "$RUNNER_TEMP/cmux-natural-release" --check-app-upload
      - name: Retain the full new App only on GitHub
        id: app
        if: always() && steps.archive.outputs.ready == 'true'
        uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f
        with:
          name: cmux-release-app-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/cmux-natural-release/package/cmux-release.zip
          compression-level: 0
          if-no-files-found: error
          retention-days: 30
      - name: Bind the actual App upload and export exact small evidence
        if: always() && steps.pipeline.outcome != 'skipped'
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_APP_ARTIFACT_ID: ${{ steps.app.outputs.artifact-id }}
          RELEASE_APP_ARTIFACT_DIGEST: ${{ steps.app.outputs.artifact-digest }}
          RELEASE_APP_ARTIFACT_URL: ${{ steps.app.outputs.artifact-url }}
        run: >-
          python3 -BE preparation/integrations/cmux-natural-start/package/evidence_release.py
          --attempt "$RUNNER_TEMP/cmux-natural-release"
          --output "$RUNNER_TEMP/cmux-natural-release-small"
      - name: Retain small Release and runtime evidence
        if: always() && steps.pipeline.outcome != 'skipped'
        uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f
        with:
          name: cmux-release-evidence-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/cmux-natural-release-small
          if-no-files-found: error
          retention-days: 30
      - name: Retain the original native transfer receipts even if admission fails
        if: always() && steps.native_download.outcome != 'skipped'
        uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f
        with:
          name: cmux-native-transfer-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/cmux-natural-native-admitted-download/REQUEST.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/VERIFIED.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/run-metadata/INTENT.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/run-metadata/RESULT.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/run-metadata/response.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/run-metadata/stderr
            ${{ runner.temp }}/cmux-natural-native-admitted-download/artifact-metadata/INTENT.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/artifact-metadata/RESULT.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/artifact-metadata/response.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/artifact-metadata/stderr
            ${{ runner.temp }}/cmux-natural-native-admitted-download/archive/INTENT.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/archive/RESULT.json
            ${{ runner.temp }}/cmux-natural-native-admitted-download/archive/stderr
          if-no-files-found: warn
          retention-days: 30
