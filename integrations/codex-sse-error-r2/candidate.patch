+/// A standalone error ends the current stream. Preserve its typed wire fields
+/// without inventing an HTTP status or changing the existing semantic classifier.
+pub(super) fn parse_error_event(error: Option<Value>) -> ApiError {
+    if let Some(error) = error.as_ref().and_then(parse_flex_unavailable) {
+        return error;
+    }
+    let Some(fields) = error.as_ref().and_then(ResponseError::from_value) else {
+        return ApiError::Stream("malformed Responses error event".to_string());
+    };
+    ApiError::ResponseError {
+        error: fields,
+        source: Box::new(parse_failed_response(Some(
+            serde_json::json!({ "error": error }),
+        ))),
+    }
 }
 
