+//! Exercises the actual SSE reader and bridge, never a replacement parser.
+
+use super::process_sse;
+use super::spawn_response_stream;
+use crate::api_bridge::map_api_error;
+use crate::common::ResponseEvent;
+use crate::error::ApiError;
+use bytes::Bytes;
+use codex_client::StreamResponse;
+use codex_client::TransportError;
+use codex_protocol::error::CodexErrorDetails;
+use codex_protocol::protocol::CodexErrorInfo;
+use futures::StreamExt;
+use futures::stream;
+use http::HeaderMap;
+use http::StatusCode;
+use serde_json::json;
+use std::time::Duration;
+use tokio::sync::mpsc;
+
+async fn terminal_error(body: String, keep_open: bool) -> ApiError {
+    let chunks = stream::once(async move { Ok(Bytes::from(body)) });
+    let bytes: codex_client::ByteStream = if keep_open {
+        Box::pin(chunks.chain(stream::pending()))
+    } else {
+        Box::pin(chunks)
+    };
+    let mut events = spawn_response_stream(
+        StreamResponse {
+            status: StatusCode::OK,
+            headers: HeaderMap::new(),
+            bytes,
+        },
+        Duration::from_secs(60),
+        None,
+        None,
+    );
+    // A hanging error stream must finish before its 60-second idle timeout.
+    let error = tokio::time::timeout(Duration::from_secs(1), async {
+        loop {
+            match events.next().await {
+                Some(Ok(ResponseEvent::RateLimits(_))) => {}
+                Some(Err(error)) => break error,
+                other => panic!("expected terminal error, got {other:?}"),
+            }
+        }
+    })
+    .await
+    .expect("error event waited for EOF or idle timeout");
+    assert!(events.next().await.is_none());
+    error
+}
+
+#[tokio::test(start_paused = true)]
+async fn writer_error_is_preserved_for_http_and_sse() {
+    for (status, code) in [
+        (
+            StatusCode::SERVICE_UNAVAILABLE,
+            "continuation_writer_unavailable",
+        ),
+        (StatusCode::UNAUTHORIZED, "continuation_writer_unauthorized"),
+        (StatusCode::FORBIDDEN, "continuation_writer_forbidden"),
+    ] {
+        let error = json!({"type":"server_error", "code":code, "message":"writer unavailable"});
+        let http = map_api_error(ApiError::Transport(TransportError::Http {
+            status,
+            url: None,
+            headers: None,
+            retry_after: None,
+            body: Some(json!({"error":error}).to_string()),
+        }));
+        assert_eq!(http.http_status_code_value(), Some(status.as_u16()));
+        assert_eq!(http.response_error().unwrap().code.as_deref(), Some(code));
+        for prefix in ["event: error\n", ""] {
+            let body = format!(
+                "{prefix}data: {}\n\n",
+                json!({"type":"error", "error":error})
+            );
+            let sse = map_api_error(terminal_error(body, true).await);
+            assert_eq!(sse.response_error(), http.response_error());
+            assert!(matches!(sse.details(), CodexErrorDetails::Stream(_)));
+            assert_eq!(sse.http_status_code_value(), None);
+            assert!(sse.retry_delay(1).is_some());
+        }
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn flat_and_nested_errors_end_before_later_completion() {
+    for value in [
+        json!({"type":"error", "code":"writer_commit_unavailable", "message":"withheld"}),
+        json!({"error":{"code":"writer_commit_unavailable", "message":"withheld"}}),
+        json!({"type":"error", "error":{"code":"writer_commit_unavailable", "message":"withheld"}, "delta":7}),
+    ] {
+        let body = format!(
+            "event: error\ndata: {value}\n\ndata: {{\"type\":\"response.completed\",\"response\":{{\"id\":\"must-not-complete\"}}}}\n\n"
+        );
+        let err = map_api_error(terminal_error(body, true).await);
+        assert_eq!(
+            err.response_error().unwrap().code.as_deref(),
+            Some("writer_commit_unavailable")
+        );
+    }
+    // Invalid unrelated optional fields must not swallow data-only error frames.
+    let body = "data: {\"type\":\"error\",\"error\":{\"code\":\"writer_commit_unavailable\"},\"delta\":7}\n\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"later\"}}\n\n";
+    assert_eq!(
+        map_api_error(terminal_error(body.to_owned(), false).await)
+            .response_error()
+            .unwrap()
+            .code
+            .as_deref(),
+        Some("writer_commit_unavailable")
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn malformed_named_errors_are_not_ignored() {
+    for data in [
+        "not json",
+        "null",
+        "[]",
+        "{}",
+        r#"{"type":"response.completed","response":{"id":"conflict"}}"#,
+        r#"{"type":"error","error":{"code":42,"message":"bad code"}}"#,
+        r#"{"type":"error","error":null}"#,
+    ] {
+        let body = format!(
+            "event: error\ndata: {data}\n\ndata: {{\"type\":\"response.completed\",\"response\":{{\"id\":\"later\"}}}}\n\n"
+        );
+        let err = map_api_error(terminal_error(body, true).await);
+        assert!(matches!(err.details(), CodexErrorDetails::Stream(_)));
+        assert!(err.response_error().is_none());
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn error_at_eof_preserves_code_and_retry_deadline() {
+    let body = "data: {\"type\":\"error\",\"error\":{\"code\":\"continuation_writer_unavailable\",\"headers\":{\"retry-after\":\"7\"}}}\n\n";
+    let err = map_api_error(terminal_error(body.to_owned(), false).await);
+    assert_eq!(
+        err.response_error().unwrap().code.as_deref(),
+        Some("continuation_writer_unavailable")
+    );
+    assert_eq!(err.retry_delay(1), Some(Duration::from_secs(7)));
+}
+
+#[tokio::test(start_paused = true)]
+async fn flex_and_quota_keep_existing_terminal_semantics() {
+    for (code, expected) in [
+        ("flex_unavailable", CodexErrorInfo::FlexUnavailable),
+        ("insufficient_quota", CodexErrorInfo::UsageLimitExceeded),
+    ] {
+        let body = format!(
+            "data: {}\n\n",
+            json!({"type":"error", "error":{"code":code,"headers":{"retry-after":"7"}}})
+        );
+        let err = map_api_error(terminal_error(body, true).await);
+        assert_eq!(err.to_codex_protocol_error(), expected);
+        assert!(err.retry_delay(1).is_none());
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn receiver_cancellation_still_releases_pending_reader() {
+    let (tx, rx) = mpsc::channel(1);
+    let worker = tokio::spawn(process_sse(
+        Box::pin(stream::pending()),
+        tx,
+        Duration::from_secs(60),
+        None,
+    ));
+    drop(rx);
+    tokio::time::timeout(Duration::from_secs(1), worker)
+        .await
+        .unwrap()
+        .unwrap();
+}
+
+#[test]
+fn malformed_http_diagnostic_does_not_create_structured_code() {
+    let err = map_api_error(ApiError::Transport(TransportError::Http {
+        status: StatusCode::FORBIDDEN,
+        url: None,
+        headers: None,
+        retry_after: None,
+        body: Some(r#"{"error":{"code":42,"message":"forbidden"}}"#.into()),
+    }));
+    assert_eq!(err.http_status_code_value(), Some(403));
+    assert!(err.response_error().is_none());
+}
+
+#[test]
+fn all_unit_constructors_and_annotations_preserve_error_metadata() {
+    use codex_protocol::error::AgentErrorContext;
+    use codex_protocol::error::CodexErr;
+    use codex_protocol::error::ResponseError;
+
+    for error in [
+        CodexErr::TurnAborted,
+        CodexErr::SessionBudgetExceeded,
+        CodexErr::ContextWindowExceeded,
+        CodexErr::SessionConfiguredNotFirstEvent,
+        CodexErr::Timeout,
+        CodexErr::RequestTimeout,
+        CodexErr::Spawn,
+        CodexErr::Interrupted,
+        CodexErr::ServerOverloaded,
+        CodexErr::QuotaExceeded,
+        CodexErr::UsageNotIncluded,
+        CodexErr::InternalServerError,
+        CodexErr::InternalAgentDied,
+        CodexErr::LandlockSandboxExecutableNotProvided,
+        CodexErr::new(CodexErrorDetails::Timeout),
+        CodexErr::Stream("same semantics".into()),
+    ] {
+        assert!(error.response_error().is_none());
+        let kind = error.to_codex_protocol_error();
+        let fields = ResponseError {
+            code: Some("continuation_writer_unavailable".into()),
+            error_type: Some("server_error".into()),
+            message: Some("metadata only".into()),
+        };
+        let error = error
+            .with_response_error(fields.clone())
+            .with_retry_after(
+                codex_http_client::RetryAfter::from_delay(Duration::from_secs(3)).unwrap(),
+            )
+            .with_agent_context(AgentErrorContext::ChildStartup);
+        assert_eq!(error.response_error(), Some(&fields));
+        assert_eq!(error.to_codex_protocol_error(), kind);
+        assert_eq!(error.agent_context(), Some(AgentErrorContext::ChildStartup));
+        assert!(error.retry_after().is_some());
+        // Formatting borrows the error and keeps the same behavior and metadata.
+        let _ = format!("{error:?} {error}");
+        assert_eq!(error.response_error(), Some(&fields));
+    }
+}
