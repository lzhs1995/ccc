+        .open(root.join(format!(
+            "client-{}-{}.lock",
+            std::process::id(),
+            before["client_epoch"].as_str().unwrap()
+        )))?;
+    assert_eq!(
+        unsafe { libc::flock(lock.as_raw_fd(), libc::LOCK_SH | libc::LOCK_NB) },
+        0
+    );
