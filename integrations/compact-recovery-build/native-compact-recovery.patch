+async fn native_compaction_settles_received_usage_once_under_original_goal_reservation()
+-> anyhow::Result<()> {
+    let runtime = test_runtime().await?;
+    let thread_id = test_thread_id()?;
+    seed_thread_metadata(runtime.as_ref(), thread_id).await?;
+    let harness = GoalExtensionHarness::new(runtime.clone(), thread_id).await?;
+    let tools = harness.tools();
+    tool_by_name(&tools, "create_goal")
+        .handle(tool_call(
+            "create_goal",
+            "original-goal",
+            json!({"objective":"same original Goal","token_budget":123}),
+        ))
+        .await?;
+    harness.start_turn("turn-1", &TokenUsage::default()).await;
+    let handle = harness.runtime_handle();
+    let before = handle
+        .compaction_recovery_goal_snapshot()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let guard = handle
+        .compaction_recovery_goal_guard(&before)
+        .await
+        .map_err(anyhow::Error::msg)?;
+    // This is the real Goal token contributor invoked by received provider usage,
+    // not a fabricated database update or a replacement Goal.
+    harness
+        .record_token_usage("turn-1", &input_token_usage(11))
+        .await;
+    let settled = guard
+        .settle_original_usage("turn-1", "original-control-attempt")
+        .await
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(settled["goalId"], before["goalId"]);
+    assert_eq!(settled["objective"], before["objective"]);
+    assert_eq!(settled["tokenBudget"], 123);
+    assert_eq!(settled["tokensUsed"], 11);
+    assert_eq!(settled["status"], "active");
+    assert!(
+        guard
+            .settle_original_usage("turn-1", "original-control-attempt")
+            .await
+            .is_err()
+    );
+    drop(guard);
+    harness
+        .notify_tool_finish("turn-1", "later-original-tool", "ordinary_tool")
+        .await;
+    let after = runtime
+        .thread_goals()
+        .get_thread_goal(thread_id)
+        .await?
+        .expect("original Goal");
+    assert_eq!(after.tokens_used, 11);
+    assert_eq!(after.token_budget, Some(123));
+    Ok(())
+}
+
+#[tokio::test]
+async fn native_compaction_drain_usage_exhausting_original_budget_refuses_replacement_without_reset()
+-> anyhow::Result<()> {
