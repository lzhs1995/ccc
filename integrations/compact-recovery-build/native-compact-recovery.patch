+    let wakes = Arc::new(WakeCount(AtomicUsize::new(0)));
+    let waker = Waker::from(wakes.clone());
+    assert!(
+        Pin::new(&mut wait)
+            .poll(&mut Context::from_waker(&waker))
+            .is_pending()
+    );
+    ctl.claim(&id, "a").unwrap();
+    assert_eq!(wakes.0.load(Ordering::SeqCst), 1);
+}
