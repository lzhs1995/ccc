+    assert_eq!(ctl.snapshot().unwrap().phase, Phase::Unknown);
+    assert_eq!(ctl.claim(&id, "a"), Err(Refused::AttemptConsumed));
+    assert_eq!(ctl.claim(&id, "b"), Err(Refused::NotWaiting));
+}
