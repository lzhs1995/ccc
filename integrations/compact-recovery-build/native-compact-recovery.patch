+    // The held ASCII key has not reached the textarea while the native lock is held.
+    assert_eq!(fixture.app.chat_widget.composer_text_with_pending(), "");
+    assert_eq!(unsafe { libc::flock(lock.as_raw_fd(), libc::LOCK_UN) }, 0);
