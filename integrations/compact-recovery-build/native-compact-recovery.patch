+use super::*;
+use std::os::unix::fs::symlink;
+use std::os::unix::fs::PermissionsExt;
+struct Fixture {
+    _socket: super::super::compaction_socket::NativeControlServer,
+    _home: tempfile::TempDir,
+    home: PathBuf,
