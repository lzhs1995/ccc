+    registry
+        .live
+        .lock()
+        .unwrap()
+        .as_mut()
+        .unwrap()
+        .original_started = std::time::Instant::now() - Duration::from_secs(299);
+    assert!(
+        session
+            .handle_compaction_recovery(Some(request.clone()))
+            .await
+            .unwrap_err()
