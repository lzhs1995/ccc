+use super::*;
+
+fn retained_release_server() -> (
+    HeadlessServer,
+    crate::layout::PaneId,
+    crate::terminal::TerminalId,
+) {
+    let mut server = test_headless_server();
+    server.app.state.workspaces = vec![crate::workspace::Workspace::test_new("recovery")];
+    server.app.state.ensure_test_terminals();
+    server.app.state.active = Some(0);
+    let pane_id = server.app.state.workspaces[0].tabs[0].root_pane;
+    let terminal_id = server.app.state.workspaces[0].tabs[0].panes[&pane_id]
+        .attached_terminal_id
+        .clone();
+    server.handle_internal_event_with_forwarding(AppEvent::AgentProcessDetected {
+        pane_id,
+        agent: crate::detect::Agent::Antigravity,
+        observed_at: Instant::now(),
+    });
+    let public_pane_id = server.app.public_pane_id(0, pane_id).unwrap();
+    completion_guard_api_report(
+        &mut server,
+        api::schema::Method::PaneReportAgentSession(api::schema::PaneReportAgentSessionParams {
+            pane_id: public_pane_id,
+            source: "herdr:antigravity_cli".into(),
+            agent: "agy".into(),
+            seq: Some(10),
+            agent_session_id: Some("simulated-retained".into()),
+            agent_session_path: None,
+            session_start_source: Some("startup".into()),
+            resume_argv: Some(vec![
+                "agy".into(),
+                "--conversation".into(),
+                "simulated-retained".into(),
+            ]),
+        }),
+    );
+    assert!(server.app.state.terminals[&terminal_id]
+        .recovery
+        .record()
+        .unwrap()
+        .automatic);
+    (server, pane_id, terminal_id)
+}
+
+fn retained_release_passive_exit(server: &mut HeadlessServer, pane_id: crate::layout::PaneId) {
+    server.handle_internal_event_with_forwarding(AppEvent::StateChanged {
+        pane_id,
+        agent: Some(crate::detect::Agent::Antigravity),
+        state: crate::detect::AgentState::Idle,
+        visible_blocker: false,
+        visible_working: false,
+        process_exited: true,
+        observed_at: Instant::now(),
+    });
+}
+
+fn retained_release_api(
+    server: &mut HeadlessServer,
+    pane_id: crate::layout::PaneId,
+    source: &str,
+    agent: &str,
+    seq: Option<u64>,
+) {
+    let public_pane_id = server.app.public_pane_id(0, pane_id).unwrap();
+    completion_guard_api_report(
+        server,
+        api::schema::Method::PaneReleaseAgent(api::schema::PaneReleaseAgentParams {
+            pane_id: public_pane_id,
+            source: source.into(),
+            agent: agent.into(),
+            seq,
+        }),
+    );
+}
