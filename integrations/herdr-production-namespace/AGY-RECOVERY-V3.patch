+fn saved_agent_session(pane: &super::snapshot::PaneSnapshot) -> Option<&PaneAgentSessionSnapshot> {
+    if let Some(recovery) = &pane.agent_recovery {
+        if !recovery.automatic || recovery.to_record().is_none() { return None; }
+        let session = recovery.session.as_ref()?;
+        if pane.agent_session.as_ref().is_some_and(|active| active != session) { return None; }
+        return Some(session);
+    }
+    pane.agent_session.as_ref() // legacy snapshots remain readable
+}
+
+fn saved_launch_argv(pane: &super::snapshot::PaneSnapshot) -> Option<Vec<String>> {
+    // New identity-aware snapshots resume only through the checked plan. Raw
+    // launch argv may still name a previous conversation and cannot bypass it.
+    if pane.agent_recovery.is_some() { return None; }
+    pane.launch_argv.clone()
+}
+
+fn restore_recovery_record(terminal: &mut TerminalState,
+    pane: Option<&super::snapshot::PaneSnapshot>, duplicate: bool, imported: bool,
+) {
+    if let Some(pane) = pane {
+        if let Some(recovery) = &pane.agent_recovery {
+            let record = recovery.to_record();
+            let saved_is_allowed = saved_agent_session(pane).is_some();
+            terminal.recovery.restore(record);
+            if !saved_is_allowed || duplicate { terminal.recovery.invalidate(); }
+        } else if duplicate {
+            // Persist the refusal even for a legacy duplicate with no new field.
+            terminal.recovery.invalidate();
+        } else if let (Some(session), Some(resume)) =
+            (pane.agent_session.as_ref(), saved_reported_resume(pane)) {
+            // One-time migration of the original legacy pair. Live unbound
+            // reports never use this trusted snapshot-only path.
+            if let Some(identity) = persisted_agent_session_from_snapshot(session) {
+                if resume.source == identity.source && resume.agent == identity.agent {
+                    terminal.recovery.bind_resume(&identity, terminal.recovery.epoch(),
+                        reported_resume_from_snapshot(resume));
+                }
+            }
+        }
+    }
+    // A live imported terminal may contain a newer identity. Keep its original
+    // active authority; never attach the saved old argv to that identity.
+    if imported { terminal.reconcile_restored_recovery(); }
+    if terminal.recovery.blocked() { terminal.launch_argv = None; }
+}
