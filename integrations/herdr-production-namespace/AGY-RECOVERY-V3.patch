+    fn late_same_identity_from_previous_runtime_epoch_is_rejected() {
+        let mut state = bound(); let epoch = state.epoch();
+        state.end_generation();
+        assert!(state.record().unwrap().automatic);
+        assert!(!state.bind_resume(&A, epoch, vec!["stale"]));
+    }
+    #[test]
+    fn invalid_snapshot_stays_blocked_across_repeated_restore() {
+        let mut state = State::default(); state.restore(None);
+        assert!(state.blocked());
+        let mut second = State::default(); second.restore(state.record().cloned());
+        assert!(second.blocked());
+        assert!(!second.bind_resume(&A, second.epoch(), vec!["old"]));
+    }
+    #[test]
+    fn tombstone_survives_save_restore() {
+        let mut state = bound(); state.invalidate();
+        let mut restored = State::default(); restored.restore(state.record().cloned());
+        assert!(!restored.record().unwrap().automatic);
+        assert_eq!(state.record(), restored.record());
+    }
