+/// Saved recovery intent is never used as live agent authority.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PaneAgentRecoverySnapshot {
+    pub version: u8,
+    #[serde(default)]
+    pub session: Option<PaneAgentSessionSnapshot>,
+    pub resume: Option<PaneAgentResumeSnapshot>,
+    pub automatic: bool,
+}
+
+impl PaneAgentRecoverySnapshot {
+    pub fn from_state(state: &crate::terminal::recovery::RecoveryState<
+        crate::agent_resume::PersistedAgentSession, crate::agent_resume::ReportedAgentResume,
+    >) -> Option<Self> {
+        let Some(record) = state.record() else {
+            return state.blocked().then_some(Self { version: 1, automatic: false, session: None, resume: None });
+        };
+        Some(Self { version: 1, automatic: record.automatic && !state.blocked(),
+            session: Some(PaneAgentSessionSnapshot {
+                source: record.identity.source.clone(), agent: record.identity.agent.clone(),
+                kind: record.identity.session_ref.kind, value: record.identity.session_ref.value.clone(),
+            }),
+            resume: record.resume.as_ref().map(|resume| PaneAgentResumeSnapshot {
+                source: resume.source.clone(), agent: resume.agent.clone(), argv: resume.argv.clone(),
+            }),
+        })
+    }
+
+    pub fn to_record(&self) -> Option<crate::terminal::recovery::RecoveryRecord<
+        crate::agent_resume::PersistedAgentSession, crate::agent_resume::ReportedAgentResume,
+    >> {
+        if self.version != 1 { return None; }
+        let session = self.session.as_ref()?;
+        let identity = crate::agent_resume::session_ref_from_snapshot(
+            &session.source, &session.agent, session.kind, &session.value)?;
+        let resume = if let Some(resume) = &self.resume {
+            if resume.source != identity.source || resume.agent != identity.agent
+                || crate::agent_resume::validate_resume_argv(&resume.argv).is_err() { return None; }
+            Some(crate::agent_resume::ReportedAgentResume {
+                source: resume.source.clone(), agent: resume.agent.clone(), argv: resume.argv.clone(),
+            })
+        } else { None };
+        Some(crate::terminal::recovery::RecoveryRecord { identity, resume, automatic: self.automatic })
+    }
 }
 
