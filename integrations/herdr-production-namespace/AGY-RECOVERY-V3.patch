+#[test]
+fn recovery_durability_api_official_release_after_exit_saves_tombstone() {
+    let (mut server, pane_id, terminal_id) = retained_release_server();
+    retained_release_passive_exit(&mut server, pane_id);
+    let before = server.app.state.terminals[&terminal_id].recovery.record().unwrap().clone();
+    let terminal = &server.app.state.terminals[&terminal_id];
+    assert!(terminal.hook_authority.is_none());
+    assert!(terminal.persisted_agent_session.is_none());
+    assert!(terminal.effective_agent_label().is_none());
+    assert!(before.automatic);
+    server.app.state.session_dirty = false;
+
+    retained_release_api(&mut server, pane_id, "herdr:antigravity_cli", "agy", Some(11));
+
+    let terminal = &server.app.state.terminals[&terminal_id];
