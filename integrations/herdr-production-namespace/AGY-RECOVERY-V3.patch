+//! Durable recovery intent, separate from current terminal authority.
+//! This module is dependency-free so its exact transition rules can be tested
+//! with rustc --test without building the terminal renderer or native agents.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RecoveryRecord<I, R> {
+    pub identity: I,
+    pub resume: Option<R>,
+    pub automatic: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RecoveryState<I, R> {
+    record: Option<RecoveryRecord<I, R>>,
+    revision: u64,
+    epoch: u64,
+    blocked: bool,
+}
+
+impl<I: Clone + Eq, R: Clone + Eq> Default for RecoveryState<I, R> {
+    fn default() -> Self { Self { record: None, revision: 0, epoch: 0, blocked: false } }
+}
+
+impl<I: Clone + Eq, R: Clone + Eq> RecoveryState<I, R> {
+    pub fn record(&self) -> Option<&RecoveryRecord<I, R>> { self.record.as_ref() }
+    pub fn revision(&self) -> u64 { self.revision }
+    pub fn epoch(&self) -> u64 { self.epoch }
+    pub fn blocked(&self) -> bool { self.blocked }
+    /// In-memory terminal generation, never a claim about process identity.
+    /// Existing active-state gates still authenticate the reporter.
+    pub fn end_generation(&mut self) {
+        self.epoch = self.epoch.wrapping_add(1);
+        self.revision = self.revision.wrapping_add(1);
+    }
+
+    /// Called only after the existing native report/sequence gates accept.
+    /// A different identity or explicit rearm starts without the old argv.
+    pub fn accept_session(&mut self, identity: I) -> bool {
+        if self.record.as_ref().is_some_and(|r| r.identity == identity && r.automatic) {
+            return false;
+        }
+        self.end_generation();
+        self.blocked = false;
+        self.record = Some(RecoveryRecord { identity, resume: None, automatic: true });
+        self.revision = self.revision.wrapping_add(1);
+        true
+    }
+
+    /// Bind argv to the full accepted source/agent/session identity, not agent only.
+    pub fn binding_matches(&self, identity: &I, epoch: u64) -> bool {
+        !self.blocked && self.epoch == epoch
+            && self.record.as_ref().is_some_and(|r| r.automatic && &r.identity == identity)
+    }
+
+    pub fn bind_resume(&mut self, identity: &I, epoch: u64, resume: R) -> bool {
+        if !self.binding_matches(identity, epoch) { return false; }
+        let Some(record) = self.record.as_mut() else { return false; };
+        if !record.automatic || &record.identity != identity { return false; }
+        if record.resume.as_ref() == Some(&resume) { return false; }
+        record.resume = Some(resume);
+        self.revision = self.revision.wrapping_add(1);
+        true
+    }
+
+    /// Explicit release or a different occupant revokes automatic reuse.
+    /// Retain the record as a recovery locator, never as current authority.
+    pub fn invalidate(&mut self) -> bool {
+        let changed = !self.blocked || self.record.as_ref().is_some_and(|r| r.automatic);
+        self.blocked = true;
+        if let Some(record) = self.record.as_mut() { record.automatic = false; }
+        if changed { self.end_generation(); }
+        changed
+    }
+
+    /// Import a saved intent into a fresh in-memory generation.
+    /// A present but invalid snapshot is a durable block, never legacy absence.
+    pub fn restore(&mut self, record: Option<RecoveryRecord<I, R>>) {
+        self.blocked = record.as_ref().map_or(true, |r| !r.automatic);
+        self.record = record;
+        self.end_generation();
+    }
+}
