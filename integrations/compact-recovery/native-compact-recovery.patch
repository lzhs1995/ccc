+    let collected = match result {
+        Ok(collected) => collected,
+        Err(error) => {
+            if let CodexErrorDetails::ResponseIncomplete(incomplete) = error.details() {
+                match request_kind {
+                    CompactionRequestKind::Background(_) => {
+                        if let Some(usage) = incomplete.token_usage.as_ref() {
+                            let _ = sess.record_rollout_budget_usage(usage).await;
+                        }
+                    }
+                    CompactionRequestKind::Foreground => {
+                        sess.record_incomplete_response_usage(
+                            turn_context,
+                            &turn_context.initial_settings,
+                            incomplete,
+                        )
+                        .await;
+                        sess.send_token_count_event(turn_context).await;
+                    }
+                }
+            }
+            return Err(error);
+        }
+    };
+    // Retire native recovery eligibility before the first accounting mutation.
+    // Charge observed completion even when its compaction payload is invalid.
+    match request_kind {
+        CompactionRequestKind::Background(_) => {
+            if let Some(usage) = collected.token_usage.as_ref() {
+                sess.record_rollout_budget_usage(usage).await?;
+            }
+        }
+        CompactionRequestKind::Foreground => {
+            sess.record_observed_response_completed(
+                turn_context,
+                &collected.response_id,
+                collected.token_usage.as_ref(),
+                collected.usage_metadata.as_ref(),
+            )
+            .await;
+        }
+    }
+    if collected.compaction_count != 1 {
+        return Err(CodexErr::Fatal(format!(
+            "remote compaction v2 expected exactly one compaction output item, got {} from {} output items",
+            collected.compaction_count, collected.output_item_count,
+        )));
+    }
+    let Some(compaction_output) = collected.compaction_output else {
+        unreachable!("compaction output must exist when count is exactly one");
+    };
+    Ok(RemoteCompactionV2Output {
+        compaction_output,
+        response_id: collected.response_id,
+        token_usage: collected.token_usage,
+    })
