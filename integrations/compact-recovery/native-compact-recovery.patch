+    );
+    drop(reservation);
+    assert_eq!(ctl.snapshot().unwrap().phase, Phase::Unknown);
+    assert_eq!(
+        ctl.claim(&snapshot.identity, "factory-attempt"),
+        Err(Refused::AttemptConsumed)
+    );
+}
