+/// Experimental conditional recovery of one original native provider wait.
+/// Omit expected fields to query the current native identity without mutation.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ThreadCompactRecoveryParams {
+    pub thread_id: String,
+    pub expected_native_epoch: Option<String>,
+    pub expected_turn_id: Option<String>,
+    pub expected_occurrence: Option<String>,
+    pub expected_generation: Option<u64>,
+    pub attempt_id: Option<String>,
+    pub authority: Option<JsonValue>,
+}
+
+impl ThreadCompactRecoveryParams {
+    pub fn validate_original_shape(&self) -> Result<(), &'static str> {
+        let fields = [
+            self.expected_native_epoch.is_some(),
+            self.expected_turn_id.is_some(),
+            self.expected_occurrence.is_some(),
+            self.expected_generation.is_some(),
+            self.attempt_id.is_some(),
+            self.authority.is_some(),
+        ];
+        if fields.iter().all(|present| !*present) || fields.iter().all(|present| *present) {
+            Ok(())
+        } else {
+            Err(
+                "query has no control fields; control requires the complete original identity and native authority",
+            )
+        }
+    }
+}
+#[cfg(test)]
+mod compact_recovery_tests {
+    use super::ThreadCompactRecoveryParams;
+    use super::ThreadCompactStartResponse;
+
+    #[test]
+    fn legacy_empty_compact_response_keeps_extra_field_compatibility() {
+        let response: ThreadCompactStartResponse =
