+            serde_json::json!({})
+        );
+    }
+
+    #[test]
+    fn conditional_compaction_api_rejects_partial_identity_and_query_authority() {
+        let query: ThreadCompactRecoveryParams =
+            serde_json::from_value(serde_json::json!({"threadId":"original"})).unwrap();
+        assert!(query.validate_original_shape().is_ok());
+        let partial: ThreadCompactRecoveryParams = serde_json::from_value(
+            serde_json::json!({"threadId":"original","expectedGeneration":0}),
+        )
+        .unwrap();
+        assert!(partial.validate_original_shape().is_err());
+        let forged_query: ThreadCompactRecoveryParams =
+            serde_json::from_value(serde_json::json!({"threadId":"original","authority":{}}))
+                .unwrap();
+        assert!(forged_query.validate_original_shape().is_err());
+        assert!(
+            serde_json::from_value::<ThreadCompactRecoveryParams>(
+                serde_json::json!({"threadId":"original","force":true})
+            )
+            .is_err()
+        );
+    }
+}
