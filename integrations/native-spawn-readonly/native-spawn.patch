+use super::*;
+use std::io::BufRead;
+
+fn namespace() -> tempfile::TempDir {
+    let home = tempfile::Builder::new()
+        .prefix("ncc-")
+        .tempdir_in("/private/tmp")
+        .unwrap();
+    let dir = home
+        .path()
+        .join("credential-observations/compaction-recovery");
+    fs::create_dir_all(&dir).unwrap();
+    fs::set_permissions(&dir, fs::Permissions::from_mode(0o700)).unwrap();
+    let mut marker = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(dir.join("enabled-v1"))
+        .unwrap();
+    marker
+        .write_all(b"ccc-native-compaction-recovery-v1\n")
+        .unwrap();
+    home
+}
+
+fn query(home: &Path, body: &Value) -> Value {
+    let path = home.join(format!(
+        "credential-observations/compaction-recovery/client-{}-control.json",
+        std::process::id()
+    ));
+    let capability: Value = serde_json::from_slice(&fs::read(path).unwrap()).unwrap();
+    let mut stream = UnixStream::connect(capability["socket"].as_str().unwrap()).unwrap();
+    stream
+        .set_read_timeout(Some(Duration::from_secs(2)))
+        .unwrap();
+    stream.write_all(format!("{body}\n").as_bytes()).unwrap();
+    let mut reply = String::new();
+    std::io::BufReader::new(stream)
+        .read_line(&mut reply)
+        .unwrap();
+    serde_json::from_str(&reply).unwrap()
+}
+
+#[test]
+fn caller_route_uses_kernel_peer_and_never_dispatches_input() {
+    let home = namespace();
+    let epoch = uuid::Uuid::new_v4().to_string();
+    let challenge = uuid::Uuid::new_v4().to_string();
+    let dispatched = Arc::new(AtomicUsize::new(0));
+    let count = dispatched.clone();
+    let (tx, rx) = mpsc::sync_channel(1);
+    let _server = NativeControlServer::open_with_caller_observer(
+        home.path(),
+        &epoch,
+        ForegroundObserver::disabled(),
+        move |_| {
+            count.fetch_add(1, Ordering::SeqCst);
+        },
+        Some(Arc::new(move |pid, uid, birth, body| {
+            tx.send((pid, uid, birth.clone())).unwrap();
+            Ok(
+                json!({"scope":"caller-thread-readonly","challenge":body["challenge"],
+                "threadId":"fixture-child","foreground":null,"sendAuthority":false}),
+            )
+        })),
+    )
+    .unwrap();
+    let capability_path = home.path().join(format!(
+        "credential-observations/compaction-recovery/client-{}-control.json",
+        std::process::id()
+    ));
+    let capability: Value = serde_json::from_slice(&fs::read(capability_path).unwrap()).unwrap();
+    assert_eq!(
+        capability["methods"],
+        json!(["compaction/recovery/query", "compaction/recovery/control"])
+    );
+    assert_eq!(
+        capability["callerObservation"],
+        json!({
+        "schema":1,"method":"caller/thread/observe","scope":"caller-thread-readonly",
+        "requiresSameProcessSpawn":true})
+    );
+    let reply = query(
+        home.path(),
+        &json!({"method":"caller/thread/observe",
+        "challenge":challenge,"expectedClientEpoch":epoch}),
+    );
+    assert_eq!(reply["challenge"], challenge);
+    assert_eq!(reply["clientEpoch"], epoch);
+    assert_eq!(reply["threadId"], "fixture-child");
+    let (pid, uid, birth) = rx.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert_eq!(pid, std::process::id());
+    assert_eq!(uid, unsafe { libc::getuid() });
+    assert_eq!(birth, process_birth(pid).unwrap());
+    assert_eq!(dispatched.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn caller_epoch_mismatch_refuses_before_callback_or_dispatch() {
+    let home = namespace();
+    let calls = Arc::new(AtomicUsize::new(0));
+    let count = calls.clone();
+    let dispatch = calls.clone();
+    let _server = NativeControlServer::open_with_caller_observer(
+        home.path(),
+        &uuid::Uuid::new_v4().to_string(),
+        ForegroundObserver::disabled(),
+        move |_| {
+            dispatch.fetch_add(1, Ordering::SeqCst);
+        },
+        Some(Arc::new(move |_, _, _, _| {
+            count.fetch_add(1, Ordering::SeqCst);
+            Ok(json!({}))
+        })),
+    )
+    .unwrap();
+    let reply = query(
+        home.path(),
+        &json!({"method":"caller/thread/observe",
+        "expectedClientEpoch":uuid::Uuid::new_v4().to_string()}),
+    );
+    assert!(reply["error"].as_str().unwrap().contains("epoch"));
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn legacy_open_keeps_original_methods_without_caller_advertisement() {
+    let home = namespace();
+    let _server = NativeControlServer::open(
+        home.path(),
+        &uuid::Uuid::new_v4().to_string(),
+        ForegroundObserver::disabled(),
+        |_| {},
+    )
+    .unwrap();
+    let capability_path = home.path().join(format!(
+        "credential-observations/compaction-recovery/client-{}-control.json",
+        std::process::id()
+    ));
+    let capability: Value = serde_json::from_slice(&fs::read(capability_path).unwrap()).unwrap();
+    assert_eq!(
+        capability["methods"],
+        json!(["compaction/recovery/query", "compaction/recovery/control"])
+    );
+    assert!(capability.get("callerObservation").is_none());
+}
