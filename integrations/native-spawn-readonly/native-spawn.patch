+//! A narrow, optional observer for actual local command hooks.
+//! Core supplies the implementation; this crate never imports Core or grants input rights.
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::HookEventName;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeHookEvent {
+    PreToolUse,
+    PostToolUse,
+}
+impl NativeHookEvent {
+    pub(crate) fn matches(self, event: HookEventName) -> bool {
+        matches!((self, event),
+            (Self::PreToolUse, HookEventName::PreToolUse)
+            | (Self::PostToolUse, HookEventName::PostToolUse))
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeHookTrigger {
+    pub event: NativeHookEvent,
+    pub turn_id: String,
+    pub tool_use_id: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeHookSpawn {
+    /// The thread passed by Core to Hooks::new, never stdin session_id or environment.
+    pub thread_id: ThreadId,
+    /// The actual child returned by the local native command launcher, before waiting.
+    pub pid: u32,
+    pub trigger: NativeHookTrigger,
+    pub handler_id: String,
+}
+
+/// An opaque scope whose destruction revokes this one command's registration.
+pub trait NativeHookRegistration: Send {}
+
+pub trait NativeHookSpawnObserver: Send + Sync {
+    /// None leaves the original hook running without granting caller proof.
+    fn register(&self, spawn: NativeHookSpawn) -> Option<Box<dyn NativeHookRegistration>>;
+}
