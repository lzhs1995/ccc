+//! A native local child's identity, captured before its owner starts reaping it.
+//! No environment, argv, process-group inference, or remote wire identity.
+use std::io;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NativeProcessIdentity {
+    pub pid: u32,
+    pub ppid: u32,
+    pub uid: u32,
+    pub birth: [u64; 2],
+}
+
+#[cfg(target_os = "macos")]
+pub fn native_process_identity(pid: u32) -> io::Result<NativeProcessIdentity> {
+    #[repr(C)]
+    struct BsdInfo {
+        flags: u32,
+        status: u32,
+        xstatus: u32,
+        pid: u32,
+        ppid: u32,
+        ids: [u32; 7],
+        comm: [u8; 16],
+        name: [u8; 32],
+        misc: [u32; 6],
+        start_sec: u64,
+        start_usec: u64,
+    }
+    unsafe extern "C" {
+        fn proc_pidinfo(
+            pid: i32,
+            flavor: i32,
+            arg: u64,
+            buffer: *mut libc::c_void,
+            size: i32,
+        ) -> i32;
+    }
+    if pid <= 1 || pid > i32::MAX as u32 {
+        return Err(io::Error::other("invalid native process PID"));
+    }
+    let mut b: BsdInfo = unsafe { std::mem::zeroed() };
+    let size = std::mem::size_of::<BsdInfo>();
+    let count = unsafe {
+        proc_pidinfo(
+            pid as i32,
+            3,
+            0,
+            (&mut b as *mut BsdInfo).cast(),
+            size as i32,
+        )
+    };
+    if size != 136
+        || count != size as i32
+        || b.pid != pid
+        || b.status == 5
+        || b.start_sec == 0
+        || b.start_usec >= 1_000_000
+        || b.ids[0] != unsafe { libc::getuid() }
+    {
+        return Err(io::Error::other("native process identity unavailable"));
+    }
+    Ok(NativeProcessIdentity {
+        pid,
+        ppid: b.ppid,
+        uid: b.ids[0],
+        birth: [b.start_sec, b.start_usec],
+    })
+}
+
+#[cfg(not(target_os = "macos"))]
+pub fn native_process_identity(_pid: u32) -> io::Result<NativeProcessIdentity> {
+    Err(io::Error::other("native caller identity unsupported"))
+}
+
+pub(crate) fn capture_child(pid: u32) -> Option<NativeProcessIdentity> {
+    let identity = native_process_identity(pid).ok()?;
+    (identity.ppid == std::process::id()).then_some(identity)
+}
+
+#[cfg(all(test, target_os = "macos"))]
+mod tests {
+    use super::*;
+    use std::io::{BufRead, Write};
+    use std::process::{Command, Stdio};
+
+    #[test]
+    fn local_spawn_birth_is_preserved_across_exec_and_thread_env_override() {
+        let mut child = Command::new("/bin/sh")
+            .args([
+                "-c",
+                "exec /usr/bin/env CODEX_THREAD_ID=not-the-native-thread /bin/cat",
+            ])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap();
+        // Always reap our own private child before evaluating assertions.
+        let before = capture_child(child.id());
+        let write = child
+            .stdin
+            .as_mut()
+            .unwrap()
+            .write_all(b"native-caller-ready\n");
+        let mut ready = String::new();
+        let read = std::io::BufReader::new(child.stdout.take().unwrap()).read_line(&mut ready);
+        let after = native_process_identity(child.id());
+        drop(child.stdin.take());
+        let status = child.wait().unwrap();
+        write.unwrap();
+        read.unwrap();
+        assert_eq!(ready, "native-caller-ready\n");
+        assert!(status.success());
+        let before = before.expect("real local child identity");
+        assert_eq!(before, after.unwrap());
+        assert_eq!(before.ppid, std::process::id());
+        assert_ne!(native_process_identity(before.pid).ok(), Some(before));
+    }
+}
