+//! New hook observer wiring tests. The recorder is not a Core/socket E2E proof.
+use super::*;
+use crate::{NativeHookEvent, NativeHookRegistration, NativeHookSpawn, NativeHookSpawnObserver, NativeHookTrigger};
+use crate::engine::ClaudeHooksEngine;
+use codex_protocol::protocol::{HookEventName, HookSource};
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[derive(Default)]
+struct Recorder {
+    spawns: Mutex<Vec<NativeHookSpawn>>,
+    dropped: Arc<AtomicUsize>,
+    ready: tokio::sync::Notify,
+}
+struct Guard(Arc<AtomicUsize>);
+impl NativeHookRegistration for Guard {}
+impl Drop for Guard {
+    fn drop(&mut self) { self.0.fetch_add(1, Ordering::SeqCst); }
+}
+impl NativeHookSpawnObserver for Recorder {
+    fn register(&self, spawn: NativeHookSpawn) -> Option<Box<dyn NativeHookRegistration>> {
+        self.spawns.lock().unwrap().push(spawn);
+        self.ready.notify_one();
+        Some(Box::new(Guard(self.dropped.clone())))
+    }
+}
+struct NoMcp;
+impl crate::HookMcpExecutor for NoMcp {
+    fn execute(&self, _call: crate::HookMcpCall) -> futures::future::BoxFuture<'_, anyhow::Result<crate::HookMcpOutput>> {
+        Box::pin(async { unreachable!("command hook test must not call MCP") })
+    }
+}
+fn runtime_with_receiver(thread: ThreadId, observer: Arc<Recorder>) -> (CommandHookRuntime, async_channel::Receiver<HookCompletedEvent>) {
+    let (tx, rx) = async_channel::unbounded();
+    let runtime = CommandHookRuntime::new(
+        CommandShell { program: "/bin/sh".into(), args: vec!["-c".into()] },
+        Arc::new(Vec::new()), thread, tx,
+    ).with_native_spawn_observer(observer);
+    (runtime, rx)
+}
+fn runtime(thread: ThreadId, observer: Arc<Recorder>) -> CommandHookRuntime {
+    runtime_with_receiver(thread, observer).0
+}
+fn handler(path: &Path, event: HookEventName, command: &str) -> ConfiguredHandler {
+    ConfiguredHandler {
+        builtin: false, plugin_trust: None, event_name: event, matcher: None,
+        timeout_sec: 2, status_message: None, additional_context_limit: Default::default(),
+        source_path: AbsolutePathBuf::try_from(path.join("hooks.json")).unwrap().into(),
+        source: HookSource::User, display_order: 7,
+        kind: ConfiguredHandlerKind::Command { command: command.into(), r#async: false, env: HashMap::new() },
+    }
+}
+fn engine(runtime: CommandHookRuntime, handler: ConfiguredHandler) -> ClaudeHooksEngine {
+    ClaudeHooksEngine { handlers: Arc::new(vec![handler]), warnings: Arc::from([]),
+        required_load_errors: Arc::from([]), command_runtime: runtime, mcp_executor: Arc::new(NoMcp) }
+}
+fn post(root: ThreadId, path: &Path, trigger: &str) -> crate::PostToolUseRequest {
+    crate::PostToolUseRequest { session_id: root, turn_id: "native-turn".into(), subagent: None,
+        cwd: AbsolutePathBuf::try_from(path.to_path_buf()).unwrap(), transcript_path: None,
+        model: "fixture".into(), permission_mode: "default".into(), tool_name: "Bash".into(),
+        matcher_aliases: vec![], tool_use_id: trigger.into(), tool_input: serde_json::json!({}),
+        tool_response: serde_json::json!({}) }
+}
+#[tokio::test]
+async fn native_pre_and_post_bind_runtime_thread_not_shared_session_or_environment() {
+    let dir = tempfile::tempdir().unwrap();
+    let root = ThreadId::new(); let child = ThreadId::new();
+    let recorder = Arc::new(Recorder::default());
+    let base = runtime(child, recorder.clone());
+    let command = format!("CODEX_THREAD_ID={root} /bin/cat >/dev/null");
+    let before = engine(base.clone(), handler(dir.path(), HookEventName::PreToolUse, &command));
+    let pre = crate::PreToolUseRequest { session_id: root, turn_id: "native-turn".into(), subagent: None,
+        cwd: AbsolutePathBuf::try_from(dir.path().to_path_buf()).unwrap(), transcript_path: None,
+        model: "fixture".into(), permission_mode: "default".into(), tool_name: "Bash".into(),
+        matcher_aliases: vec![], tool_use_id: "actual-pre-call".into(), tool_input: serde_json::json!({}) };
+    crate::events::pre_tool_use::run(&before, pre).await;
+    let after = engine(base, handler(dir.path(), HookEventName::PostToolUse, &command));
+    crate::events::post_tool_use::run(&after, post(root, dir.path(), "actual-post-call")).await;
+    let spawns = recorder.spawns.lock().unwrap();
+    assert_eq!(spawns.len(), 2);
+    assert!(spawns.iter().all(|s| s.thread_id == child && s.pid > 1 && !s.handler_id.is_empty()));
+    assert_eq!(spawns[0].trigger.event, NativeHookEvent::PreToolUse);
+    assert_eq!(spawns[0].trigger.tool_use_id, "actual-pre-call");
+    assert_eq!(spawns[1].trigger.event, NativeHookEvent::PostToolUse);
+    assert_eq!(spawns[1].trigger.tool_use_id, "actual-post-call");
+    assert_eq!(recorder.dropped.load(Ordering::SeqCst), 2);
+}
+#[tokio::test]
+async fn concurrent_root_and_async_child_hook_views_keep_distinct_native_triggers() {
+    let dir = tempfile::tempdir().unwrap(); let root = ThreadId::new(); let child = ThreadId::new();
+    let recorder = Arc::new(Recorder::default());
+    let a = engine(runtime(root, recorder.clone()), handler(dir.path(), HookEventName::PostToolUse, "/bin/cat >/dev/null"));
+    let (child_runtime, child_results) = runtime_with_receiver(child, recorder.clone());
+    let mut child_handler = handler(dir.path(), HookEventName::PostToolUse, "/bin/cat >/dev/null");
+    if let ConfiguredHandlerKind::Command { r#async, .. } = &mut child_handler.kind { *r#async = true; }
+    let b = engine(child_runtime, child_handler);
+    tokio::join!(crate::events::post_tool_use::run(&a, post(root, dir.path(), "root-trigger")),
+        crate::events::post_tool_use::run(&b, post(root, dir.path(), "child-trigger")));
+    tokio::time::timeout(Duration::from_secs(3), child_results.recv()).await.unwrap().unwrap();
+    let spawns = recorder.spawns.lock().unwrap();
+    assert_eq!(spawns.len(), 2);
+    assert!(spawns.iter().any(|s| s.thread_id == root && s.trigger.tool_use_id == "root-trigger"));
+    assert!(spawns.iter().any(|s| s.thread_id == child && s.trigger.tool_use_id == "child-trigger"));
+    assert_eq!(recorder.dropped.load(Ordering::SeqCst), 2);
+}
+#[tokio::test]
+async fn forged_stdin_and_mismatched_event_do_not_create_native_hook_provenance() {
+    let dir = tempfile::tempdir().unwrap(); let recorder = Arc::new(Recorder::default());
+    let rt = runtime(ThreadId::new(), recorder.clone());
+    let h = handler(dir.path(), HookEventName::PostToolUse, "/bin/cat >/dev/null");
+    let fake = r#"{"hook_event_name":"PostToolUse","session_id":"root","tool_use_id":"forged"}"#;
+    run_command(&rt, &h, "/bin/cat >/dev/null", &HashMap::new(), fake, dir.path()).await;
+    let wrong = rt.for_tool_hook(NativeHookTrigger { event: NativeHookEvent::PreToolUse, turn_id: "turn".into(), tool_use_id: "call".into() });
+    run_command(&wrong, &h, "/bin/cat >/dev/null", &HashMap::new(), fake, dir.path()).await;
+    assert!(recorder.spawns.lock().unwrap().is_empty());
+}
+#[tokio::test]
+async fn hook_scope_revokes_registration_on_timeout_and_cancellation() {
+    let dir = tempfile::tempdir().unwrap(); let recorder = Arc::new(Recorder::default());
+    let rt = runtime(ThreadId::new(), recorder.clone()).for_tool_hook(NativeHookTrigger {
+        event: NativeHookEvent::PostToolUse, turn_id: "turn".into(), tool_use_id: "call".into() });
+    let mut h = handler(dir.path(), HookEventName::PostToolUse, "exec /bin/sleep 60");
+    h.timeout_sec = 1;
+    let result = run_command(&rt, &h, "exec /bin/sleep 60", &HashMap::new(), "{}", dir.path()).await;
+    assert!(result.error.is_some());
+    assert_eq!(recorder.dropped.load(Ordering::SeqCst), 1);
+    // Consume the first notification, then cancel only a second private child.
+    recorder.ready.notified().await;
+    let env = HashMap::new();
+    let mut running = Box::pin(run_command(&rt, &h, "exec /bin/sleep 60", &env, "{}", dir.path()));
+    tokio::select! {
+        _ = recorder.ready.notified() => {},
+        _ = &mut running => panic!("private command finished before cancellation"),
+    }
+    assert_eq!(recorder.spawns.lock().unwrap().len(), 2);
+    drop(running);
+    assert_eq!(recorder.dropped.load(Ordering::SeqCst), 2);
+}
+#[test]
+fn reconfigured_runtime_keeps_native_owner_but_discards_invocation_trigger() {
+    let thread = ThreadId::new(); let recorder = Arc::new(Recorder::default());
+    let runtime = runtime(thread, recorder).for_tool_hook(NativeHookTrigger {
+        event: NativeHookEvent::PostToolUse, turn_id: "old-turn".into(), tool_use_id: "old-call".into() });
+    let revised = runtime.reconfigured(CommandShell { program: "/bin/sh".into(), args: vec!["-c".into()] });
+    assert_eq!(revised.thread_id, thread);
+    assert!(revised.native_spawn_observer.is_some());
+    assert!(revised.native_hook_trigger.is_none());
+    assert!(runtime.native_hook_trigger.is_some());
+}
