+//! Read-only actual caller identity. Never foreground, input, or Goal authority.
+//! The registry is in this Core process; remote/daemon data is not imported.
+mod registry;
+use codex_utils_pty::{NativeProcessIdentity, native_process_identity};
+use registry::{Binding, HookEvent, HookOrigin, Identity, Origin, Registry};
+use serde_json::{Value, json};
+use std::io;
+use std::sync::{Mutex, OnceLock};
+
+static SPAWNS: OnceLock<Mutex<Registry>> = OnceLock::new();
+fn registry() -> &'static Mutex<Registry> {
+    SPAWNS.get_or_init(Mutex::default)
+}
+fn identity(value: NativeProcessIdentity) -> Identity {
+    Identity {
+        pid: value.pid,
+        ppid: value.ppid,
+        uid: value.uid,
+        birth: value.birth,
+    }
+}
+fn read(pid: u32) -> Result<Identity, &'static str> {
+    native_process_identity(pid)
+        .map(identity)
+        .map_err(|_| "native process identity unavailable")
+}
+
+pub(crate) struct Registration(Binding);
+impl Drop for Registration {
+    fn drop(&mut self) {
+        if let Ok(mut state) = registry().lock() {
+            state.remove(&self.0);
+        }
+    }
+}
+
+pub(crate) fn register(
+    context: Option<&crate::tools::sandboxing::ToolCtx>,
+    child: Option<NativeProcessIdentity>,
+) -> Option<Registration> {
+    let context = context?;
+    let child = identity(child?);
+    let owner = read(std::process::id()).ok()?;
+    // Only native context supplies thread/call; neither comes from child env.
+    registry()
+        .lock()
+        .ok()?
+        .insert(
+            owner,
+            child,
+            context.session.thread_id.to_string(),
+            context.call_id.clone(),
+            read,
+        )
+        .ok()
+        .map(Registration)
+}
+
+impl codex_hooks::NativeHookRegistration for Registration {}
+
+struct HookSpawnObserver;
+impl codex_hooks::NativeHookSpawnObserver for HookSpawnObserver {
+    fn register(&self, spawn: codex_hooks::NativeHookSpawn) -> Option<Box<dyn codex_hooks::NativeHookRegistration>> {
+        let child = read(spawn.pid).ok()?;
+        let owner = read(std::process::id()).ok()?;
+        let event = match spawn.trigger.event {
+            codex_hooks::NativeHookEvent::PreToolUse => HookEvent::PreToolUse,
+            codex_hooks::NativeHookEvent::PostToolUse => HookEvent::PostToolUse,
+        };
+        let binding = registry().lock().ok()?.insert_hook(
+            owner,
+            child,
+            spawn.thread_id.to_string(),
+            spawn.trigger.tool_use_id,
+            HookOrigin { event, turn_id: spawn.trigger.turn_id, handler_id: spawn.handler_id },
+            read,
+        ).ok()?;
+        Some(Box::new(Registration(binding)))
+    }
+}
+
+pub(crate) fn hook_spawn_observer() -> std::sync::Arc<dyn codex_hooks::NativeHookSpawnObserver> {
+    std::sync::Arc::new(HookSpawnObserver)
+}
+
+fn origin_json(binding: &Binding) -> Value {
+    match &binding.origin {
+        Origin::UnifiedExec => json!({"kind":"unified-exec"}),
+        Origin::NativeCommandHook(origin) => json!({
+            "kind":"native-command-hook",
+            "event":match origin.event { HookEvent::PreToolUse => "PreToolUse", HookEvent::PostToolUse => "PostToolUse" },
+            "turnId":origin.turn_id,"toolUseId":binding.call_id,"handlerId":origin.handler_id,
+        }),
+    }
+}
+
+/// Called only by the original TUI's kernel-peer-checked native socket worker.
+/// The request contains a nonce and expected server identity, never a caller SID.
+pub fn observe_peer(
+    peer_pid: u32,
+    peer_uid: u32,
+    peer_birth: &Value,
+    request: &Value,
+) -> io::Result<Value> {
+    let error = |message: &str| io::Error::other(message.to_owned());
+    let object = request
+        .as_object()
+        .ok_or_else(|| error("caller query must be an object"))?;
+    let fields = [
+        "method",
+        "challenge",
+        "expectedClientPid",
+        "expectedClientBirth",
+        "expectedClientEpoch",
+    ];
+    if object.len() != fields.len()
+        || !fields.iter().all(|key| object.contains_key(*key))
+        || request["method"] != "caller/thread/observe"
+    {
+        return Err(error("unexpected caller query fields"));
+    }
+    let challenge = request["challenge"]
+        .as_str()
+        .ok_or_else(|| error("caller challenge missing"))?;
+    if uuid::Uuid::parse_str(challenge)
+        .map(|v| v.to_string() != challenge)
+        .unwrap_or(true)
+    {
+        return Err(error("invalid caller challenge"));
+    }
+    let owner = read(std::process::id()).map_err(error)?;
+    let peer = read(peer_pid).map_err(error)?;
+    if peer.uid != peer_uid
+        || peer_birth != &json!(peer.birth)
+        || request["expectedClientPid"] != json!(owner.pid)
+        || request["expectedClientBirth"] != json!(owner.birth)
+    {
+        return Err(error("caller query generation mismatch"));
+    }
+    let state = registry()
+        .lock()
+        .map_err(|_| error("native caller registry unavailable"))?;
+    let binding = state.resolve(owner, peer, read).map_err(error)?;
+    Ok(
+        json!({"schema":1,"purpose":"native_caller_thread","scope":"caller-thread-readonly",
+        "challenge":challenge,"clientPid":owner.pid,"clientBirth":owner.birth,
+        "peerPid":peer.pid,"peerBirth":peer.birth,"spawnPid":binding.child.pid,
+        "spawnBirth":binding.child.birth,"threadId":binding.thread_id,"callId":binding.call_id,
+        "origin":origin_json(&binding),
+        "foreground":null,"sendAuthority":false,"controllerAuthority":false,
+        "inboxAuthority":false,"source":"same-process-native-spawn"}),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn query() -> Value {
+        json!({"method":"caller/thread/observe","challenge":"11111111-1111-4111-8111-111111111111",
+            "expectedClientPid":100,"expectedClientBirth":[100,42],
+            "expectedClientEpoch":"22222222-2222-4222-8222-222222222222"})
+    }
+
+    #[test]
+    fn caller_supplied_thread_is_rejected_before_kernel_lookup() {
+        let mut body = query();
+        body["threadId"] = json!("root");
+        assert!(
+            observe_peer(0, 0, &Value::Null, &body)
+                .unwrap_err()
+                .to_string()
+                .contains("unexpected caller query fields")
+        );
+    }
+
+    #[test]
+    fn malformed_challenge_is_rejected_before_kernel_lookup() {
+        let mut body = query();
+        body["challenge"] = json!("not-a-native-query-nonce");
+        assert!(
+            observe_peer(0, 0, &Value::Null, &body)
+                .unwrap_err()
+                .to_string()
+                .contains("invalid caller challenge")
+        );
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn hook_observer_actual_child_is_revoked_with_its_registration_scope() {
+        use std::process::{Command, Stdio};
+        use codex_hooks::NativeHookSpawnObserver;
+        let mut child = Command::new("/bin/cat").stdin(Stdio::piped()).stdout(Stdio::null()).spawn().unwrap();
+        let thread = codex_protocol::ThreadId::new();
+        let token = HookSpawnObserver.register(codex_hooks::NativeHookSpawn {
+            thread_id: thread, pid: child.id(),
+            trigger: codex_hooks::NativeHookTrigger { event: codex_hooks::NativeHookEvent::PostToolUse,
+                turn_id: "native-turn".into(), tool_use_id: "native-trigger".into() },
+            handler_id: "native-handler".into(),
+        });
+        // Save checks and always close/reap this private child before asserting.
+        let identities = read(std::process::id()).and_then(|owner| read(child.id()).map(|peer| (owner, peer)));
+        let during = identities.as_ref().ok().and_then(|(owner, peer)| registry().lock().ok()?.resolve(*owner, *peer, read).ok());
+        drop(token);
+        let after = identities.as_ref().ok().and_then(|(owner, peer)| registry().lock().ok()?.resolve(*owner, *peer, read).ok());
+        drop(child.stdin.take()); let status = child.wait().unwrap();
+        assert!(status.success());
+        let during = during.unwrap();
+        assert_eq!(during.thread_id, thread.to_string());
+        assert_eq!(origin_json(&during)["kind"], "native-command-hook");
+        assert_eq!(origin_json(&during)["toolUseId"], "native-trigger");
+        assert!(after.is_none());
+    }
+}
diff --git a/codex-rs/core/src/native_caller/registry.rs b/codex-rs/core/src/native_caller/registry.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/native_caller/registry.rs
@@ -0,0 +1,363 @@
+//! Same-process spawn membership only. This module has no environment or I/O.
+use std::collections::BTreeMap;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(super) struct Identity {
+    pub pid: u32,
+    pub ppid: u32,
+    pub uid: u32,
+    pub birth: [u64; 2],
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum HookEvent {
+    PreToolUse,
+    PostToolUse,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct HookOrigin {
+    pub event: HookEvent,
+    pub turn_id: String,
+    pub handler_id: String,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) enum Origin {
+    UnifiedExec,
+    NativeCommandHook(HookOrigin),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct Binding {
+    pub owner: Identity,
+    pub child: Identity,
+    pub thread_id: String,
+    pub call_id: String,
+    pub origin: Origin,
+    pub token: u64,
+}
+
+#[derive(Default)]
+pub(super) struct Registry {
+    entries: BTreeMap<(u32, [u64; 2]), Binding>,
+    next: u64,
+}
+
+impl Registry {
+    pub fn insert(
+        &mut self,
+        owner: Identity,
+        child: Identity,
+        thread: String,
+        call: String,
+        read: impl FnMut(u32) -> Result<Identity, &'static str>,
+    ) -> Result<Binding, &'static str> {
+        self.insert_with_origin(owner, child, thread, call, Origin::UnifiedExec, read)
+    }
+
+    pub fn insert_hook(
+        &mut self,
+        owner: Identity,
+        child: Identity,
+        thread: String,
+        tool_use_id: String,
+        origin: HookOrigin,
+        read: impl FnMut(u32) -> Result<Identity, &'static str>,
+    ) -> Result<Binding, &'static str> {
+        if origin.turn_id.is_empty() || origin.turn_id.len() > 256
+            || origin.handler_id.is_empty() || origin.handler_id.len() > 4096
+        {
+            return Err("native hook trigger or handler unavailable");
+        }
+        self.insert_with_origin(owner, child, thread, tool_use_id, Origin::NativeCommandHook(origin), read)
+    }
+
+    fn insert_with_origin(
+        &mut self,
+        owner: Identity,
+        child: Identity,
+        thread: String,
+        call: String,
+        origin: Origin,
+        mut read: impl FnMut(u32) -> Result<Identity, &'static str>,
+    ) -> Result<Binding, &'static str> {
+        if child.ppid != owner.pid
+            || child.uid != owner.uid
+            || child.birth < owner.birth
+            || read(owner.pid)? != owner
+            || read(child.pid)? != child
+            || thread.is_empty()
+            || call.is_empty()
+            || call.len() > 256
+        {
+            return Err("spawn identity is not owned by this native process");
+        }
+        let key = (child.pid, child.birth);
+        if self.entries.len() >= 1024 || self.entries.contains_key(&key) {
+            return Err("native caller registry full or ambiguous");
+        }
+        self.next = self
+            .next
+            .checked_add(1)
+            .ok_or("native caller generation exhausted")?;
+        let value = Binding {
+            owner,
+            child,
+            thread_id: thread,
+            call_id: call,
+            origin,
+            token: self.next,
+        };
+        self.entries.insert(key, value.clone());
+        Ok(value)
+    }
+
+    pub fn remove(&mut self, binding: &Binding) {
+        let key = (binding.child.pid, binding.child.birth);
+        if self
+            .entries
+            .get(&key)
+            .is_some_and(|v| v.token == binding.token)
+        {
+            self.entries.remove(&key);
+        }
+    }
+
+    pub fn resolve(
+        &self,
+        owner: Identity,
+        peer: Identity,
+        mut read: impl FnMut(u32) -> Result<Identity, &'static str>,
+    ) -> Result<Binding, &'static str> {
+        if peer.uid != owner.uid
+            || peer.pid == owner.pid
+            || read(peer.pid)? != peer
+            || read(owner.pid)? != owner
+        {
+            return Err("peer does not match this native process");
+        }
+        let mut chain = Vec::new();
+        let mut current = peer;
+        let mut binding = None;
+        for _ in 0..32 {
+            if current.pid == owner.pid {
+                if current != owner {
+                    return Err("native owner generation changed");
+                }
+                break;
+            }
+            if current.pid <= 1
+                || current.uid != owner.uid
+                || chain.iter().any(|p: &Identity| p.pid == current.pid)
+            {
+                return Err("invalid caller ancestry");
+            }
+            if let Some(found) = self.entries.get(&(current.pid, current.birth)) {
+                if binding.is_some() || found.child != current || found.owner != owner {
+                    return Err("ambiguous caller spawn");
+                }
+                binding = Some(found.clone());
+            }
+            chain.push(current);
+            let parent = read(current.ppid)?;
+            if parent.birth > current.birth {
+                return Err("caller parent generation changed");
+            }
+            current = parent;
+        }
+        if current != owner {
+            return Err("caller ancestry exceeds bound");
+        }
+        let found = binding.ok_or("no same-process native caller spawn")?;
+        for seen in chain.iter().rev() {
+            if read(seen.pid)? != *seen {
+                return Err("caller ancestry changed during read");
+            }
+        }
+        if read(owner.pid)? != owner {
+            return Err("native owner changed during read");
+        }
+        Ok(found)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn identity(pid: u32, ppid: u32) -> Identity {
+        Identity {
+            pid,
+            ppid,
+            uid: 501,
+            birth: [u64::from(pid), 42],
+        }
+    }
+    fn tree() -> BTreeMap<u32, Identity> {
+        [
+            identity(100, 1),
+            identity(110, 100),
+            identity(120, 100),
+            identity(130, 100),
+            identity(121, 120),
+            identity(122, 121),
+        ]
+        .into_iter()
+        .map(|p| (p.pid, p))
+        .collect()
+    }
+    fn get(t: &BTreeMap<u32, Identity>, pid: u32) -> Result<Identity, &'static str> {
+        t.get(&pid).copied().ok_or("unavailable")
+    }
+    fn registered(t: &BTreeMap<u32, Identity>) -> Registry {
+        let mut r = Registry::default();
+        for (pid, thread) in [(110, "root"), (120, "child-a"), (130, "child-b")] {
+            r.insert(
+                t[&100],
+                t[&pid],
+                thread.into(),
+                format!("exec-{pid}"),
+                |p| get(t, p),
+            )
+            .unwrap();
+        }
+        r
+    }
+    #[test]
+    fn root_and_two_children_keep_separate_spawn_ownership() {
+        let t = tree();
+        let r = registered(&t);
+        for (pid, thread) in [(110, "root"), (120, "child-a"), (130, "child-b")] {
+            assert_eq!(
+                r.resolve(t[&100], t[&pid], |p| get(&t, p))
+                    .unwrap()
+                    .thread_id,
+                thread
+            );
+        }
+    }
+    #[test]
+    fn child_exec_and_all_env_overrides_do_not_change_native_thread() {
+        let t = tree();
+        let r = registered(&t);
+        // exec keeps kernel PID/birth/parent; no argv/env selectors enter resolve.
+        let found = r.resolve(t[&100], t[&122], |p| get(&t, p)).unwrap();
+        assert_eq!(found.thread_id, "child-a");
+        assert_ne!(found.thread_id, "root");
+    }
+    #[test]
+    fn changed_birth_cannot_reuse_old_binding() {
+        let mut t = tree();
+        let r = registered(&t);
+        t.get_mut(&120).unwrap().birth[1] += 1;
+        assert!(r.resolve(t[&100], t[&120], |p| get(&t, p)).is_err());
+    }
+    #[test]
+    fn missing_parent_is_unknown_not_a_fallback_to_root() {
+        let mut t = tree();
+        let r = registered(&t);
+        t.remove(&121);
+        assert!(r.resolve(t[&100], t[&122], |p| get(&t, p)).is_err());
+    }
+    #[test]
+    fn foreign_uid_refuses() {
+        let mut t = tree();
+        let r = registered(&t);
+        t.get_mut(&122).unwrap().uid = 502;
+        assert!(r.resolve(t[&100], t[&122], |p| get(&t, p)).is_err());
+    }
+    #[test]
+    fn daemon_or_other_process_has_no_shared_binding() {
+        let t = tree();
+        let r = Registry::default();
+        assert!(r.resolve(t[&100], t[&122], |p| get(&t, p)).is_err());
+    }
+    #[test]
+    fn released_registration_cannot_authorize_live_descendant() {
+        let t = tree();
+        let mut r = registered(&t);
+        let b = r.resolve(t[&100], t[&122], |p| get(&t, p)).unwrap();
+        r.remove(&b);
+        assert!(r.resolve(t[&100], t[&122], |p| get(&t, p)).is_err());
+    }
+    #[test]
+    fn duplicate_spawn_is_rejected_and_original_preserved() {
+        let t = tree();
+        let mut r = registered(&t);
+        assert!(
+            r.insert(t[&100], t[&120], "root".into(), "forged".into(), |p| get(
+                &t, p
+            ))
+            .is_err()
+        );
+        assert_eq!(
+            r.resolve(t[&100], t[&120], |p| get(&t, p))
+                .unwrap()
+                .thread_id,
+            "child-a"
+        );
+    }
+    #[test]
+    fn changed_owner_refuses() {
+        let mut t = tree();
+        let r = registered(&t);
+        t.get_mut(&100).unwrap().birth[1] += 1;
+        assert!(r.resolve(t[&100], t[&122], |p| get(&t, p)).is_err());
+    }
+    #[test]
+    fn changed_ancestry_during_second_read_refuses() {
+        let t = tree();
+        let r = registered(&t);
+        let mut reads = 0;
+        assert!(
+            r.resolve(t[&100], t[&122], |p| {
+                let mut v = get(&t, p)?;
+                if p == 121 {
+                    reads += 1;
+                    if reads == 2 {
+                        v.birth[1] += 1;
+                    }
+                }
+                Ok(v)
+            })
+            .is_err()
+        );
+    }
+    #[test]
+    fn capture_must_be_actual_direct_child() {
+        let t = tree();
+        let mut r = Registry::default();
+        assert!(
+            r.insert(t[&100], t[&122], "root".into(), "call".into(), |p| get(
+                &t, p
+            ))
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn hook_origin_keeps_child_thread_and_native_trigger_distinct_from_exec() {
+        let t = tree(); let mut r = Registry::default();
+        let hook = r.insert_hook(t[&100], t[&120], "child".into(), "trigger".into(),
+            HookOrigin { event: HookEvent::PostToolUse, turn_id: "turn".into(), handler_id: "handler".into() },
+            |p| get(&t,p)).unwrap();
+        let exec = r.insert(t[&100], t[&110], "root".into(), "trigger".into(), |p| get(&t,p)).unwrap();
+        let child = r.resolve(t[&100], t[&121], |p| get(&t,p)).unwrap();
+        assert_eq!(child.thread_id, "child");
+        assert_eq!(child.origin, hook.origin);
+        assert!(matches!(child.origin, Origin::NativeCommandHook(_)));
+        assert_eq!(exec.origin, Origin::UnifiedExec);
+        r.remove(&hook);
+        assert!(r.resolve(t[&100], t[&121], |p| get(&t,p)).is_err());
+        assert_eq!(r.resolve(t[&100], t[&110], |p| get(&t,p)).unwrap().origin, Origin::UnifiedExec);
+    }
+
+    #[test]
+    fn native_hook_missing_turn_or_handler_is_not_registered() {
+        let t = tree(); let mut r = Registry::default();
+        for (turn_id, handler_id) in [("", "handler"), ("turn", "")] {
+            assert!(r.insert_hook(t[&100],t[&120],"child".into(),"trigger".into(),
+                HookOrigin { event: HookEvent::PreToolUse, turn_id:turn_id.into(),handler_id:handler_id.into() },
+                |p| get(&t,p)).is_err());
+        }
+        assert!(r.resolve(t[&100],t[&120],|p|get(&t,p)).is_err());
+    }
+}
